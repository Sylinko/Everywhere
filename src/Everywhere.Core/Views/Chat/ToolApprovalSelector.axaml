<ResourceDictionary
  xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:exp="clr-namespace:ExpressionBinding.Avalonia;assembly=ExpressionBinding.Avalonia" xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
  xmlns:v="using:Everywhere.Views" xmlns:vc="using:Everywhere.ValueConverters"
  xmlns:vm="using:Everywhere.ViewModels">
  <ControlTheme
    x:Key="{x:Type v:ToolApprovalSelector}"
    TargetType="v:ToolApprovalSelector">
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <ControlTemplate TargetType="v:ToolApprovalSelector">
        <Button
          Classes="Ghost"
          Height="{DynamicResource FontSize3Xl}"
          HorizontalContentAlignment="Stretch"
          Content="{Binding EffectiveItem?.NameKey^, RelativeSource={RelativeSource TemplatedParent}}"
          Focusable="False"
          Foreground="{TemplateBinding Foreground}">
          <Button.Padding>
            <exp:ExpressionBinding Expression="thickness((A - B) / 2)">
              <DynamicResource ResourceKey="FontSize3Xl"/>
              <DynamicResource ResourceKey="FontSizeXl"/>
            </exp:ExpressionBinding>
          </Button.Padding>

          <shadui:ButtonAssist.Icon>
            <LucideIcon Kind="{Binding $parent[v:ToolApprovalSelector].EffectiveItem?.Icon}"/>
          </shadui:ButtonAssist.Icon>

          <Button.Flyout>
            <Flyout Placement="Top">
              <ItemsControl
                Width="300" Margin="6"
                ItemsSource="{Binding $parent[v:ToolApprovalSelector].ItemsSource}">
                <ItemsControl.Styles>
                  <Style Selector="Button.Selected">
                    <Setter Property="Background" Value="{DynamicResource PrimaryColor25}"/>
                    <Setter Property="shadui:ButtonAssist.HoverBackground" Value="{DynamicResource PrimaryColor50}"/>
                    <Setter Property="shadui:ButtonAssist.PressedBackground" Value="{DynamicResource PrimaryColor10}"/>
                  </Style>
                  <Style Selector="Button.Warning">
                    <Setter Property="Foreground" Value="{DynamicResource WarningColor}"/>
                  </Style>
                </ItemsControl.Styles>
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="4"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ToolApprovalModeOption">
                    <Button
                      Classes="Ghost" HorizontalContentAlignment="Stretch"
                      Classes.Warning="{Binding IsDangerous}"
                      Command="{Binding $parent[v:ToolApprovalSelector].SelectItemCommand}"
                      CommandParameter="{Binding}"
                      CornerRadius="{DynamicResource XlCornerRadius}"
                      Focusable="False">
                      <Classes.Selected>
                        <MultiBinding Converter="{x:Static vc:CommonConverters.AllEquals}">
                          <Binding Path="."/>
                          <Binding Path="$parent[v:ToolApprovalSelector].SelectedItem"/>
                        </MultiBinding>
                      </Classes.Selected>

                      <Interaction.Behaviors>
                        <ButtonHideFlyoutOnClickBehavior/>
                      </Interaction.Behaviors>

                      <DockPanel HorizontalSpacing="8">
                        <LucideIcon
                          DockPanel.Dock="Left" VerticalAlignment="Center"
                          Kind="{Binding Icon}"
                          Size="{DynamicResource FontSizeXl}"/>
                        <StackPanel Spacing="2">
                          <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding NameKey^}"/>
                          <TextBlock
                            Classes="Caption" Opacity="0.75"
                            Text="{Binding DescriptionKey^}"
                            TextWrapping="Wrap"/>
                        </StackPanel>
                      </DockPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Flyout>
          </Button.Flyout>
        </Button>
      </ControlTemplate>
    </Setter>

    <Style Selector="^.Warning">
      <Setter Property="Foreground" Value="{DynamicResource WarningColor}"/>
    </Style>
  </ControlTheme>
</ResourceDictionary>