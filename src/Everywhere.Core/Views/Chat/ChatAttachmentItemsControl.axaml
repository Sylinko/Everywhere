<ResourceDictionary
  xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:chat="clr-namespace:Everywhere.Chat" xmlns:in="clr-namespace:Everywhere.Interactions"
  xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI" xmlns:v="using:Everywhere.Views"
  xmlns:vc="clr-namespace:Everywhere.ValueConverters">
  <ControlTheme
    x:Key="{x:Type v:ChatAttachmentItemsControl}"
    TargetType="v:ChatAttachmentItemsControl">
    <Setter Property="Template">
      <ControlTemplate TargetType="v:ChatAttachmentItemsControl">
        <v:ChatAttachmentItemsPresenter
          x:Name="PART_ItemsControl"
          ItemsSource="{TemplateBinding ItemsSource}">

          <v:ChatAttachmentItemsPresenter.Styles>
            <Style Selector="shadui|SmoothBorder#PART_Border:not(.Supported)">
              <Setter Property="BorderBrush" Value="{DynamicResource WarningColor}"/>
              <Setter Property="ToolTip.Tip" Value="{I18N {x:Static LocaleKey.ChatAttachmentItemsControl_FileAttachment_NotSupportToolTip_Tip}}"/>
            </Style>

            <Style Selector="Button#PART_RemoveButton:disabled">
              <Setter Property="IsVisible" Value="False"/>
            </Style>
          </v:ChatAttachmentItemsPresenter.Styles>

          <v:ChatAttachmentItemsPresenter.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel
                ItemSpacing="6" LineSpacing="4"/>
            </ItemsPanelTemplate>
          </v:ChatAttachmentItemsPresenter.ItemsPanel>

          <v:ChatAttachmentItemsPresenter.DataTemplates>
            <DataTemplate DataType="chat:FileAttachment">
              <shadui:SmoothBorder
                x:Name="PART_Border"
                Height="{DynamicResource LineHeightL}"
                MaxWidth="240"
                Background="{DynamicResource CardBackgroundColor}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="{DynamicResource XlCornerRadius}"
                ToolTip.Placement="Top">
                <Interaction.Behaviors>
                  <in:MiddleClickEventTrigger>
                    <!--  Middle click to close  -->
                    <InvokeCommandAction
                      Command="{Binding $parent[v:ChatAttachmentItemsControl].RemoveCommand}"
                      CommandParameter="{Binding}"/>
                  </in:MiddleClickEventTrigger>
                </Interaction.Behaviors>

                <Classes.Supported>
                  <MultiBinding Converter="{x:Static vc:ModalitiesConverters.IsSupported}">
                    <Binding Path="$parent[v:ChatAttachmentItemsControl].SupportedModalities"/>
                    <Binding Path="RequiredModalities"/>
                  </MultiBinding>
                </Classes.Supported>

                <DockPanel
                  Margin="6,0" ClipToBounds="False"
                  HorizontalSpacing="4" LastChildFill="True">
                  <LucideIcon
                    DockPanel.Dock="Left" VerticalAlignment="Center"
                    IsVisible="{Binding !IsImage}"
                    Kind="{Binding Icon}"
                    Size="{DynamicResource FontSizeL}"/>

                  <Button
                    x:Name="PART_RemoveButton" DockPanel.Dock="Right"
                    Margin="0,0,-2,0" Padding="1"
                    VerticalAlignment="Center"
                    Background="{DynamicResource TransparentColor}"
                    BorderThickness="0"
                    Command="{Binding $parent[v:ChatAttachmentItemsControl].RemoveCommand}"
                    CommandParameter="{Binding}"
                    Focusable="False"
                    ToolTip.Tip="{I18N {x:Static LocaleKey.ChatAttachment_RemoveButton_ToolTip}}">
                    <LucideIcon
                      Foreground="{DynamicResource MutedColor}"
                      Kind="X"
                      Size="{DynamicResource FontSizeS}"/>
                  </Button>

                  <Image
                    MaxWidth="{DynamicResource LineHeightL}"
                    MaxHeight="{DynamicResource LineHeightL}"
                    Margin="0,4" VerticalAlignment="Center"
                    IsVisible="{Binding IsImage}"
                    Source="{Binding Image}"
                    Stretch="UniformToFill" ToolTip.Placement="Top">
                    <Image.Styles>
                      <Style Selector="ToolTip">
                        <Setter Property="MaxHeight" Value="600"/>
                        <Setter Property="MaxWidth" Value="600"/>
                        <Setter Property="Padding" Value="0"/>
                      </Style>
                    </Image.Styles>

                    <ToolTip.Tip>
                      <Image
                        Source="{Binding Image}"
                        Stretch="Uniform"/>
                    </ToolTip.Tip>
                  </Image>

                  <TextBlock
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource FontSizeS}"
                    IsVisible="{Binding !IsImage}"
                    Text="{Binding HeaderKey^}"
                    TextTrimming="{x:Static TextTrimming.PrefixCharacterEllipsis}">
                    <Interaction.Behaviors>
                      <shadui:TextTrimmedToolTipBehavior/>
                    </Interaction.Behaviors>
                  </TextBlock>
                </DockPanel>
              </shadui:SmoothBorder>
            </DataTemplate>

            <DataTemplate DataType="chat:VisualElementAttachment">
              <shadui:SmoothBorder
                x:Name="PART_Border" Classes="Supported"
                Height="{DynamicResource LineHeightL}"
                MaxWidth="240"
                Background="{DynamicResource CardBackgroundColor}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="{DynamicResource FullCornerRadius}">

                <Interaction.Behaviors>
                  <in:MiddleClickEventTrigger>
                    <!--  Middle click to close  -->
                    <InvokeCommandAction
                      Command="{Binding $parent[v:ChatAttachmentItemsControl].RemoveCommand}"
                      CommandParameter="{Binding}"/>
                  </in:MiddleClickEventTrigger>
                </Interaction.Behaviors>

                <DockPanel
                  Margin="6,0" ClipToBounds="False"
                  HorizontalSpacing="4" LastChildFill="True">
                  <LucideIcon
                    DockPanel.Dock="Left" VerticalAlignment="Center"
                    IsVisible="{Binding PreviewImage, Converter={x:Static ObjectConverters.IsNull}}"
                    Kind="{Binding Icon}"
                    Size="{DynamicResource FontSizeL}"/>
                  <Image
                    DockPanel.Dock="Left"
                    MaxWidth="{DynamicResource LineHeightL}"
                    MaxHeight="{DynamicResource LineHeightL}"
                    Margin="0,4" VerticalAlignment="Center"
                    IsVisible="{Binding PreviewImage, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Source="{Binding PreviewImage}"
                    Stretch="UniformToFill" ToolTip.Placement="Top">
                    <Image.Styles>
                      <Style Selector="ToolTip">
                        <Setter Property="MaxHeight" Value="600"/>
                        <Setter Property="MaxWidth" Value="600"/>
                        <Setter Property="Padding" Value="0"/>
                      </Style>
                    </Image.Styles>

                    <ToolTip.Tip>
                      <Image
                        Source="{Binding PreviewImage}"
                        Stretch="Uniform"/>
                    </ToolTip.Tip>
                  </Image>

                  <Button
                    x:Name="PART_RemoveButton" DockPanel.Dock="Right"
                    Margin="0,0,-2,0" Padding="1"
                    VerticalAlignment="Center"
                    Background="{DynamicResource TransparentColor}"
                    BorderThickness="0"
                    Command="{Binding $parent[v:ChatAttachmentItemsControl].RemoveCommand}"
                    CommandParameter="{Binding}"
                    Focusable="False"
                    ToolTip.Tip="{I18N {x:Static LocaleKey.ChatAttachment_RemoveButton_ToolTip}}">
                    <LucideIcon
                      Foreground="{DynamicResource MutedColor}"
                      Kind="X"
                      Size="{DynamicResource FontSizeS}"/>
                  </Button>

                  <TextBlock
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource FontSizeS}"
                    Text="{Binding HeaderKey^}"
                    TextTrimming="{x:Static TextTrimming.PrefixCharacterEllipsis}"
                    TextWrapping="NoWrap">
                    <Interaction.Behaviors>
                      <shadui:TextTrimmedToolTipBehavior/>
                    </Interaction.Behaviors>
                  </TextBlock>
                </DockPanel>
              </shadui:SmoothBorder>
            </DataTemplate>

            <DataTemplate DataType="chat:ChatAttachment">
              <shadui:SmoothBorder
                x:Name="PART_Border" Classes="Supported"
                Height="{DynamicResource LineHeightL}"
                MaxWidth="240"
                Background="{DynamicResource CardBackgroundColor}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="{DynamicResource XlCornerRadius}">
                <Interaction.Behaviors>
                  <in:MiddleClickEventTrigger>
                    <!--  Middle click to close  -->
                    <InvokeCommandAction
                      Command="{Binding $parent[v:ChatAttachmentItemsControl].RemoveCommand}"
                      CommandParameter="{Binding}"/>
                  </in:MiddleClickEventTrigger>
                </Interaction.Behaviors>

                <DockPanel
                  Margin="6,0" ClipToBounds="False"
                  HorizontalSpacing="4" LastChildFill="True">
                  <LucideIcon
                    DockPanel.Dock="Left" VerticalAlignment="Center"
                    Kind="{Binding Icon}"
                    Size="{DynamicResource FontSizeL}"/>

                  <Button
                    x:Name="PART_RemoveButton" DockPanel.Dock="Right"
                    Margin="0,0,-2,0" Padding="1"
                    VerticalAlignment="Center"
                    Background="{DynamicResource TransparentColor}"
                    BorderThickness="0"
                    Command="{Binding $parent[v:ChatAttachmentItemsControl].RemoveCommand}"
                    CommandParameter="{Binding}"
                    Focusable="False"
                    ToolTip.Tip="{I18N {x:Static LocaleKey.ChatAttachment_RemoveButton_ToolTip}}">
                    <LucideIcon
                      Foreground="{DynamicResource MutedColor}"
                      Kind="X"
                      Size="{DynamicResource FontSizeS}"/>
                  </Button>

                  <TextBlock
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource FontSizeS}"
                    Text="{Binding HeaderKey^}"
                    TextTrimming="{x:Static TextTrimming.PrefixCharacterEllipsis}"
                    TextWrapping="NoWrap">
                    <Interaction.Behaviors>
                      <shadui:TextTrimmedToolTipBehavior/>
                    </Interaction.Behaviors>
                  </TextBlock>
                </DockPanel>
              </shadui:SmoothBorder>
            </DataTemplate>
          </v:ChatAttachmentItemsPresenter.DataTemplates>
        </v:ChatAttachmentItemsPresenter>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>