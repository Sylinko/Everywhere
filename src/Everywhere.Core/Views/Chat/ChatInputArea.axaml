<ResourceDictionary
  xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:aai="clr-namespace:Everywhere.AI;assembly=Everywhere.Abstractions" xmlns:chat="clr-namespace:Everywhere.Chat"
  xmlns:in="clr-namespace:Everywhere.Interactions" xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
  xmlns:v="clr-namespace:Everywhere.Views" xmlns:vc="clr-namespace:Everywhere.ValueConverters">
  <ControlTheme
    x:Key="{x:Type v:ChatInputArea}"
    TargetType="v:ChatInputArea">

    <Style Selector="^ /template/ :is(Button).Rounded">
      <Setter Property="MinHeight" Value="{DynamicResource FontSize3Xl}"/>
      <Setter Property="Height" Value="{DynamicResource FontSize3Xl}"/>
      <Setter Property="MinWidth" Value="{DynamicResource FontSize3Xl}"/>
      <Setter Property="Width" Value="{DynamicResource FontSize3Xl}"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="{DynamicResource FullCornerRadius}"/>

      <Style Selector="^.Update">
        <Setter Property="Background" Value="{DynamicResource SuccessColor60}"/>
      </Style>
    </Style>

    <Style Selector="^ /template/ MenuItem.Rounded">
      <Setter Property="Width" Value="{DynamicResource FontSize3Xl}"/>
      <Setter Property="Height" Value="{DynamicResource FontSize3Xl}"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="{DynamicResource FullCornerRadius}"/>
    </Style>

    <Style Selector="^ /template/ Button#PART_CancelButton:disabled">
      <Setter Property="IsVisible" Value="False"/>
    </Style>

    <Setter Property="FontSize" Value="{DynamicResource FontSizeM}"/>
    <Setter Property="Padding" Value="4"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid
          ColumnDefinitions="*,Auto" RowDefinitions="*,Auto,Auto"
          RowSpacing="4">
          <v:ChatTextEditor
            x:Name="PART_ChatTextEditor" Grid.Row="0"
            Grid.Column="0" Grid.ColumnSpan="2"
            Margin="{TemplateBinding Padding}"
            LeadingContent="{TemplateBinding LeadingContent, Mode=TwoWay}"
            LeadingContentTemplate="{TemplateBinding LeadingContentTemplate}"
            MaxLength="{TemplateBinding MaxLength}"
            PlaceholderText="{TemplateBinding PlaceholderText}"
            Text="{TemplateBinding Text, Mode=TwoWay}"/>

          <ScrollViewer
            Grid.Row="1" Grid.Column="0"
            Grid.ColumnSpan="2" MaxHeight="52"
            Margin="0,2" Padding="0"
            HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Interaction.Behaviors>
              <in:AutoScrollBehavior/>
            </Interaction.Behaviors>

            <v:ChatAttachmentItemsControl
              x:Name="PART_ChatAttachmentItemsControl"
              ItemsSource="{TemplateBinding ChatAttachmentItemsSource}"
              RemoveCommand="{TemplateBinding RemoveAttachmentCommand}"
              SupportedModalities="{Binding SelectedCustomAssistant?.Configuration.InputModalities, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue={x:Static aai:Modalities.None}}"/>
          </ScrollViewer>

          <ContentControl
            Grid.Row="2" Grid.Column="0"
            Content="{TemplateBinding ToolBarContent}"/>

          <StackPanel
            Grid.Row="2" Grid.Column="1"
            Margin="8,0,0,0" Orientation="Horizontal"
            Spacing="8">
            <v:ContextUsageRing
              VerticalAlignment="Center"
              IndicatorBrush="{DynamicResource PrimaryColor}"
              IsIndeterminate="{Binding ContextCompaction?.IsRunning, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue={x:False}}"
              IsVisible="{Binding IsContextUsageRingVisible, RelativeSource={RelativeSource TemplatedParent}}"
              Size="{DynamicResource FontSizeL}"
              StrokeThickness="2"
              TrackBrush="{DynamicResource BorderColor}"
              Value="{Binding ContextUsage?.Snapshot.UsageRatio, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue=0}">
              <v:ContextUsageRing.Styles>
                <Style Selector="FlyoutPresenter">
                  <Setter Property="CornerRadius" Value="{DynamicResource 2XlCornerRadius}"/>
                  <Style.Animations>
                    <Animation
                      Easing="CubicEaseInOut" FillMode="None"
                      IterationCount="1" Duration="0:0:0.15">
                      <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="ScaleTransform.ScaleX" Value="0.8"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.8"/>
                      </KeyFrame>

                      <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                      </KeyFrame>
                    </Animation>
                  </Style.Animations>
                </Style>
              </v:ContextUsageRing.Styles>

              <v:ContextUsageRing.Flyout>
                <Flyout Placement="Top">
                  <StackPanel
                    Width="220" Margin="6"
                    Spacing="8">
                    <TextBlock
                      FontSize="{DynamicResource FontSizeL}"
                      FontWeight="SemiBold"
                      Text="{I18N {x:Static LocaleKey.ChatInputArea_ContextUsage_Header}}"/>

                    <TextBlock
                      FontWeight="SemiBold"
                      IsVisible="{Binding ContextUsage?.Snapshot.HasUsageRatio, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue={x:False}}">
                      <TextBlock.Text>
                        <I18N Key="{x:Static LocaleKey.ChatInputArea_ContextUsage_UsedPercentage}">
                          <Binding
                            Path="ContextUsage?.Snapshot.UsagePercentage"
                            RelativeSource="{RelativeSource TemplatedParent}"/>
                        </I18N>
                      </TextBlock.Text>
                    </TextBlock>

                    <TextBlock IsVisible="{Binding ContextUsage?.Snapshot.HasUsageRatio, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue={x:False}}">
                      <TextBlock.Text>
                        <I18N Key="{x:Static LocaleKey.ChatInputArea_ContextUsage_Tokens}">
                          <Binding
                            Converter="{x:Static vc:TokenCountHumanizationConverter.Shared}"
                            Path="ContextUsage?.Snapshot.TotalTokenCount"
                            RelativeSource="{RelativeSource TemplatedParent}"/>
                          <Binding
                            Converter="{x:Static vc:TokenCountHumanizationConverter.Shared}"
                            Path="ContextUsage?.Snapshot.ContextLimit"
                            RelativeSource="{RelativeSource TemplatedParent}"/>
                        </I18N>
                      </TextBlock.Text>
                    </TextBlock>

                    <TextBlock IsVisible="{Binding ContextUsage?.Snapshot.HasUsageWithoutContextLimit, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue={x:False}}">
                      <TextBlock.Text>
                        <I18N Key="{x:Static LocaleKey.ChatInputArea_ContextUsage_ReportedTokens}">
                          <Binding
                            Converter="{x:Static vc:TokenCountHumanizationConverter.Shared}"
                            Path="ContextUsage?.Snapshot.TotalTokenCount"
                            RelativeSource="{RelativeSource TemplatedParent}"/>
                        </I18N>
                      </TextBlock.Text>
                    </TextBlock>

                    <TextBlock
                      Classes="Caption Muted"
                      IsVisible="{Binding ContextUsage?.Snapshot.HasUsage, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue={x:False}}">
                      <TextBlock.Text>
                        <I18N Key="{x:Static LocaleKey.ChatInputArea_ContextUsage_CachedTokens}">
                          <Binding
                            Converter="{x:Static vc:TokenCountHumanizationConverter.Shared}"
                            Path="ContextUsage?.Snapshot.CachedInputTokenCount"
                            RelativeSource="{RelativeSource TemplatedParent}"/>
                        </I18N>
                      </TextBlock.Text>
                    </TextBlock>

                    <TextBlock
                      Classes="Muted"
                      IsVisible="{Binding ContextUsage?.Snapshot.ShouldShowUnavailableMessage, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue={x:False}}"
                      Text="{I18N {x:Static LocaleKey.ChatInputArea_ContextUsage_Unavailable}}"
                      TextWrapping="Wrap"/>

                    <TextBlock
                      Classes="Caption Muted"
                      IsVisible="{Binding ContextUsage?.Snapshot.Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static chat:ContextUsageKind.Estimated}, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue={x:False}}"
                      Text="{I18N {x:Static LocaleKey.ChatInputArea_ContextUsage_Estimated}}"
                      TextWrapping="Wrap"/>

                    <TextBlock
                      Classes="Caption Muted"
                      IsVisible="{Binding ContextUsage?.Snapshot.IsCompactedAwaitingMeasurement, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue={x:False}}"
                      Text="{I18N {x:Static LocaleKey.ChatInputArea_ContextUsage_Compacted}}"
                      TextWrapping="Wrap"/>

                    <Button
                      Classes="Secondary Compact" HorizontalAlignment="Stretch"
                      shadui:ButtonAssist.IconSize="{DynamicResource FontSizeM}"
                      shadui:ButtonAssist.ShowProgress="{Binding ContextCompaction?.IsRunning, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue={x:False}}"
                      Command="{Binding CompactContextCommand, RelativeSource={RelativeSource TemplatedParent}}"
                      Content="{I18N {x:Static LocaleKey.ChatInputArea_ContextUsage_CompactButton}}"
                      CornerRadius="{DynamicResource FullCornerRadius}"/>
                  </StackPanel>
                </Flyout>
              </v:ContextUsageRing.Flyout>
            </v:ContextUsageRing>

            <Button
              x:Name="PART_SendButton" Classes="Primary Rounded"
              VerticalAlignment="Center"
              IsVisible="{Binding !IsVisible, ElementName=PART_CancelButton}"
              ToolTip.Tip="{I18N {x:Static LocaleKey.ChatInputArea_SendButton_ToolTip}}">
              <Button.IsEnabled>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <TemplateBinding Property="IsSendButtonEnabled"/>
                  <MultiBinding Converter="{x:Static BoolConverters.Or}">
                    <Binding
                      Converter="{x:Static vc:Int32Converters.GreaterThan}"
                      ConverterParameter="0" Path="#PART_ChatTextEditor.Text?.Length"
                      TargetNullValue="{x:False}"/>
                    <Binding
                      Converter="{x:Static ObjectConverters.IsNotNull}"
                      Path="#PART_ChatTextEditor.LeadingContent"/>
                    <Binding
                      Converter="{x:Static vc:Int32Converters.GreaterThan}"
                      ConverterParameter="0" Path="$parent[v:ChatInputArea].ChatAttachmentItemsSource?.Count"
                      TargetNullValue="{x:False}"/>
                  </MultiBinding>
                </MultiBinding>
              </Button.IsEnabled>

              <LucideIcon
                Margin="-2,0,0,-2"
                Foreground="{DynamicResource PrimaryForegroundColor}"
                Kind="Send"
                Size="{DynamicResource FontSizeL}"/>
            </Button>

            <Button
              x:Name="PART_CancelButton" Classes="Primary Rounded"
              Command="{TemplateBinding CancelCommand}"
              Focusable="False"
              ToolTip.Tip="{I18N {x:Static LocaleKey.ChatInputArea_CancelButton_ToolTip}}">
              <Border
                Width="12" Height="12"
                Background="{DynamicResource PrimaryForegroundColor}"
                CornerRadius="1"/>
            </Button>
          </StackPanel>
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>