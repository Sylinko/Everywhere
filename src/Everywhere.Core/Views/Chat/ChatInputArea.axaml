<ResourceDictionary
  xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:in="clr-namespace:Everywhere.Interactions" xmlns:v="clr-namespace:Everywhere.Views">
  <ControlTheme
    x:Key="{x:Type v:ChatInputArea}"
    TargetType="v:ChatInputArea">

    <Style Selector="^ /template/ :is(Button).Rounded">
      <Setter Property="MinHeight" Value="{DynamicResource FontSize3Xl}"/>
      <Setter Property="Height" Value="{DynamicResource FontSize3Xl}"/>
      <Setter Property="MinWidth" Value="{DynamicResource FontSize3Xl}"/>
      <Setter Property="Width" Value="{DynamicResource FontSize3Xl}"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="{DynamicResource FullCornerRadius}"/>
    </Style>

    <Style Selector="^ /template/ MenuItem.Rounded">
      <Setter Property="Width" Value="{DynamicResource FontSize3Xl}"/>
      <Setter Property="Height" Value="{DynamicResource FontSize3Xl}"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="{DynamicResource FullCornerRadius}"/>
    </Style>

    <Setter Property="FontSize" Value="{DynamicResource FontSizeM}"/>
    <Setter Property="Padding" Value="4"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid
          x:Name="PART_RootGrid" ColumnDefinitions="Auto,*,Auto"
          RowDefinitions="*,Auto,Auto" RowSpacing="4">
          <v:ChatTextEditor
            x:Name="PART_ChatTextEditor" Grid.Row="0"
            Grid.Column="0" Grid.ColumnSpan="3"
            Padding="{TemplateBinding Padding}"
            LeadingContent="{TemplateBinding LeadingContent, Mode=TwoWay}"
            LeadingContentTemplate="{TemplateBinding LeadingContentTemplate}"
            MaxLength="{TemplateBinding MaxLength}"
            PlaceholderText="{TemplateBinding PlaceholderText}"
            Text="{TemplateBinding Text, Mode=TwoWay}"/>

          <v:ChatAttachmentSizeTransitionContainer
            x:Name="PART_ChatAttachmentSizeTransitionContainer" Grid.Row="1"
            Grid.Column="0" Grid.ColumnSpan="3"
            Margin="6,0" ClipToBounds="True"
            IsVisible="{Binding !!ChatAttachmentItemsSource?.Count, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue={x:False}}">
            <ScrollViewer
              x:Name="PART_AttachmentScrollViewer" MaxHeight="52"
              Margin="0,2" Padding="0"
              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <Interaction.Behaviors>
                <in:AutoScrollBehavior/>
              </Interaction.Behaviors>

              <v:ChatAttachmentItemsControl
                x:Name="PART_ChatAttachmentItemsControl"
                ItemsSource="{TemplateBinding ChatAttachmentItemsSource}"
                RemoveCommand="{TemplateBinding RemoveAttachmentCommand}"/>
            </ScrollViewer>
          </v:ChatAttachmentSizeTransitionContainer>

          <ContentControl
            x:Name="PART_ToolBarContentControl" Grid.Row="2"
            Grid.Column="0" Grid.ColumnSpan="2"
            Margin="3,0,3,3"
            Content="{TemplateBinding ToolBarContent}"/>

          <ContentControl
            x:Name="PART_TrailingContentControl" Grid.Row="2"
            Grid.Column="2" Margin="3"
            VerticalAlignment="Center"
            Content="{TemplateBinding TrailingContent}"/>
        </Grid>
      </ControlTemplate>
    </Setter>

    <Style Selector="^.Compact">
      <Style Selector="^ /template/ Grid#PART_RootGrid">
        <Setter Property="RowSpacing" Value="0"/>
      </Style>

      <Style Selector="^ /template/ v|ChatTextEditor#PART_ChatTextEditor">
        <Setter Property="Grid.Column" Value="1"/>
        <Setter Property="Grid.ColumnSpan" Value="1"/>
        <Setter Property="Margin" Value="4,0,0,0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="MaxWidth" Value="480"/>
        <Setter Property="MaxHeight" Value="{DynamicResource LineHeight2Xl}"/>
      </Style>

      <Style Selector="^ /template/ v|ChatAttachmentSizeTransitionContainer#PART_ChatAttachmentSizeTransitionContainer">
        <Setter Property="IsVisible" Value="False"/>
      </Style>

      <Style Selector="^ /template/ ContentControl#PART_ToolBarContentControl">
        <Setter Property="Grid.Row" Value="0"/>
        <Setter Property="Grid.ColumnSpan" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0"/>
      </Style>

      <Style Selector="^ /template/ ContentControl#PART_TrailingContentControl">
        <Setter Property="Grid.Row" Value="0"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
    </Style>
  </ControlTheme>
</ResourceDictionary>
