<UserControl
  x:Class="Everywhere.Views.ChatErrorDetailsView" xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="using:Everywhere.Views"
  MinWidth="400" MaxWidth="900"
  x:DataType="v:ChatErrorDetailsView">
  <DockPanel
    Margin="16" VerticalSpacing="12">
    <TextBlock
      DockPanel.Dock="Top" FontWeight="SemiBold"
      Text="{I18N {x:Static LocaleKey.ChatRequest_ErrorDetails}}"/>
    <Button
      DockPanel.Dock="Bottom" HorizontalAlignment="Right"
      Command="{Binding $parent[v:ChatErrorDetailsView].CopyDetailsCommand}"
      Content="{I18N {x:Static LocaleKey.ChatRequest_CopyDetails}}"/>
    <ScrollViewer MaxHeight="500">
      <SelectableTextBlock
        FontFamily="monospace"
        Text="{Binding $parent[v:ChatErrorDetailsView].Details}"
        TextWrapping="Wrap"/>
    </ScrollViewer>
  </DockPanel>
</UserControl>
