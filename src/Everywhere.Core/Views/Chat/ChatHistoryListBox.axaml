<ListBox
  x:Class="Everywhere.Views.ChatHistoryListBox" xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:chat="using:Everywhere.Chat"
  xmlns:in="using:Everywhere.Interactions" xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
  xmlns:v="using:Everywhere.Views" xmlns:vc="clr-namespace:Everywhere.ValueConverters"
  x:Name="Self" Padding="8"
  AutoScrollToSelectedItem="False" Background="Transparent"
  BorderThickness="0" CornerRadius="0">
  <ListBox.Template>
    <ControlTemplate>
      <ScrollViewer
        x:Name="PART_ScrollViewer" BringIntoViewOnFocusChange="False"
        HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Interaction.Behaviors>
          <in:IncrementalLoadBehavior
            EstimatedItemHeight="40"
            IsEnabled="{Binding #Self.ViewModel?.PersistentState.IsChatWindowHistoryOpened}"
            Loader="{Binding #Self.ViewModel?.ChatContextManager}"
            MaximumLoadCount="100" OverscanItemCount="2"
            PageSize="20"/>
        </Interaction.Behaviors>
        <ItemsPresenter
          x:Name="PART_ItemsPresenter"
          Margin="{TemplateBinding Padding}"
          ItemsPanel="{TemplateBinding ItemsPanel}"/>
      </ScrollViewer>
    </ControlTemplate>
  </ListBox.Template>

  <ListBox.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="10,2"/>
      <Style Selector="^:not(:pointerover) StackPanel#ActionsPanel">
        <Setter Property="IsVisible" Value="False"/>
      </Style>
    </Style>

    <Style Selector="LucideIcon">
      <Setter Property="Size" Value="{DynamicResource FontSizeM}"/>
    </Style>
  </ListBox.Styles>

  <ListBox.Resources>
    <MenuFlyout
      x:Key="ChatItemMenuFlyout" x:DataType="chat:ChatMetadata">
      <MenuItem
        Command="{Binding #Self.ViewModel?.RenameChatCommand}"
        CommandParameter="{Binding}"
        Header="{I18N {x:Static LocaleKey.ChatHistory_Rename_Header}}"
        Icon="{LucideIconContent Pencil}"
        IsVisible="{Binding !IsTemporary}"/>
      <MenuItem
        Command="{Binding #Self.ViewModel?.ToggleChatPinCommand}"
        CommandParameter="{Binding}"
        Header="{I18N {x:Static LocaleKey.ChatHistory_Pin}}"
        Icon="{LucideIconContent Pin}">
        <MenuItem.IsVisible>
          <Binding Path="!IsPinned"/>
        </MenuItem.IsVisible>
      </MenuItem>
      <MenuItem
        Command="{Binding #Self.ViewModel?.ToggleChatPinCommand}"
        CommandParameter="{Binding}"
        Header="{I18N {x:Static LocaleKey.ChatHistory_Unpin}}"
        Icon="{LucideIconContent PinOff}">
        <MenuItem.IsVisible>
          <Binding Path="IsPinned"/>
        </MenuItem.IsVisible>
      </MenuItem>
      <Separator/>

      <MenuItem
        Command="{Binding #Self.ViewModel?.ExportMarkdownCommand}"
        CommandParameter="{Binding}"
        Header="{I18N {x:Static LocaleKey.ChatWindow_ChatHistory_ExportMarkdownMenuItem_Header}}"
        Icon="{LucideIconContent Upload}"/>
      <MenuItem
        Command="{Binding #Self.ViewModel?.ManageChatSyncCommand}"
        CommandParameter="{Binding}"
        Header="{I18N {x:Static LocaleKey.ChatWindow_ManageChatSyncMenuItem_Header}}"
        Icon="{LucideIconContent Cloud}">
        <MenuItem.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="!IsTemporary"/>
            <Binding
              ElementName="Self" Path="ViewModel?.HasSyncService"/>
          </MultiBinding>
        </MenuItem.IsVisible>
      </MenuItem>
      <MenuItem
        Command="{Binding #Self.ViewModel?.ArchiveChatCommand}"
        CommandParameter="{Binding}"
        Foreground="{DynamicResource WarningColor}"
        Header="{I18N {x:Static LocaleKey.ChatHistory_Archive_Header}}"
        Icon="{LucideIconContent Archive}">
        <MenuItem.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="!IsArchived"/>
            <Binding Path="!IsTemporary"/>
          </MultiBinding>
        </MenuItem.IsVisible>
      </MenuItem>
      <MenuItem
        Command="{Binding #Self.ViewModel?.RestoreChatCommand}"
        CommandParameter="{Binding}"
        Foreground="{DynamicResource WarningColor}"
        Header="{I18N {x:Static LocaleKey.ChatHistory_Unarchive_Header}}"
        Icon="{LucideIconContent ArchiveRestore}"
        IsVisible="{Binding IsArchived}"/>
      <MenuItem
        Command="{Binding #Self.ViewModel?.PersistChatCommand}"
        CommandParameter="{Binding}"
        Header="{I18N {x:Static LocaleKey.ChatHistory_Persist}}"
        Icon="{LucideIconContent Save}"
        IsVisible="{Binding IsTemporary}"/>
      <MenuItem
        Command="{Binding #Self.ViewModel?.DeleteChatPermanentlyCommand}"
        CommandParameter="{Binding}"
        Foreground="{DynamicResource ErrorColor}"
        Header="{I18N {x:Static LocaleKey.ChatHistory_Delete_Header}}"
        Icon="{LucideIconContent Trash2}"/>
    </MenuFlyout>
  </ListBox.Resources>

  <ListBox.DataTemplates>
    <DataTemplate DataType="chat:ChatHistorySection">
      <DockPanel
        Margin="4,2,0,0" HorizontalSpacing="4">
        <TextBlock
          Classes="Muted Small" DockPanel.Dock="Left"
          HorizontalAlignment="Left"
          FontSize="{DynamicResource FontSizeS}">
          <TextBlock.Text>
            <I18N Key="{Binding HeaderKey}"/>
          </TextBlock.Text>
        </TextBlock>

        <Border
          Height="0.5"
          Background="{DynamicResource BorderColor}"/>
      </DockPanel>
    </DataTemplate>
    <DataTemplate DataType="chat:ChatMetadata">
      <Grid
        MinHeight="24" Background="Transparent"
        ColumnDefinitions="Auto,*,Auto"
        ContextFlyout="{StaticResource ChatItemMenuFlyout}">
        <v:LazyIndexedContentControl
          Grid.Column="0" HorizontalAlignment="Center"
          VerticalAlignment="Center"
          ItemIndex="{Binding States, Converter={x:Static vc:Int32Converters.FromEnum}}">
          <!--  None  -->
          <shadui:EmptyDataTemplate/>

          <!--  Busy  -->
          <DataTemplate x:DataType="chat:ChatMetadata">
            <LucideIcon
              Margin="0,0,8,0" HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Foreground="{DynamicResource WarningColor60}"
              Kind="CircleDashed"
              Size="{DynamicResource FontSizeS}">
              <LucideIcon.Styles>
                <Style Selector="LucideIcon">
                  <Style.Animations>
                    <Animation
                      IterationCount="Infinite" Duration="0:0:1.8">
                      <KeyFrame Cue="0">
                        <Setter Property="RotateTransform.Angle" Value="0"/>
                      </KeyFrame>
                      <KeyFrame Cue="1">
                        <Setter Property="RotateTransform.Angle" Value="-360"/>
                      </KeyFrame>
                    </Animation>
                  </Style.Animations>
                </Style>
              </LucideIcon.Styles>
            </LucideIcon>
          </DataTemplate>

          <!--  HasNotification & Busy  -->
          <DataTemplate x:DataType="chat:ChatMetadata">
            <Border
              Width="{DynamicResource FontSizeM}"
              Height="{DynamicResource FontSizeM}"
              Margin="0,0,8,0" HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Background="{DynamicResource ErrorColor60}"
              CornerRadius="{DynamicResource FullCornerRadius}">
              <TextBlock
                HorizontalAlignment="Center" VerticalAlignment="Center"
                FontSize="{DynamicResource FontSizeXs}"
                Text="1"/>
            </Border>
          </DataTemplate>

          <!--  HasNotification  -->
          <DataTemplate x:DataType="chat:ChatMetadata">
            <Border
              Width="{DynamicResource FontSizeM}"
              Height="{DynamicResource FontSizeM}"
              Margin="0,0,8,0" HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Background="{DynamicResource ErrorColor60}"
              CornerRadius="{DynamicResource FullCornerRadius}">
              <TextBlock
                HorizontalAlignment="Center" VerticalAlignment="Center"
                FontSize="{DynamicResource FontSizeXs}"
                Text="1"/>
            </Border>
          </DataTemplate>
        </v:LazyIndexedContentControl>

        <DockPanel
          Grid.Column="1" VerticalAlignment="Center"
          HorizontalSpacing="4">
          <LucideIcon
            DockPanel.Dock="Left"
            IsVisible="{Binding IsTemporary}"
            Kind="Ghost"
            Size="{DynamicResource FontSizeS}"
            ToolTip.Tip="{I18N {x:Static LocaleKey.ChatHistory_TemporaryNotice}}"/>
          <TextBlock
            FontSize="{DynamicResource FontSizeM}"
            Text="{Binding ActualTopic}"
            TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <StackPanel
          x:Name="ActionsPanel" Grid.Column="2"
          DockPanel.Dock="Right" Margin="8,0,-8,0"
          Orientation="Horizontal" Spacing="2">
          <Button
            Classes="Compact Uniform"
            Command="{Binding #Self.ViewModel?.ToggleChatPinCommand}"
            CommandParameter="{Binding}"
            ToolTip.Tip="{I18N {x:Static LocaleKey.ChatHistory_Pin}}">
            <Button.IsVisible>
              <Binding Path="!IsPinned"/>
            </Button.IsVisible>
            <LucideIcon Kind="Pin"/>
          </Button>
          <Button
            Classes="Compact Uniform" VerticalAlignment="Center"
            Command="{Binding #Self.ViewModel?.ToggleChatPinCommand}"
            CommandParameter="{Binding}"
            ToolTip.Tip="{I18N {x:Static LocaleKey.ChatHistory_Unpin}}">
            <Button.IsVisible>
              <Binding Path="IsPinned"/>
            </Button.IsVisible>
            <LucideIcon Kind="PinOff"/>
          </Button>
          <Button
            Classes="Compact Uniform" VerticalAlignment="Center"
            Command="{Binding #Self.ViewModel?.ArchiveChatCommand}"
            CommandParameter="{Binding}"
            ToolTip.Tip="{I18N {x:Static LocaleKey.ChatHistory_Archive_Header}}">
            <Button.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="!IsArchived"/>
                <Binding Path="!IsTemporary"/>
              </MultiBinding>
            </Button.IsVisible>
            <LucideIcon Kind="Archive"/>
          </Button>
          <Button
            Classes="Compact Uniform" VerticalAlignment="Center"
            Command="{Binding #Self.ViewModel?.RestoreChatCommand}"
            CommandParameter="{Binding}"
            IsVisible="{Binding IsArchived}"
            ToolTip.Tip="{I18N {x:Static LocaleKey.ChatHistory_Unarchive_Header}}">
            <LucideIcon Kind="ArchiveRestore"/>
          </Button>
          <Button
            Classes="Compact Uniform" VerticalAlignment="Center"
            Command="{Binding #Self.ViewModel?.PersistChatCommand}"
            CommandParameter="{Binding}"
            IsVisible="{Binding IsTemporary}"
            ToolTip.Tip="{I18N {x:Static LocaleKey.ChatHistory_Persist}}">
            <LucideIcon Kind="Save"/>
          </Button>
        </StackPanel>
      </Grid>
    </DataTemplate>
  </ListBox.DataTemplates>
</ListBox>
