<ResourceDictionary
  xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:in="clr-namespace:Everywhere.Interactions" xmlns:plugins="clr-namespace:Everywhere.Chat.Plugins"
  xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI" xmlns:v="using:Everywhere.Views"
  xmlns:vc="clr-namespace:Everywhere.ValueConverters">
  <ControlTheme
    x:Key="{x:Type v:ChatActivityPreviewPresenter}"
    TargetType="v:ChatActivityPreviewPresenter">
    <Setter Property="Template">
      <ControlTemplate TargetType="v:ChatActivityPreviewPresenter">
        <ContentPresenter
          Content="{TemplateBinding Content}"
          ContentTemplate="{TemplateBinding ContentTemplate}"/>
      </ControlTemplate>
    </Setter>

    <Setter Property="shadui:BindingAssist.DataTemplates">
      <DataTemplates>
        <DataTemplate x:DataType="plugins:ChatPluginTextActivityPreview">
          <TextBlock
            Classes="Muted" VerticalAlignment="Center"
            FontSize="{DynamicResource FontSizeS}"
            MaxLines="1"
            Text="{Binding TextKey^}"
            TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
        </DataTemplate>

        <DataTemplate x:DataType="plugins:ChatPluginCommandActivityPreview">
          <TextBlock
            Classes="Muted" VerticalAlignment="Center"
            FontSize="{DynamicResource FontSizeS}"
            MaxLines="1"
            Text="{Binding Command}"
            TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
        </DataTemplate>

        <DataTemplate x:DataType="plugins:ChatPluginFileReferencesActivityPreview">
          <DockPanel HorizontalSpacing="4">
            <TextBlock
              Classes="Muted" DockPanel.Dock="Left"
              VerticalAlignment="Center"
              FontSize="{DynamicResource FontSizeS}"
              IsVisible="{Binding PrefixKey, Converter={x:Static ObjectConverters.IsNotNull}}"
              Text="{Binding PrefixKey^, FallbackValue={x:Null}}"
              TextWrapping="NoWrap"/>
            <ItemsControl
              HorizontalAlignment="Stretch" ClipToBounds="False"
              ItemsSource="{Binding References}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <v:TrimmingStackPanel
                    ClipToBounds="False" MinimumLeadingVisibleItems="1"
                    Orientation="Horizontal" Spacing="4"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="plugins:ChatPluginFileReference">
                  <Button
                    x:Name="PART_ReferenceButton" Classes="Ghost Compact Muted NoScale"
                    Margin="-5,0,5,0" Padding="5,1">
                    <Interaction.Behaviors>
                      <in:ChatFileLinkBehavior
                        Icon="{Binding #ReferenceIcon}"
                        Reference="{Binding}"/>
                    </Interaction.Behaviors>

                    <DockPanel HorizontalSpacing="4">
                      <LucideIcon
                        x:Name="ReferenceIcon" DockPanel.Dock="Left"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource MutedColor}"
                        Size="{DynamicResource FontSizeS}"/>
                      <TextBlock
                        Classes="Muted" VerticalAlignment="Center"
                        FontSize="{DynamicResource FontSizeS}"
                        MaxLines="1"
                        Text="{Binding FullPath}"
                        TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                        <Interaction.Behaviors>
                          <shadui:TextTrimmedToolTipBehavior Target="{Binding #PART_ReferenceButton}"/>
                        </Interaction.Behaviors>
                      </TextBlock>
                    </DockPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </DataTemplate>

        <DataTemplate x:DataType="plugins:ChatPluginFileTransferActivityPreview">
          <Grid
            Margin="-5,0,5,0" HorizontalAlignment="Left"
            ColumnDefinitions="Auto,Auto,*">
            <Button
              x:Name="PART_SourceButton" Classes="Ghost Compact Muted NoScale"
              Grid.Column="0" Padding="5,1">
              <Interaction.Behaviors>
                <in:ChatFileLinkBehavior
                  Icon="{Binding #SourceIcon}"
                  Reference="{Binding Source}"/>
              </Interaction.Behaviors>

              <DockPanel HorizontalSpacing="4">
                <LucideIcon
                  x:Name="SourceIcon" DockPanel.Dock="Left"
                  VerticalAlignment="Center"
                  Foreground="{DynamicResource MutedColor}"
                  Size="{DynamicResource FontSizeS}"/>
                <TextBlock
                  Classes="Muted" VerticalAlignment="Center"
                  FontSize="{DynamicResource FontSizeS}"
                  MaxLines="1"
                  Text="{Binding Source.FullPath}"
                  TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                  <Interaction.Behaviors>
                    <shadui:TextTrimmedToolTipBehavior Target="{Binding #PART_SourceButton}"/>
                  </Interaction.Behaviors>
                </TextBlock>
              </DockPanel>
            </Button>
            <TextBlock
              Classes="Muted" Grid.Column="1"
              VerticalAlignment="Center"
              FontSize="{DynamicResource FontSizeS}"
              Text="{Binding ActionKey^}"
              TextWrapping="NoWrap"/>
            <Button
              x:Name="PART_DestinationButton" Classes="Ghost Compact Muted NoScale"
              Grid.Column="2" Padding="5,1"
              HorizontalAlignment="Left">
              <Interaction.Behaviors>
                <in:ChatFileLinkBehavior
                  Icon="{Binding #DestinationIcon}"
                  Reference="{Binding Destination}"/>
              </Interaction.Behaviors>

              <DockPanel HorizontalSpacing="4">
                <LucideIcon
                  x:Name="DestinationIcon" DockPanel.Dock="Left"
                  VerticalAlignment="Center"
                  Foreground="{DynamicResource MutedColor}"
                  Size="{DynamicResource FontSizeS}"/>
                <TextBlock
                  Classes="Muted" VerticalAlignment="Center"
                  FontSize="{DynamicResource FontSizeS}"
                  MaxLines="1"
                  Text="{Binding Destination.FullPath}"
                  TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                  <Interaction.Behaviors>
                    <shadui:TextTrimmedToolTipBehavior Target="{Binding #PART_DestinationButton}"/>
                  </Interaction.Behaviors>
                </TextBlock>
              </DockPanel>
            </Button>
          </Grid>
        </DataTemplate>

        <DataTemplate x:DataType="plugins:ChatPluginUrlsActivityPreview">
          <ItemsControl
            ClipToBounds="False"
            ItemsSource="{Binding Urls}">
            <ItemsControl.Styles>
              <Style Selector="Button.Link">
                <Setter Property="Background" Value="{DynamicResource BorderColor30}"/>
                <Setter Property="shadui:ButtonAssist.HoverBackground" Value="{DynamicResource SelectionColor}"/>
                <Setter Property="Padding" Value="5,1"/>
                <Setter Property="CornerRadius" Value="{DynamicResource FullCornerRadius}"/>
              </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <v:TrimmingStackPanel
                  ClipToBounds="False" MinimumLeadingVisibleItems="1"
                  Orientation="Horizontal" Spacing="4"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button
                  x:Name="PART_UrlButton" Classes="Ghost Compact Muted Link NoScale"
                  Command="{Binding $parent[v:ChatMessageItemsControl].OpenUrlCommand}"
                  CommandParameter="{Binding}">
                  <DockPanel HorizontalSpacing="3">
                    <Panel
                      DockPanel.Dock="Left" Width="12"
                      Height="12">
                      <LucideIcon
                        Foreground="{DynamicResource MutedColor}"
                        Kind="Link" Size="12"/>
                    </Panel>
                    <TextBlock
                      Classes="Muted" VerticalAlignment="Center"
                      FontSize="{DynamicResource FontSizeS}"
                      MaxLines="1"
                      Text="{Binding Converter={x:Static vc:UrlConverters.ToHost}}"
                      TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                      <Interaction.Behaviors>
                        <shadui:TextTrimmedToolTipBehavior Target="{Binding #PART_UrlButton}"/>
                      </Interaction.Behaviors>
                    </TextBlock>
                  </DockPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DataTemplate>

        <DataTemplate x:DataType="plugins:ChatPluginSubagentActivityPreview">
          <Button
            Classes="Ghost Compact Muted NoScale" Padding="5,1"
            HorizontalAlignment="Left"
            Command="{Binding $parent[v:ChatMessageItemsControl].OpenSubagentCommand}"
            CommandParameter="{Binding}"
            CornerRadius="{DynamicResource FullCornerRadius}"
            ToolTip.Tip="{I18N {x:Static LocaleKey.ChatPluginDisplayBlockPresenter_OpenSubagent}}">
            <TextBlock
              Classes="Muted" MaxWidth="200"
              VerticalAlignment="Center"
              FontSize="{DynamicResource FontSizeS}"
              MaxLines="1"
              Text="{Binding ChatData.Metadata.Topic}"
              TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
          </Button>
        </DataTemplate>
      </DataTemplates>
    </Setter>
  </ControlTheme>
</ResourceDictionary>