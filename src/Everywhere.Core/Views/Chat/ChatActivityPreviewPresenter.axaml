<ResourceDictionary
  xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia" xmlns:plugins="clr-namespace:Everywhere.Chat.Plugins"
  xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI" xmlns:v="using:Everywhere.Views"
  xmlns:vc="clr-namespace:Everywhere.ValueConverters">
  <ControlTheme
    x:Key="{x:Type v:ChatActivityPreviewPresenter}"
    TargetType="v:ChatActivityPreviewPresenter">
    <Setter Property="Template">
      <ControlTemplate TargetType="v:ChatActivityPreviewPresenter">
        <ContentPresenter
          Content="{TemplateBinding Content}"
          ContentTemplate="{TemplateBinding ContentTemplate}"/>
      </ControlTemplate>
    </Setter>

    <Setter Property="shadui:BindingAssist.DataTemplates">
      <DataTemplates>
        <DataTemplate x:DataType="plugins:ChatPluginTextActivityPreview">
          <TextBlock
            Classes="Muted"
            FontSize="{DynamicResource FontSizeXs}"
            MaxLines="1"
            Text="{Binding TextKey^}"
            TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
        </DataTemplate>

        <DataTemplate x:DataType="plugins:ChatPluginCommandActivityPreview">
          <TextBlock
            Classes="Muted"
            FontSize="{DynamicResource FontSizeXs}"
            MaxLines="1" TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap">
            <TextBlock.Text>
              <I18N Key="{x:Static LocaleKey.BuiltInChatPlugin_Terminal_ExecuteScript_Preview}">
                <Binding Path="Command"/>
              </I18N>
            </TextBlock.Text>
          </TextBlock>
        </DataTemplate>

        <DataTemplate x:DataType="plugins:ChatPluginFileReferencesActivityPreview">
          <DockPanel HorizontalSpacing="4">
            <TextBlock
              Classes="Muted" DockPanel.Dock="Left"
              VerticalAlignment="Center"
              FontSize="{DynamicResource FontSizeXs}"
              IsVisible="{Binding PrefixKey, Converter={x:Static ObjectConverters.IsNotNull}}"
              Text="{Binding PrefixKey^, FallbackValue={x:Null}}"
              TextWrapping="NoWrap"/>
            <ItemsControl
              HorizontalAlignment="Stretch"
              ItemsSource="{Binding References}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <v:TrimmingStackPanel
                    MinimumLeadingVisibleItems="1" Orientation="Horizontal"
                    Spacing="4"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="plugins:ChatPluginFileReference">
                  <Button
                    x:Name="FileReferenceButton" Classes="Ghost Compact"
                    Margin="-5,0,5,0" Padding="5,1"
                    shadui:ButtonAssist.Icon="{LucideIconContent File}"
                    shadui:ButtonAssist.IconSize="{DynamicResource FontSizeS}"
                    Command="{Binding OpenFileLocationCommand}"
                    Foreground="{DynamicResource MutedColor}">
                    <TextBlock
                      FontSize="{DynamicResource FontSizeXs}"
                      Text="{Binding FullPath}"
                      TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                      <Interaction.Behaviors>
                        <shadui:TextTrimmedToolTipBehavior
                          Target="{Binding #FileReferenceButton}"
                          Tip="{Binding FullPath}"/>
                      </Interaction.Behaviors>
                    </TextBlock>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </DataTemplate>

        <DataTemplate x:DataType="plugins:ChatPluginFileTransferActivityPreview">
          <StackPanel
            Margin="-5,0,5,0" Orientation="Horizontal">
            <Button
              x:Name="SourceFileButton" Classes="Ghost Compact"
              Padding="5,1"
              shadui:ButtonAssist.Icon="{LucideIconContent File}"
              shadui:ButtonAssist.IconSize="{DynamicResource FontSizeS}"
              Command="{Binding Source.OpenFileLocationCommand}"
              Foreground="{DynamicResource MutedColor}">
              <TextBlock
                FontSize="{DynamicResource FontSizeXs}"
                Text="{Binding Source.FullPath}"
                TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                <Interaction.Behaviors>
                  <shadui:TextTrimmedToolTipBehavior
                    Target="{Binding #SourceFileButton}"
                    Tip="{Binding Source.FullPath}"/>
                </Interaction.Behaviors>
              </TextBlock>
            </Button>
            <TextBlock
              Classes="Muted" VerticalAlignment="Center"
              FontSize="{DynamicResource FontSizeXs}"
              Text="{Binding ActionKey^}"/>
            <Button
              x:Name="DestinationFileButton" Classes="Ghost Compact"
              Padding="5,1"
              shadui:ButtonAssist.Icon="{LucideIconContent File}"
              shadui:ButtonAssist.IconSize="{DynamicResource FontSizeS}"
              Command="{Binding Destination.OpenFileLocationCommand}"
              Foreground="{DynamicResource MutedColor}">
              <TextBlock
                FontSize="{DynamicResource FontSizeXs}"
                Text="{Binding Destination.FullPath}"
                TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                <Interaction.Behaviors>
                  <shadui:TextTrimmedToolTipBehavior
                    Target="{Binding #DestinationFileButton}"
                    Tip="{Binding Destination.FullPath}"/>
                </Interaction.Behaviors>
              </TextBlock>
            </Button>
          </StackPanel>
        </DataTemplate>

        <DataTemplate x:DataType="plugins:ChatPluginUrlsActivityPreview">
          <ItemsControl ItemsSource="{Binding Urls}">
            <ItemsControl.Styles>
              <Style Selector="Button.Link">
                <Setter Property="Background" Value="{DynamicResource BorderColor30}"/>
                <Setter Property="shadui:ButtonAssist.HoverBackground" Value="{DynamicResource SelectionColor}"/>
                <Setter Property="Padding" Value="5,1"/>
                <Setter Property="CornerRadius" Value="{DynamicResource FullCornerRadius}"/>
              </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <v:TrimmingStackPanel
                  MinimumLeadingVisibleItems="1" Orientation="Horizontal"
                  Spacing="4"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button
                  Classes="Ghost Compact Link"
                  Command="{Binding $parent[v:ChatMessageItemsControl].OpenUrlCommand}"
                  CommandParameter="{Binding}"
                  ToolTip.Tip="{Binding AbsoluteUri}">
                  <DockPanel HorizontalSpacing="3">
                    <Panel
                      DockPanel.Dock="Left" Width="12"
                      Height="12">
                      <Image
                        x:Name="FaviconImage" MaxWidth="12"
                        MaxHeight="12" md:AsyncImageLoader.SizeToContent="Manual"
                        md:AsyncImageLoader.Source="{Binding Converter={x:Static vc:UrlConverters.ToFaviconUrl}}"/>
                      <LucideIcon
                        IsVisible="{Binding #FaviconImage.Bounds.Width, Converter={x:Static vc:DoubleConverters.NotGreaterThan}, ConverterParameter=1}"
                        Kind="Link" Size="12"/>
                    </Panel>
                    <TextBlock
                      FontSize="{DynamicResource FontSizeXs}"
                      Text="{Binding Converter={x:Static vc:UrlConverters.ToHost}}"
                      TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                  </DockPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DataTemplate>

        <DataTemplate x:DataType="plugins:ChatPluginSubagentActivityPreview">
          <Button
            Classes="Ghost Compact" HorizontalAlignment="Left"
            Command="{Binding $parent[v:ChatMessageItemsControl].OpenSubagentCommand}"
            CommandParameter="{Binding}"
            CornerRadius="{DynamicResource FullCornerRadius}"
            ToolTip.Tip="{I18N {x:Static LocaleKey.ChatPluginDisplayBlockPresenter_OpenSubagent}}">
            <TextBlock
              MaxWidth="200"
              FontSize="{DynamicResource FontSizeS}"
              MaxLines="1"
              Text="{Binding ChatData.Metadata.Topic}"
              TextTrimming="CharacterEllipsis"/>
          </Button>
        </DataTemplate>
      </DataTemplates>
    </Setter>
  </ControlTheme>
</ResourceDictionary>