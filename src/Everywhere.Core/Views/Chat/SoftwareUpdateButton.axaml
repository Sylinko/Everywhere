<ResourceDictionary
  xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:common="using:Everywhere.Common" xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
  xmlns:v="using:Everywhere.Views">
  <ControlTheme
    x:Key="{x:Type v:SoftwareUpdateButton}"
    BasedOn="{StaticResource {x:Type Button}}"
    TargetType="v:SoftwareUpdateButton">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource FullCornerRadius}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="ToolTip.Placement" Value="Top"/>
    <Setter Property="ToolTip.ShowOnDisabled" Value="True"/>
    <Setter Property="ToolTip.Tip" Value="{Binding ToolTipKey^, RelativeSource={RelativeSource Self}}"/>
    <Setter Property="AutomationProperties.Name" Value="{Binding ToolTipKey^, RelativeSource={RelativeSource Self}}"/>
    <Setter Property="Content" Value="{Binding SoftwareUpdater, RelativeSource={RelativeSource Self}}"/>
    <Setter Property="ContentTemplate">
      <DataTemplate DataType="common:ISoftwareUpdater">
        <Panel>
          <LucideIcon
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Kind="ArrowBigUpDash" Size="16"/>
          <shadui:ProgressRing
            x:Name="ProgressRing" Margin="2"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            IndicatorBrush="{DynamicResource PrimaryColor}"
            IsHitTestVisible="False"
            IsIndeterminate="{Binding CurrentOperation.IsIndeterminate, FallbackValue={x:True}}"
            IsVisible="{Binding CurrentOperation.IsActive, FallbackValue={x:False}}"
            Size="NaN"
            TrackBrush="{DynamicResource BorderColor}"
            Value="{Binding CurrentOperation.Progress, FallbackValue=0}"/>
          <Border
            x:Name="ErrorDot" Width="6"
            Height="6" Margin="0,4,4,0"
            HorizontalAlignment="Right" VerticalAlignment="Top"
            Background="{DynamicResource ErrorColor60}"
            CornerRadius="3" IsHitTestVisible="False"
            IsVisible="{Binding CurrentOperation.Stage, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static common:SoftwareUpdateOperationStage.Failed}, FallbackValue={x:False}}"/>
        </Panel>
      </DataTemplate>
    </Setter>

    <Style Selector="^:available">
      <Setter Property="Background" Value="{DynamicResource SuccessColor60}"/>
      <Setter Property="shadui:ButtonAssist.HoverBackground" Value="{DynamicResource SuccessColor20}"/>
      <Setter Property="shadui:ButtonAssist.PressedBackground" Value="{DynamicResource SuccessColor10}"/>
    </Style>
  </ControlTheme>
</ResourceDictionary>