<ResourceDictionary
  xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:c="using:Everywhere.Chat" xmlns:in="clr-namespace:Everywhere.Interactions"
  xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia" xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
  xmlns:v="using:Everywhere.Views" xmlns:vc="clr-namespace:Everywhere.ValueConverters">
  <DataTemplate
    x:Key="ChatFunctionDetailsTemplate" x:DataType="c:ChatFunctionState">
    <StackPanel Spacing="2">
      <StackPanel.Styles>
        <Style Selector="ItemsControl:empty">
          <Setter Property="IsVisible" Value="False"/>
        </Style>
      </StackPanel.Styles>

      <SelectableTextBlock
        Classes="Muted" Margin="0,2,0,0"
        FontSize="{DynamicResource FontSizeS}"
        Foreground="{DynamicResource ErrorColor60}"
        IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
        Text="{Binding ErrorMessageKey^, FallbackValue={x:Null}}"
        TextWrapping="Wrap"/>

      <ItemsControl ItemsSource="{Binding DisplayBlocks}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <v:ChatPluginDisplayBlockPresenter
              Margin="0,2,0,0"
              Content="{Binding}"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ItemsControl ItemsSource="{Binding ImageViews}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="c:ViewImageFunctionResult">
            <ItemsControl
              Margin="0,2,0,0"
              ItemsSource="{Binding Items}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel
                    ItemSpacing="12" LineSpacing="8"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.DataTemplates>
                <DataTemplate DataType="c:ViewImageItem+Success">
                  <StackPanel
                    MaxWidth="240" Spacing="4">
                    <TextBlock
                      FontSize="{DynamicResource FontSizeS}"
                      Text="{Binding Name}"
                      TextTrimming="CharacterEllipsis"
                      ToolTip.Tip="{Binding SourcePath}"/>
                    <Image
                      MaxWidth="240" MaxHeight="200"
                      HorizontalAlignment="Left"
                      Source="{Binding Preview.Image}"
                      Stretch="Uniform"/>
                  </StackPanel>
                </DataTemplate>
                <DataTemplate DataType="c:ViewImageItem+Failure">
                  <StackPanel
                    MaxWidth="240" Spacing="4">
                    <TextBlock
                      FontSize="{DynamicResource FontSizeS}"
                      IsVisible="{Binding SourcePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                      Text="{Binding SourcePath}"
                      TextTrimming="PathSegmentEllipsis"
                      ToolTip.Tip="{Binding SourcePath}"/>
                    <TextBlock
                      FontSize="{DynamicResource FontSizeS}"
                      Text="{Binding ErrorMessageKey^}"
                      TextWrapping="Wrap"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.DataTemplates>
            </ItemsControl>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </DataTemplate>

  <ControlTheme
    x:Key="{x:Type v:ChatMessageControl}"
    TargetType="v:ChatMessageControl">
    <Setter Property="Template">
      <ControlTemplate TargetType="v:ChatMessageControl">
        <ContentPresenter
          x:Name="PART_ContentPresenter"
          Content="{TemplateBinding Content}">
          <ContentPresenter.Styles>
            <Style Selector="shadui|Loading">
              <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
            </Style>

            <Style Selector="shadui|SmoothBorder.ChatBubble">
              <Setter Property="Padding" Value="12,6"/>
              <Setter Property="CornerRadius" Value="{DynamicResource 2XlCornerRadius}"/>
              <Setter Property="Background" Value="{DynamicResource PrimaryColor10}"/>
              <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <Style Selector="shadui|SmoothBorder.Invalid">
              <Setter Property="Background" Value="{DynamicResource ErrorColor20}"/>
              <Setter Property="BorderThickness" Value="0"/>
              <Setter Property="ToolTip.Tip" Value="Invalid"/>
            </Style>

            <Style Selector="SelectableTextBlock">
              <Setter Property="TextWrapping" Value="Wrap"/>
              <Setter Property="LineHeight" Value="NaN"/>
            </Style>

            <Style Selector="md|MarkdownTextBlock">
              <Setter Property="LineHeight" Value="NaN"/>
            </Style>

            <Style Selector="InlineUIContainer.Code">
              <Style Selector="^ md|MarkdownTextBlock">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeM}"/>
              </Style>
            </Style>

            <Style Selector="ItemsControl:empty">
              <Setter Property="IsVisible" Value="False"/>
            </Style>
          </ContentPresenter.Styles>
        </ContentPresenter>
      </ControlTemplate>
    </Setter>
    <Setter Property="ClipToBounds" Value="False"/>
    <Setter Property="shadui:BindingAssist.DataTemplates">
      <DataTemplates>
        <DataTemplate x:DataType="c:ChatUserStrategyState">
          <StackPanel
            x:Name="PART_RootPanel" Classes="ChatMessage User"
            Margin="36,0,0,0" HorizontalAlignment="Right"
            Background="Transparent" Orientation="Vertical"
            Spacing="4">
            <StackPanel.Styles>
              <Style Selector="shadui|SmoothBorder.Editing">
                <Setter Property="BorderBrush" Value="{DynamicResource WarningColor60}"/>
                <Setter Property="Opacity" Value="0.7"/>
              </Style>

              <Style Selector="v|ConditionalContentControl#PART_ActionsControl">
                <Setter Property="Opacity" Value="0"/>
              </Style>
              <Style Selector="StackPanel#PART_RootPanel:pointerover > v|ConditionalContentControl#PART_ActionsControl">
                <Setter Property="Opacity" Value="1"/>
              </Style>
            </StackPanel.Styles>

            <StackPanel
              HorizontalAlignment="Right"
              IsVisible="{Binding IsSteered}"
              Orientation="Horizontal" Spacing="4">
              <Border
                Padding="6,2"
                Background="{DynamicResource PrimaryColor20}"
                CornerRadius="{DynamicResource FullCornerRadius}">
                <StackPanel
                  Orientation="Horizontal" Spacing="4">
                  <TablerIcon
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource PrimaryColor}"
                    Kind="CornerDownRight"
                    Size="{DynamicResource FontSizeXs}"/>
                  <TextBlock
                    Classes="Caption" VerticalAlignment="Center"
                    FontSize="{DynamicResource FontSizeXs}"
                    Foreground="{DynamicResource PrimaryColor}"
                    Text="{I18N {x:Static LocaleKey.ChatMessageControl_SteerBadge}}"/>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel
              HorizontalAlignment="Right"
              IsVisible="{Binding IsQueued}"
              Orientation="Horizontal" Spacing="4">
              <Border
                Padding="6,1"
                Background="{DynamicResource SecondaryCardBackgroundColor}"
                CornerRadius="{DynamicResource FullCornerRadius}">
                <TextBlock
                  Classes="Caption Muted"
                  FontSize="{DynamicResource FontSizeXs}"
                  Text="{I18N {x:Static LocaleKey.ChatInputDeliveryMode_Queue}}"/>
              </Border>
            </StackPanel>

            <shadui:SmoothBorder
              Classes="ChatBubble" HorizontalAlignment="Right">
              <Classes.Editing>
                <MultiBinding Converter="{x:Static vc:CommonConverters.AllEquals}">
                  <Binding Path="$parent[v:ChatMessageControl].Row.Node"/>
                  <Binding Path="$parent[v:ChatMessageItemsControl].EditingMessageNode"/>
                </MultiBinding>
              </Classes.Editing>

              <v:ConditionalContentControl Condition="{Binding Content, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <v:ConditionalContentControl.TrueContent>
                  <DataTemplate x:DataType="c:ChatUserStrategyState">
                    <md:MarkdownTextBlock>
                      <Interaction.Behaviors>
                        <in:ChatTextSearchSurfaceBehavior
                          Coordinator="{Binding $parent[v:ChatMessageItemsControl].TextSearch}"
                          Host="{Binding $parent[v:ChatMessageItemsControl]}"
                          Row="{Binding $parent[v:ChatPresentationRowPresenter].Content}"/>
                      </Interaction.Behaviors>

                      <Run
                        Foreground="{DynamicResource PrimaryColor}"
                        Text="{Binding StrategyNameKey^}"/>
                      <Run Text="{Binding Content}"/>
                    </md:MarkdownTextBlock>
                  </DataTemplate>
                </v:ConditionalContentControl.TrueContent>

                <v:ConditionalContentControl.FalseContent>
                  <DataTemplate x:DataType="c:ChatUserStrategyState">
                    <TextBlock
                      Foreground="{DynamicResource PrimaryColor}"
                      Text="{Binding StrategyNameKey^}"/>
                  </DataTemplate>
                </v:ConditionalContentControl.FalseContent>
              </v:ConditionalContentControl>
            </shadui:SmoothBorder>

            <v:ChatAttachmentItemsControl
              HorizontalAlignment="Right"
              ItemsSource="{Binding Attachments}"/>

            <v:ConditionalContentControl
              x:Name="PART_ActionsControl" HorizontalAlignment="Right"
              Condition="{Binding IsReadonly, RelativeSource={RelativeSource AncestorType={x:Type v:ChatMessageItemsControl}}}"
              ContentDataBinding="{Binding Row.Branch, RelativeSource={RelativeSource AncestorType={x:Type v:ChatMessageControl}}}">
              <v:ConditionalContentControl.FalseContent>
                <DataTemplate x:DataType="v:ChatBranchSelection">
                  <v:ChatMessageOperationPanel>
                    <NumericUpDown
                      x:Name="ChoiceSelector" Margin="0,0,4,0"
                      Maximum="{Binding ChoiceCount, FallbackValue=1}"
                      Minimum="1"
                      Value="{Binding ChoiceIndex, FallbackValue=1, Converter={x:Static vc:Int32Converters.Plus}, ConverterParameter=1}">
                      <NumericUpDown.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                          <Binding Path="Node.IsTurnStart"/>
                          <Binding
                            Converter="{x:Static vc:Int32Converters.GreaterThan}"
                            ConverterParameter="1" FallbackValue="False"
                            Path="ChoiceCount"/>
                        </MultiBinding>
                      </NumericUpDown.IsVisible>
                    </NumericUpDown>
                    <Button
                      Classes="Ghost Minimal"
                      shadui:ButtonAssist.Icon="{TablerIconContent Edit}"
                      shadui:ButtonAssist.IconSize="{DynamicResource FontSizeL}"
                      Command="{Binding $parent[v:ChatMessageItemsControl].EditMessageNodeCommand}"
                      CommandParameter="{Binding Node, Mode=OneTime}"
                      Focusable="False"
                      IsVisible="{Binding Node.IsTurnStart}"
                      ToolTip.Tip="{I18N {x:Static LocaleKey.ChatMessageControl_EditButton_Content}}"/>
                    <Button
                      Classes="Ghost Minimal"
                      shadui:ButtonAssist.Icon="{TablerIconContent Copy}"
                      shadui:ButtonAssist.IconSize="{DynamicResource FontSizeL}"
                      Command="{Binding $parent[v:ChatMessageItemsControl].CopyMessageNodeCommand}"
                      CommandParameter="{Binding Node, Mode=OneTime}"
                      Focusable="False"
                      ToolTip.Tip="{I18N {x:Static LocaleKey.Common_Copy}}">
                      <Interaction.Behaviors>
                        <in:CopiedButtonBehavior/>
                      </Interaction.Behaviors>
                    </Button>
                  </v:ChatMessageOperationPanel>
                </DataTemplate>
              </v:ConditionalContentControl.FalseContent>
            </v:ConditionalContentControl>
          </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="c:ChatUserState">
          <StackPanel
            x:Name="PART_RootPanel" Classes="ChatMessage User"
            Margin="36,0,0,0" HorizontalAlignment="Right"
            Background="Transparent" Orientation="Vertical"
            Spacing="4">
            <StackPanel.Styles>
              <Style Selector="shadui|SmoothBorder.Editing">
                <Setter Property="BorderBrush" Value="{DynamicResource WarningColor60}"/>
                <Setter Property="Opacity" Value="0.7"/>
              </Style>
              <Style Selector="v|ConditionalContentControl#PART_ActionsControl">
                <Setter Property="Opacity" Value="0"/>
              </Style>
              <Style Selector="StackPanel#PART_RootPanel:pointerover > v|ConditionalContentControl#PART_ActionsControl">
                <Setter Property="Opacity" Value="1"/>
              </Style>
            </StackPanel.Styles>

            <StackPanel
              HorizontalAlignment="Right"
              IsVisible="{Binding IsSteered}"
              Orientation="Horizontal" Spacing="4">
              <Border
                Padding="6,2"
                Background="{DynamicResource PrimaryColor20}"
                CornerRadius="{DynamicResource FullCornerRadius}">
                <StackPanel
                  Orientation="Horizontal" Spacing="4">
                  <TablerIcon
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource PrimaryColor}"
                    Kind="CornerDownRight"
                    Size="{DynamicResource FontSizeXs}"/>
                  <TextBlock
                    Classes="Caption" VerticalAlignment="Center"
                    FontSize="{DynamicResource FontSizeXs}"
                    Foreground="{DynamicResource PrimaryColor}"
                    Text="{I18N {x:Static LocaleKey.ChatMessageControl_SteerBadge}}"/>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel
              HorizontalAlignment="Right"
              IsVisible="{Binding IsQueued}"
              Orientation="Horizontal" Spacing="4">
              <Border
                Padding="6,1"
                Background="{DynamicResource SecondaryCardBackgroundColor}"
                CornerRadius="{DynamicResource FullCornerRadius}">
                <TextBlock
                  Classes="Caption Muted"
                  FontSize="{DynamicResource FontSizeXs}"
                  Text="{I18N {x:Static LocaleKey.ChatInputDeliveryMode_Queue}}"/>
              </Border>
            </StackPanel>

            <shadui:SmoothBorder
              Classes="ChatBubble" HorizontalAlignment="Right"
              IsVisible="{Binding Content, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <Classes.Editing>
                <MultiBinding Converter="{x:Static vc:CommonConverters.AllEquals}">
                  <Binding Path="$parent[v:ChatMessageControl].Row.Node"/>
                  <Binding Path="$parent[v:ChatMessageItemsControl].EditingMessageNode"/>
                </MultiBinding>
              </Classes.Editing>
              <md:MarkdownTextBlock Text="{Binding Content}">
                <Interaction.Behaviors>
                  <in:ChatTextSearchSurfaceBehavior
                    Coordinator="{Binding $parent[v:ChatMessageItemsControl].TextSearch}"
                    Host="{Binding $parent[v:ChatMessageItemsControl]}"
                    Row="{Binding $parent[v:ChatPresentationRowPresenter].Content}"/>
                </Interaction.Behaviors>
              </md:MarkdownTextBlock>
            </shadui:SmoothBorder>

            <v:ChatAttachmentItemsControl
              HorizontalAlignment="Right"
              ItemsSource="{Binding Attachments}"/>

            <v:ConditionalContentControl
              x:Name="PART_ActionsControl" HorizontalAlignment="Right"
              Condition="{Binding $parent[v:ChatMessageItemsControl].IsReadonly}"
              ContentDataBinding="{Binding $parent[v:ChatMessageControl].Row.Branch}">
              <v:ConditionalContentControl.FalseContent>
                <DataTemplate x:DataType="v:ChatBranchSelection">
                  <v:ChatMessageOperationPanel>
                    <NumericUpDown
                      x:Name="ChoiceSelector" Margin="0,0,4,0"
                      Maximum="{Binding ChoiceCount, FallbackValue=1}"
                      Minimum="1"
                      Value="{Binding ChoiceIndex, FallbackValue=1, Converter={x:Static vc:Int32Converters.Plus}, ConverterParameter=1}">
                      <NumericUpDown.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                          <Binding Path="Node.IsTurnStart"/>
                          <Binding
                            Converter="{x:Static vc:Int32Converters.GreaterThan}"
                            ConverterParameter="1" FallbackValue="False"
                            Path="ChoiceCount"/>
                        </MultiBinding>
                      </NumericUpDown.IsVisible>
                    </NumericUpDown>
                    <Button
                      Classes="Ghost Minimal"
                      shadui:ButtonAssist.Icon="{TablerIconContent Edit}"
                      shadui:ButtonAssist.IconSize="{DynamicResource FontSizeL}"
                      Command="{Binding $parent[v:ChatMessageItemsControl].EditMessageNodeCommand, Mode=OneTime}"
                      CommandParameter="{Binding Node, Mode=OneTime}"
                      Focusable="False"
                      IsVisible="{Binding Node.IsTurnStart}"
                      ToolTip.Tip="{I18N {x:Static LocaleKey.ChatMessageControl_EditButton_Content}}"/>
                    <Button
                      Classes="Ghost Minimal"
                      shadui:ButtonAssist.Icon="{TablerIconContent Copy}"
                      shadui:ButtonAssist.IconSize="{DynamicResource FontSizeL}"
                      Command="{Binding $parent[v:ChatMessageItemsControl].CopyMessageNodeCommand, Mode=OneTime}"
                      CommandParameter="{Binding Node, Mode=OneTime}"
                      Focusable="False"
                      ToolTip.Tip="{I18N {x:Static LocaleKey.Common_Copy}}">
                      <Interaction.Behaviors>
                        <in:CopiedButtonBehavior/>
                      </Interaction.Behaviors>
                    </Button>
                  </v:ChatMessageOperationPanel>
                </DataTemplate>
              </v:ConditionalContentControl.FalseContent>
            </v:ConditionalContentControl>
          </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="c:ChatUserActionState">
          <StackPanel
            Margin="36,0,0,0" HorizontalAlignment="Right"
            Background="Transparent" Orientation="Vertical"
            Spacing="4">
            <shadui:SmoothBorder
              Classes="ChatBubble" HorizontalAlignment="Right">
              <StackPanel
                Orientation="Horizontal" Spacing="2">
                <TablerIcon
                  Kind="{Binding Icon}"
                  Size="{DynamicResource FontSizeXl}"/>
                <TextBlock Text="{Binding HeaderKey^, FallbackValue={x:Null}}"/>
              </StackPanel>
            </shadui:SmoothBorder>
          </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="c:ChatCompressionState">
          <Grid
            Margin="8,4" ColumnDefinitions="*,Auto,*"
            ColumnSpacing="8"
            ToolTip.Tip="{Binding ErrorMessageKey^, FallbackValue={x:Null}}">
            <Border
              Height="1" VerticalAlignment="Center"
              Background="{DynamicResource BorderColor}"/>

            <TextBlock
              Classes="Caption Muted" Grid.Column="1"
              Classes.Busy="{Binding IsBusy}"
              Text="{Binding HeaderKey^, FallbackValue={x:Null}}">
              <TextBlock.Styles>
                <!--
                  Keep the shimmer local to the compression row until its final visual language is
                  settled. OpacityMask avoids layout work while making both separators and the label
                  read as one running operation.
                -->
                <Style Selector="TextBlock.Busy">
                  <Style.Animations>
                    <Animation
                      IterationCount="Infinite" Duration="0:0:1.8">
                      <KeyFrame Cue="0%">
                        <Setter Property="OpacityMask">
                          <LinearGradientBrush StartPoint="-65%,0%" EndPoint="0%,0%">
                            <GradientStop Offset="0" Color="#B8FFFFFF"/>
                            <GradientStop Offset="0.38" Color="#B8FFFFFF"/>
                            <GradientStop Offset="0.5" Color="#FFFFFFFF"/>
                            <GradientStop Offset="0.62" Color="#B8FFFFFF"/>
                            <GradientStop Offset="1" Color="#B8FFFFFF"/>
                          </LinearGradientBrush>
                        </Setter>
                      </KeyFrame>
                      <KeyFrame Cue="100%">
                        <Setter Property="OpacityMask">
                          <LinearGradientBrush StartPoint="100%,0%" EndPoint="165%,0%">
                            <GradientStop Offset="0" Color="#B8FFFFFF"/>
                            <GradientStop Offset="0.38" Color="#B8FFFFFF"/>
                            <GradientStop Offset="0.5" Color="#FFFFFFFF"/>
                            <GradientStop Offset="0.62" Color="#B8FFFFFF"/>
                            <GradientStop Offset="1" Color="#B8FFFFFF"/>
                          </LinearGradientBrush>
                        </Setter>
                      </KeyFrame>
                    </Animation>
                  </Style.Animations>
                </Style>
              </TextBlock.Styles>
            </TextBlock>

            <Border
              Grid.Column="2" Height="1"
              VerticalAlignment="Center"
              Background="{DynamicResource BorderColor}"/>
          </Grid>
        </DataTemplate>

        <DataTemplate DataType="c:ChatActionState">
          <v:ChatActionBubble
            ElapsedSeconds="{Binding ElapsedSeconds}"
            Header="{Binding HeaderKey^, FallbackValue={x:Null}}"
            Icon="{Binding Icon}"
            IsBusy="{Binding IsBusy}"
            IsError="{Binding ErrorMessageKey, Converter={x:Static ObjectConverters.IsNotNull}}"
            IsExpanded="False">
            <v:ChatActionBubble.ErrorContent>
              <SelectableTextBlock
                Classes="Muted" Margin="6,4"
                FontSize="{DynamicResource FontSizeS}"
                Text="{Binding ErrorMessageKey^, FallbackValue={x:Null}}"/>
            </v:ChatActionBubble.ErrorContent>
          </v:ChatActionBubble>
        </DataTemplate>

        <DataTemplate DataType="c:ChatFunctionState">
          <!--  Don't show elapsed time for function calls, since they may be waiting for user input and the time would be meaningless  -->
          <v:ChatActionBubble
            x:Name="FunctionCallChatActionBubble" AdornerLayer.IsClipEnabled="False"
            ClipToBounds="False"
            Header="{Binding HeaderKey^, FallbackValue={x:Null}}"
            Icon="{Binding Icon}"
            IsBusy="{Binding IsRunning}"
            IsError="{Binding ErrorMessageKey, Converter={x:Static ObjectConverters.IsNotNull}}">
            <AdornerLayer.Adorner>
              <shadui:Badge
                Width="20" Height="20"
                Margin="0,-8,-8,0" Padding="0"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="{DynamicResource ErrorColor60}"
                Content="!" CornerRadius="10"
                FontSize="10">
                <shadui:Badge.IsVisible>
                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="!#FunctionCallChatActionBubble.IsExpanded"/>
                    <Binding Path="IsWaitingForUserInput"/>
                  </MultiBinding>
                </shadui:Badge.IsVisible>

                <shadui:Badge.Styles>
                  <Style Selector="ContentPresenter">
                    <Style.Animations>
                      <Animation
                        IterationCount="Infinite" Duration="0:0:2">
                        <KeyFrame Cue="0%">
                          <Setter Property="Opacity" Value="1.0"/>
                        </KeyFrame>
                        <KeyFrame Cue="50%">
                          <Setter Property="Opacity" Value="0.5"/>
                        </KeyFrame>
                        <KeyFrame Cue="100%">
                          <Setter Property="Opacity" Value="1.0"/>
                        </KeyFrame>
                      </Animation>
                    </Style.Animations>
                  </Style>
                </shadui:Badge.Styles>
              </shadui:Badge>
            </AdornerLayer.Adorner>

            <v:ConditionalContentControl
              Condition="{Binding #FunctionCallChatActionBubble.IsExpanded}"
              TrueContent="{StaticResource ChatFunctionDetailsTemplate}"/>
          </v:ChatActionBubble>
        </DataTemplate>
      </DataTemplates>
    </Setter>
  </ControlTheme>
</ResourceDictionary>