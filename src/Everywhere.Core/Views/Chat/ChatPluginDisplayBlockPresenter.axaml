<ResourceDictionary
  xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia" xmlns:plugins="clr-namespace:Everywhere.Chat.Plugins"
  xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI" xmlns:v="using:Everywhere.Views"
  xmlns:vc="clr-namespace:Everywhere.ValueConverters">
  <Design.PreviewWith>
    <v:ChatPluginDisplayBlockPresenter/>
  </Design.PreviewWith>

  <ControlTheme
    x:Key="{x:Type v:ChatPluginDisplayBlockPresenter}"
    TargetType="v:ChatPluginDisplayBlockPresenter">
    <Setter Property="Template">
      <ControlTemplate TargetType="v:ChatPluginDisplayBlockPresenter">
        <ContentPresenter
          x:Name="PART_ContentPresenter"
          Content="{TemplateBinding Snapshot}"
          ContentTemplate="{TemplateBinding ContentTemplate}"/>
      </ControlTemplate>
    </Setter>

    <Setter Property="shadui:BindingAssist.DataTemplates">
      <DataTemplates>
        <DataTemplate DataType="v:ChatContainerBlockState">
          <ItemsControl ItemsSource="{Binding Children}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="4"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <v:ChatPluginDisplayBlockPresenter Content="{Binding}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DataTemplate>

        <DataTemplate DataType="plugins:ChatPluginTextDisplayBlock">
          <ScrollViewer MaxHeight="300">
            <SelectableTextBlock
              shadui:ControlAssist.ClassName="{Binding ClassName}"
              Text="{Binding Text}"
              TextWrapping="Wrap"/>
          </ScrollViewer>
        </DataTemplate>

        <DataTemplate DataType="plugins:ChatPluginDynamicLocaleKeyDisplayBlock">
          <SelectableTextBlock
            shadui:ControlAssist.ClassName="{Binding ClassName}"
            Text="{Binding Key^}"
            TextWrapping="Wrap"/>
        </DataTemplate>

        <DataTemplate DataType="plugins:ChatPluginMarkdownDisplayBlock">
          <v:ChatMarkdownRenderer Source="{Binding MarkdownBuilder}"/>
        </DataTemplate>

        <DataTemplate DataType="v:ChatProgressBlockState">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding HeaderKey^}"/>
            <ProgressBar
              IsIndeterminate="{Binding Progress, Converter={x:Static shadui:DoubleConverters.IsNaN}}"
              Maximum="1" Minimum="0"
              Value="{Binding Progress}"/>
          </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="v:ChatFileReferencesBlockState">
          <StackPanel Spacing="4">
            <TextBlock
              Classes="Muted"
              FontSize="{DynamicResource FontSizeS}"
              IsVisible="{Binding HasMoreReferences}">
              <TextBlock.Text>
                <I18N Key="{x:Static LocaleKey.ChatPluginDisplayBlockPresenter_FileReferences_TotalCountTextBlock_Text}">
                  <Binding Path="TotalReferenceCount"/>
                </I18N>
              </TextBlock.Text>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding References}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="plugins:ChatPluginFileReference">
                  <HyperlinkButton
                    Command="{Binding OpenFileLocationCommand}"
                    TextBlock.TextTrimming="CharacterEllipsis">
                    <HyperlinkButton.Content>
                      <StackPanel
                        Orientation="Horizontal" Spacing="4">
                        <LucideIcon
                          Kind="{Binding IconAsync^}"
                          Size="14"/>
                        <TextBlock
                          FontSize="{DynamicResource FontSizeS}"
                          Text="{Binding FullPath, Mode=OneTime}"
                          TextTrimming="PathSegmentEllipsis">
                          <Interaction.Behaviors>
                            <shadui:TextTrimmedToolTipBehavior Tip="{Binding FullPath, Mode=OneTime}"/>
                          </Interaction.Behaviors>
                        </TextBlock>
                      </StackPanel>
                    </HyperlinkButton.Content>
                  </HyperlinkButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock
              Classes="Muted"
              FontSize="{DynamicResource FontSizeS}"
              IsVisible="{Binding HasMoreReferences}"
              Text="{I18N {x:Static LocaleKey.ChatPluginDisplayBlockPresenter_FileReferences_HasMoreReferencesTextBlock_Text}}"/>
          </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="v:ChatDifferenceBlockState">
          <v:TextDifferenceSummaryView
            AddedLineCount="{Binding AddedLineCount}"
            CanReview="{Binding CanReview}"
            FilePath="{Binding FilePath}"
            HasLineChanges="{Binding HasLineChanges}"
            OriginalText="{Binding OriginalText}"
            RemovedLineCount="{Binding RemovedLineCount}"
            ReviewKind="{Binding ReviewKind}"
            SourcePath="{Binding SourcePath}"
            TextDifference="{Binding Difference}"/>
        </DataTemplate>

        <DataTemplate DataType="plugins:ChatPluginUrlsDisplayBlock">
          <StackPanel Spacing="4">
            <TextBlock
              Classes="Muted"
              FontSize="{DynamicResource FontSizeS}">
              <TextBlock.Text>
                <I18N Key="{x:Static LocaleKey.ChatPluginDisplayBlockPresenter_Urls_TotalCountTextBlock_Text}">
                  <Binding Path="Urls.Count"/>
                </I18N>
              </TextBlock.Text>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding Urls}">
              <ItemsControl.Styles>
                <Style Selector="Button.Link">
                  <Setter Property="Background" Value="{DynamicResource BorderColor30}"/>
                  <Setter Property="shadui:ButtonAssist.HoverBackground" Value="{DynamicResource SelectionColor}"/>
                  <Setter Property="Padding" Value="6,2"/>
                  <Setter Property="CornerRadius" Value="{DynamicResource FullCornerRadius}"/>
                </Style>
              </ItemsControl.Styles>
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel
                    ItemSpacing="6" LineSpacing="4"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="plugins:ChatPluginUrl">
                  <Button
                    Classes="Ghost Compact Link"
                    Command="{Binding $parent[v:ChatPluginDisplayBlockPresenter].OpenUrlCommand}"
                    CommandParameter="{Binding Url}"
                    ToolTip.Tip="{Binding Url}">
                    <StackPanel Orientation="Horizontal">
                      <Image
                        x:Name="FaviconImage" MaxWidth="12"
                        MaxHeight="12" md:AsyncImageLoader.SizeToContent="Manual"
                        md:AsyncImageLoader.Source="{Binding Url, Converter={x:Static vc:UrlConverters.ToFaviconUrl}}"/>
                      <LucideIcon
                        IsVisible="{Binding #FaviconImage.Bounds.Width, Converter={x:Static vc:DoubleConverters.NotGreaterThan}, ConverterParameter=1}"
                        Kind="Link" Size="12"/>
                      <TextBlock
                        Margin="4,0,0,0"
                        FontSize="{DynamicResource FontSizeS}"
                        Text="{Binding DisplayNameKey^}"/>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="plugins:ChatPluginSeparatorDisplayBlock">
          <Border
            Height="{Binding Thickness}"
            Background="{DynamicResource BorderColor}"/>
        </DataTemplate>

        <DataTemplate DataType="plugins:ChatPluginCodeBlockDisplayBlock">
          <md:CodeBlock
            Code="{Binding Code}"
            Language="{Binding Language}"/>
        </DataTemplate>

        <DataTemplate DataType="v:ChatSubagentBlockState">
          <Button
            Classes="Ghost Compact" HorizontalAlignment="Left"
            Command="{Binding $parent[v:ChatMessageItemsControl].OpenSubagentCommand}"
            CommandParameter="{Binding Block}"
            CornerRadius="{DynamicResource FullCornerRadius}"
            ToolTip.Tip="{I18N {x:Static LocaleKey.ChatPluginDisplayBlockPresenter_OpenSubagent}}">
            <TextBlock
              MaxWidth="200"
              FontSize="{DynamicResource FontSizeS}"
              MaxLines="1"
              Text="{Binding Topic}"
              TextTrimming="CharacterEllipsis"/>
          </Button>
        </DataTemplate>

        <DataTemplate DataType="plugins:ChatPluginTerminalDisplayBlock">
          <v:TerminalView DisplayBlock="{Binding}"/>
        </DataTemplate>
      </DataTemplates>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
