<ResourceDictionary
  xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:c="clr-namespace:Everywhere.Configuration" xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
  xmlns:mdSkia="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia.Svg.Skia"
  xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI" xmlns:v="using:Everywhere.Views">
  <DataTemplate
    x:Key="DeleteApiKeyDialogContentTemplate"
    x:DataType="v:ManageApiKeyForm+DeleteApiKeyDialogContent">
    <StackPanel
      MaxWidth="440" Spacing="10">
      <TextBlock
        Text="{Binding HeaderText}"
        TextWrapping="Wrap"/>

      <ScrollViewer
        MaxHeight="160" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding References}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel
                ItemSpacing="6" LineSpacing="6"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="c:ApiKeyReference">
              <shadui:SmoothBorder
                Padding="4,3,10,3"
                Background="{DynamicResource CardBackgroundColor}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="{DynamicResource FullCornerRadius}">
                <StackPanel
                  Orientation="Horizontal" Spacing="6">
                  <Panel
                    Width="{DynamicResource FontSizeXl}"
                    Height="{DynamicResource FontSizeXl}"
                    VerticalAlignment="Center">
                    <v:IconPresenter
                      FontSize="{DynamicResource FontSizeS}"
                      Icon="{Binding Icon}"
                      IconSize="{DynamicResource FontSizeM}"
                      IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"
                      LineHeight="{DynamicResource FontSizeXl}"
                      Size="{DynamicResource FontSizeXl}"/>
                    <Border
                      Width="{DynamicResource FontSizeXl}"
                      Height="{DynamicResource FontSizeXl}"
                      ClipToBounds="True"
                      CornerRadius="{DynamicResource FullCornerRadius}"
                      IsVisible="{Binding IconUrl, Converter={x:Static ObjectConverters.IsNotNull}}">
                      <Image
                        md:AsyncImageLoader.SizeToContent="Manual"
                        md:AsyncImageLoader.Source="{Binding IconUrl}"
                        mdSkia:SvgImageExtension.Css=":nth-child(0) { font-size: 1px }"
                        Stretch="UniformToFill"/>
                    </Border>
                  </Panel>

                  <TextBlock
                    MaxWidth="180" VerticalAlignment="Center"
                    Text="{Binding NameKey^}"
                    TextTrimming="CharacterEllipsis">
                    <Interaction.Behaviors>
                      <shadui:TextTrimmedToolTipBehavior/>
                    </Interaction.Behaviors>
                  </TextBlock>
                </StackPanel>
              </shadui:SmoothBorder>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <TextBlock
        Text="{Binding FooterText}"
        TextWrapping="Wrap"/>
    </StackPanel>
  </DataTemplate>

  <ControlTheme
    x:Key="{x:Type v:ManageApiKeyForm}"
    TargetType="v:ManageApiKeyForm">
    <Setter Property="ClipToBounds" Value="False"/>
    <Setter Property="MaxWidth" Value="640"/>
    <Setter Property="Template">
      <ControlTemplate TargetType="v:ManageApiKeyForm">
        <DockPanel
          Margin="0,-46,0,0" VerticalSpacing="8">
          <Button
            Classes="Secondary" DockPanel.Dock="Top"
            Margin="0,0,0,6" HorizontalAlignment="Right"
            shadui:ButtonAssist.Icon="{TablerIconContent Plus}"
            Command="{Binding AddApiKeyCommand, RelativeSource={RelativeSource TemplatedParent}}"
            Content="{I18N {x:Static LocaleKey.ManageApiKeyForm_AddApiKeyButton_Content}}"/>

          <DataGrid
            CanUserReorderColumns="False" CanUserResizeColumns="True"
            CanUserSortColumns="True" GridLinesVisibility="Horizontal"
            ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource TemplatedParent}}"
            SelectionMode="Single">
            <DataGrid.Columns>
              <DataGridTextColumn
                Binding="{ReflectionBinding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                Header="{I18N {x:Static LocaleKey.ManageApiKeyForm_NameDataGridTextColumn_Header}}"
                IsReadOnly="False"/>

              <DataGridTemplateColumn
                Width="*" CanUserSort="False"
                Header="{I18N {x:Static LocaleKey.ManageApiKeyForm_SecretKeyDataGridTemplateColumn_Header}}">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate DataType="v:ManageApiKeyForm+DataGridApiKeyModel">
                    <Panel VerticalAlignment="Center">
                      <TextBlock
                        IsVisible="{Binding !IsApiKeyVisible}"
                        Text="***************************"/>

                      <ScrollViewer
                        MaxHeight="72" HorizontalScrollBarVisibility="Disabled"
                        IsVisible="{Binding IsApiKeyVisible}">
                        <SelectableTextBlock
                          Text="{Binding RevealedSecretKey}"
                          TextWrapping="Wrap"/>
                      </ScrollViewer>
                    </Panel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
                <DataGridTemplateColumn.CellEditingTemplate>
                  <DataTemplate DataType="v:ManageApiKeyForm+DataGridApiKeyModel">
                    <TextBox Text="{Binding SecretKey, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellEditingTemplate>
              </DataGridTemplateColumn>

              <DataGridTemplateColumn
                CanUserReorder="False" CanUserResize="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate DataType="v:ManageApiKeyForm+DataGridApiKeyModel">
                    <StackPanel
                      Orientation="Horizontal" Spacing="2">
                      <StackPanel.Styles>
                        <Style Selector="ToggleButton#ApiKeyVisibleToggleButton:checked TablerIcon">
                          <Setter Property="Kind" Value="Eye"/>
                        </Style>
                      </StackPanel.Styles>

                      <ToggleButton
                        x:Name="ApiKeyVisibleToggleButton" Classes="Ghost Compact Uniform"
                        DockPanel.Dock="Right" VerticalAlignment="Center"
                        IsChecked="{Binding IsApiKeyVisible, Mode=TwoWay}">
                        <TablerIcon
                          Kind="EyeClosed"
                          Size="{DynamicResource FontSizeL}"/>
                      </ToggleButton>
                      <Button
                        Classes="Ghost Compact" Margin="2,0,0,0"
                        Command="{Binding CopyApiKeyToClipboardCommand}"
                        ToolTip.Tip="{I18N {x:Static LocaleKey.Common_Copy}}">
                        <TablerIcon
                          Kind="Copy"
                          Size="{DynamicResource FontSizeL}"/>
                      </Button>
                      <Button
                        Classes="Ghost Compact Uniform"
                        Command="{Binding $parent[v:ManageApiKeyForm].DeleteApiKeyCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{I18N {x:Static LocaleKey.Common_Delete}}">
                        <TablerIcon
                          Foreground="{DynamicResource DestructiveColor}"
                          Kind="Trash"
                          Size="{DynamicResource FontSizeL}"/>
                      </Button>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
