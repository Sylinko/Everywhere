<ResourceDictionary
  xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:avaloniaEdit="https://github.com/avaloniaui/avaloniaedit" xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
  xmlns:views="clr-namespace:Everywhere.Views">
  <Design.PreviewWith>
    <views:McpImportForm/>
  </Design.PreviewWith>

  <ControlTheme
    x:Key="{x:Type views:McpImportForm}"
    TargetType="views:McpImportForm">
    <Setter Property="ClipToBounds" Value="False"/>
    <Setter Property="MaxWidth" Value="640"/>
    <Setter Property="Template">
      <ControlTemplate TargetType="views:McpImportForm">
        <DockPanel VerticalSpacing="8">
          <DockPanel
            Margin="0,-8,0,0" Dock="Top">
            <Button
              Classes="Secondary" DockPanel.Dock="Right"
              Margin="0,-16,0,0" VerticalAlignment="Top"
              shadui:ButtonAssist.Icon="{LucideIconContent FileCodeCorner}"
              Command="{Binding OpenMcpJsonFileCommand, RelativeSource={RelativeSource TemplatedParent}}"
              Content="{I18N {x:Static LocaleKey.McpImportForm_OpenButton_Content}}"/>
            <TextBlock Text="{I18N {x:Static LocaleKey.McpImportForm_Description}}"/>
          </DockPanel>

          <Border
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="1"
            CornerRadius="{DynamicResource LgCornerRadius}">
            <ScrollViewer
              Margin="0,0,-12,-12" HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Auto">
              <avaloniaEdit:TextEditor
                x:Name="PART_TextEditor" Height="420"
                Margin="0,2,12,14" shadui:ElementAssist.FocusOnLoad="True"
                FontFamily="{DynamicResource MonospaceFontFamily}"
                ShowLineNumbers="True"
                Watermark="{x:Static views:McpImportForm.McpJsonWatermark}"/>
            </ScrollViewer>
          </Border>
        </DockPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>