<ResourceDictionary
  xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI" xmlns:v="clr-namespace:Everywhere.Views">
  <ControlTheme
    x:Key="{x:Type v:KeyboardShortcutInputBox}"
    TargetType="v:KeyboardShortcutInputBox">
    <Setter Property="Focusable" Value="True"/>
    <Setter Property="Template">
      <ControlTemplate TargetType="v:KeyboardShortcutInputBox">
        <shadui:SmoothBorder
          x:Name="PART_InputBox" MinHeight="36"
          Padding="8,4"
          Background="{DynamicResource SelectionColor}"
          BorderBrush="{DynamicResource BorderColor}"
          BorderThickness="1"
          CornerRadius="{DynamicResource 2XlCornerRadius}"
          Cursor="Hand">
          <Grid ColumnDefinitions="*, Auto">
            <Panel
              Grid.Column="0" VerticalAlignment="Center">

              <!--  Watermarks Container  -->
              <Panel
                HorizontalAlignment="Center" IsHitTestVisible="False"
                IsVisible="{Binding DisplayShortcut.IsEmpty, RelativeSource={RelativeSource TemplatedParent}}">
                <TextBlock
                  Classes="Muted" VerticalAlignment="Center"
                  IsVisible="{Binding !IsRecording, RelativeSource={RelativeSource TemplatedParent}}"
                  Text="{I18N {x:Static LocaleKey.KeyboardShortcutInputBox_PlaceholderText}}"/>
                <TextBlock
                  Classes="Muted" VerticalAlignment="Center"
                  IsVisible="{Binding IsRecording, RelativeSource={RelativeSource TemplatedParent}}"
                  Text="{I18N {x:Static LocaleKey.KeyboardShortcutInputBox_SettingWatermark}}"/>
              </Panel>

              <v:KeyboardShortcutPresenter
                IsVisible="{Binding !DisplayShortcut.IsEmpty, RelativeSource={RelativeSource TemplatedParent}}"
                Shortcut="{TemplateBinding DisplayShortcut}"/>
            </Panel>

            <Button
              x:Name="PART_ClearButton" Classes="Ghost"
              Grid.Column="1" Margin="4,0,-2,0"
              Padding="2" VerticalAlignment="Center"
              Focusable="False"
              IsVisible="{Binding !DisplayShortcut.IsEmpty, RelativeSource={RelativeSource TemplatedParent}}">
              <LucideIcon
                Foreground="{DynamicResource MutedColor}"
                Kind="X"
                Size="{DynamicResource FontSizeM}"/>
            </Button>
          </Grid>
        </shadui:SmoothBorder>
      </ControlTemplate>
    </Setter>

    <Style Selector="^[IsRecording=True] /template/ shadui|SmoothBorder#PART_InputBox">
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}"/>
    </Style>
  </ControlTheme>
</ResourceDictionary>