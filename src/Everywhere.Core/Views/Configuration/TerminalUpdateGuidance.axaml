<UserControl
  x:Class="Everywhere.Views.TerminalUpdateGuidance" xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:common="clr-namespace:Everywhere.Common"
  xmlns:v="using:Everywhere.Views">
  <StackPanel
    MinWidth="360" MaxWidth="440" Spacing="16">
    <TextBlock
      Classes="Muted"
      Text="{I18N {x:Static LocaleKey.TerminalUpdate_Introduction}}"
      TextWrapping="Wrap"/>
    <Border
      Padding="16"
      Background="{DynamicResource LightCardBackgroundColor}"
      BorderBrush="{DynamicResource BorderColor}"
      BorderThickness="1"
      CornerRadius="{DynamicResource LgCornerRadius}">
      <DockPanel HorizontalSpacing="12">
        <LucideIcon
          DockPanel.Dock="Left" VerticalAlignment="Center"
          Kind="Terminal"
          Opacity="0.6"
          Size="{DynamicResource FontSizeXl}"/>
        <SelectableTextBlock
          VerticalAlignment="Center"
          FontFamily="{StaticResource MonospaceFontFamily}"
          Text="{x:Static v:TerminalUpdateGuidance.UpdateCommand}"/>
      </DockPanel>
    </Border>
    <HyperlinkButton
      Padding="0" HorizontalAlignment="Left"
      Content="{I18N {x:Static LocaleKey.TerminalUpdate_Website_OpenDownload}}"
      NavigateUri="{x:Static common:LinkConstants.OfficialWebsiteUri}"/>
  </StackPanel>
</UserControl>
