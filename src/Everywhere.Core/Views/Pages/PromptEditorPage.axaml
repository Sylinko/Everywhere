<!--  ReSharper disable Xaml.RedundantResource  -->
<UserControl
  x:Class="Everywhere.Views.Pages.PromptEditorPage" xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:motion="using:Motion.Avalonia"
  xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI" xmlns:v="clr-namespace:Everywhere.Views"
  xmlns:vm="clr-namespace:Everywhere.ViewModels" x:Name="Self"
  x:DataType="vm:PromptEditorViewModel">
  <DockPanel
    MaxWidth="1320" Margin="24,14,24,20"
    HorizontalAlignment="Stretch" VerticalSpacing="12">
    <Grid
      DockPanel.Dock="Top" Height="36"
      ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
      <Button
        Classes="Ghost Compact" Width="36"
        Height="36" Margin="-10,0,0,0"
        VerticalAlignment="Center"
        Command="{Binding CancelCommand}">
        <PathIcon Data="{x:Static shadui:Icons.ChevronLeft}"/>
      </Button>

      <TextBlock
        Classes="h1" Grid.Column="1"
        VerticalAlignment="Center"
        Text="{Binding TitleKey^}"
        TextTrimming="CharacterEllipsis"/>

      <Button
        Classes="Secondary" Grid.Column="2"
        VerticalAlignment="Center"
        shadui:ButtonAssist.Icon="{TablerIconContent Pencil}"
        Command="{Binding SwitchToAdvancedCommand}"
        Content="{I18N {x:Static LocaleKey.PromptCreate_SwitchToAdvanced_Content}}"
        CornerRadius="{DynamicResource 2XlCornerRadius}"
        IsVisible="{Binding IsQuickMode}"/>
      <Button
        Classes="Secondary" Grid.Column="2"
        VerticalAlignment="Center"
        shadui:ButtonAssist.Icon="{TablerIconContent Settings2}"
        Command="{Binding SwitchToQuickCommand}"
        Content="{I18N {x:Static LocaleKey.PromptCreate_SwitchToQuick_Content}}"
        CornerRadius="{DynamicResource 2XlCornerRadius}"
        IsVisible="{Binding !IsQuickMode}"/>

      <Button
        Classes="Primary" Grid.Column="3"
        VerticalAlignment="Center"
        shadui:ButtonAssist.Icon="{TablerIconContent DeviceFloppy}"
        Command="{Binding SaveCommand}"
        Content="{I18N {x:Static LocaleKey.PromptEditor_SaveButton_Content}}"
        CornerRadius="{DynamicResource 2XlCornerRadius}"/>
    </Grid>

    <motion:MotionPanel>
      <motion:MotionPanel.Motion>
        <motion:StateMotion
          Easing="CubicEaseInOut"
          State="{Binding IsQuickMode}"
          Duration="0:0:0.4">
          <motion:MotionState>
            <motion:MotionState.Key>
              <x:Boolean>True</x:Boolean>
            </motion:MotionState.Key>
            <DataTemplate>
              <Panel>
                <motion:MotionSlot
                  x:Name="EditPanel" MaxWidth="600"
                  HorizontalAlignment="Center">
                  <motion:MotionSlot.TargetStyles>
                    <Style Selector="Grid#EditPanel TextBlock#QuickModeDescription">
                      <Setter Property="Opacity" Value="1"/>
                    </Style>
                    <Style Selector="Grid#EditPanel TextBlock#AdvancedModeDescription">
                      <Setter Property="Opacity" Value="0"/>
                    </Style>
                    <Style Selector="Grid#EditPanel v|PromptRecipeEditor#QuickModeEditor">
                      <Setter Property="Opacity" Value="1"/>
                      <Setter Property="IsHitTestVisible" Value="True"/>
                    </Style>
                    <Style Selector="Grid#EditPanel v|PromptAdvancedEditorControl#PromptAdvancedEditorControl">
                      <Setter Property="Opacity" Value="0"/>
                      <Setter Property="IsHitTestVisible" Value="False"/>
                    </Style>
                  </motion:MotionSlot.TargetStyles>
                </motion:MotionSlot>
                <motion:MotionSlot
                  x:Name="PreviewPanel" Margin="600,0,-600,0"
                  motion:Motion.Presence="0"/>
              </Panel>
            </DataTemplate>
          </motion:MotionState>

          <motion:MotionState>
            <motion:MotionState.Key>
              <x:Boolean>False</x:Boolean>
            </motion:MotionState.Key>
            <DataTemplate>
              <DockPanel HorizontalSpacing="24">
                <motion:MotionSlot
                  x:Name="EditPanel" DockPanel.Dock="Left"
                  MaxWidth="420">
                  <motion:MotionSlot.TargetStyles>
                    <Style Selector="Grid#EditPanel TextBlock#QuickModeDescription">
                      <Setter Property="Opacity" Value="0"/>
                    </Style>
                    <Style Selector="Grid#EditPanel TextBlock#AdvancedModeDescription">
                      <Setter Property="Opacity" Value="1"/>
                    </Style>
                    <Style Selector="Grid#EditPanel v|PromptRecipeEditor#QuickModeEditor">
                      <Setter Property="Opacity" Value="0"/>
                      <Setter Property="IsHitTestVisible" Value="False"/>
                    </Style>
                    <Style Selector="Grid#EditPanel v|PromptAdvancedEditorControl#PromptAdvancedEditorControl">
                      <Setter Property="Opacity" Value="1"/>
                      <Setter Property="IsHitTestVisible" Value="True"/>
                    </Style>
                  </motion:MotionSlot.TargetStyles>
                </motion:MotionSlot>
                <motion:MotionSlot
                  x:Name="PreviewPanel" motion:Motion.Presence="1"/>
              </DockPanel>
            </DataTemplate>
          </motion:MotionState>
        </motion:StateMotion>
      </motion:MotionPanel.Motion>

      <Grid
        x:Name="EditPanel" RowDefinitions="Auto,*"
        RowSpacing="12">
        <Grid Grid.Row="0">
          <TextBlock
            x:Name="QuickModeDescription" Classes="Muted"
            Text="{I18N {x:Static LocaleKey.PromptCreate_QuickMode_Description}}"
            TextWrapping="Wrap"/>
          <TextBlock
            x:Name="AdvancedModeDescription" Classes="Muted"
            Text="{I18N {x:Static LocaleKey.PromptCreate_AdvancedMode_Description}}"
            TextWrapping="Wrap"/>
        </Grid>

        <v:PromptRecipeEditor
          x:Name="QuickModeEditor" Grid.Row="1"
          Editor="{Binding}"/>

        <v:PromptAdvancedEditorControl
          x:Name="PromptAdvancedEditorControl" Grid.Row="1"
          PlaceholderReferences="{Binding PlaceholderReferences}"
          PromptName="{Binding Name, Mode=TwoWay}"
          PromptText="{Binding Template, Mode=TwoWay}"/>
      </Grid>

      <DockPanel
        x:Name="PreviewPanel" LastChildFill="True"
        VerticalSpacing="8">
        <ItemsControl
          DockPanel.Dock="Bottom"
          IsVisible="{Binding !!Diagnostics.Count}"
          ItemsSource="{Binding Diagnostics}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="8"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>

          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:PromptEditorViewModel+PromptDiagnosticItem">
              <shadui:Toast
                Title="{Binding MessageKey^}"
                HorizontalAlignment="Stretch" CanDismiss="False"
                CanDismissByClicking="False"
                Notification="{Binding Type, Converter={x:Static shadui:NotificationTypeToNotificationConverter.Shared}}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel
          DockPanel.Dock="Top" Spacing="4">
          <TextBlock
            Classes="h1"
            Text="{I18N {x:Static LocaleKey.PromptCreate_LivePreviewTitle}}"/>
          <TextBlock
            Classes="Muted Caption"
            Text="{I18N {x:Static LocaleKey.PromptCreate_LivePreviewDescription}}"
            TextWrapping="Wrap"/>
        </StackPanel>

        <Border
          Background="{DynamicResource CardBackgroundColor}"
          BorderBrush="{DynamicResource BorderColor}"
          BorderThickness="1" ClipToBounds="True">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <v:PromptTemplateTextBlock
              Margin="28"
              FontFamily="{StaticResource MonospaceFontFamily}"
              PromptSegments="{Binding RenderedPreviewSegments}"
              TextWrapping="Wrap"/>
          </ScrollViewer>
        </Border>
      </DockPanel>
    </motion:MotionPanel>
  </DockPanel>
</UserControl>
