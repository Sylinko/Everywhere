<UserControl
  x:Class="Everywhere.Views.Pages.HomePage" xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:common="clr-namespace:Everywhere.Common"
  xmlns:notification="clr-namespace:Everywhere.Common.Notification;assembly=Everywhere.Abstractions" xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
  xmlns:system="clr-namespace:System;assembly=System.Runtime" xmlns:v="clr-namespace:Everywhere.Views"
  xmlns:vc="clr-namespace:Everywhere.ValueConverters" xmlns:vm="clr-namespace:Everywhere.ViewModels"
  x:Name="Self" x:DataType="vm:HomePageViewModel">
  <UserControl.Styles>
    <Style Selector="UniformGrid#TopCardsUniformGrid">
      <Style Selector="^.narrow">
        <Setter Property="Columns" Value="2"/>
        <Setter Property="Rows" Value="2"/>
      </Style>
      <Style Selector="^.wide">
        <Setter Property="Columns" Value="4"/>
        <Setter Property="Rows" Value="1"/>
      </Style>
    </Style>

    <Style Selector="shadui|SmoothBorder.HomeCard">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderColor60}"/>
      <Setter Property="CornerRadius" Value="{DynamicResource 2XlCornerRadius}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16"/>

      <Style Selector="^ TextBlock.h2">
        <Setter Property="HorizontalAlignment" Value="Left"/>
      </Style>
    </Style>

    <Style Selector="HyperlinkButton.Footer">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextElement.Foreground" Value="{DynamicResource ForegroundColor}"/>

      <Style Selector="^.Icon">
        <Setter Property="Padding" Value="6"/>
        <Setter Property="CornerRadius" Value="{DynamicResource MdCornerRadius}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor60}"/>
        <Setter Property="BorderThickness" Value="0.5"/>
      </Style>
    </Style>

    <Style Selector="Button.Secondary">
      <Setter Property="Background" Value="{DynamicResource LightCardBackgroundColor}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderColor60}"/>
      <Setter Property="shadui:ButtonAssist.HoverBackground" Value="{DynamicResource SettingsItemHoverBackgroundColor}"/>
    </Style>
  </UserControl.Styles>

  <DockPanel VerticalSpacing="12">
    <Grid
      x:Name="Footer" DockPanel.Dock="Bottom"
      Margin="24,0,24,20" HorizontalAlignment="Center"
      ColumnDefinitions="*,9,Auto" ColumnSpacing="12">
      <WrapPanel
        Grid.Column="0" VerticalAlignment="Center"
        ItemSpacing="12" LineSpacing="8"
        Orientation="Horizontal">
        <HyperlinkButton
          Classes="Footer"
          Command="{Binding OpenWelcomeDialogCommand}">
          <HyperlinkButton.Content>
            <StackPanel
              Orientation="Horizontal" Spacing="6">
              <TablerIcon
                Kind="Home" Size="15"/>
              <TextBlock Text="{I18N {x:Static LocaleKey.AboutPage_WelcomePage}}"/>
            </StackPanel>
          </HyperlinkButton.Content>
        </HyperlinkButton>
        <HyperlinkButton
          Classes="Footer"
          Command="{Binding OpenChangeLogCommand}">
          <HyperlinkButton.Content>
            <StackPanel
              Orientation="Horizontal" Spacing="6">
              <TablerIcon
                Kind="Rocket" Size="15"/>
              <TextBlock Text="{I18N {x:Static LocaleKey.AboutPage_WhatsNew}}"/>
            </StackPanel>
          </HyperlinkButton.Content>
        </HyperlinkButton>
        <HyperlinkButton
          Classes="Footer"
          NavigateUri="{x:Static common:LinkConstants.GitHubRepoUri}">
          <HyperlinkButton.Content>
            <StackPanel
              Orientation="Horizontal" Spacing="6">
              <TablerIcon
                IsFilled="True" Kind="BrandGithub"
                Size="15"/>
              <TextBlock Text="{I18N {x:Static LocaleKey.AboutPage_GitHubRepo}}"/>
            </StackPanel>
          </HyperlinkButton.Content>
        </HyperlinkButton>
        <HyperlinkButton
          Classes="Footer"
          NavigateUri="{x:Static common:LinkConstants.GitHubOpenSourceLicensesUri}">
          <HyperlinkButton.Content>
            <StackPanel
              Orientation="Horizontal" Spacing="6">
              <TablerIcon
                Kind="SourceCode" Size="15"/>
              <TextBlock Text="{I18N {x:Static LocaleKey.AboutPage_OpenSourceLicenses}}"/>
            </StackPanel>
          </HyperlinkButton.Content>
        </HyperlinkButton>
      </WrapPanel>

      <Border
        Grid.Column="1" Width="0.5"
        Margin="0,4" HorizontalAlignment="Center"
        VerticalAlignment="Stretch"
        Background="{DynamicResource BorderColor}"/>

      <StackPanel
        Grid.Column="2" Orientation="Horizontal"
        Spacing="4">
        <HyperlinkButton
          Classes="Footer Icon"
          NavigateUri="{x:Static common:LinkConstants.OfficialWebsiteUri}"
          ToolTip.Tip="{I18N {x:Static LocaleKey.WelcomeView_OfficialDocsHyperlinkButton_Content}}">
          <TablerIcon
            Foreground="{DynamicResource ForegroundColor}"
            Kind="Book2"
            Size="{DynamicResource FontSizeL}"/>
        </HyperlinkButton>
        <HyperlinkButton
          Classes="Footer Icon"
          NavigateUri="{x:Static common:LinkConstants.AkaDiscordUri}"
          ToolTip.Tip="{I18N {x:Static LocaleKey.WelcomeView_DiscordHyperlinkButton_Content}}">
          <TablerIcon
            Foreground="{DynamicResource ForegroundColor}"
            IsFilled="True" Kind="BrandDiscord"
            Size="{DynamicResource FontSizeL}"/>
        </HyperlinkButton>
        <HyperlinkButton
          Classes="Footer Icon"
          NavigateUri="{x:Static common:LinkConstants.AkaQQGroupUri}"
          ToolTip.Tip="{I18N {x:Static LocaleKey.WelcomeView_QQGroupHyperlinkButton_Content}}">
          <TablerIcon
            Foreground="{DynamicResource ForegroundColor}"
            Kind="BrandQq"
            Size="{DynamicResource FontSizeL}"/>
        </HyperlinkButton>
      </StackPanel>
    </Grid>

    <ScrollViewer
      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel
        MaxWidth="1000" Margin="24,18,24,20"
        Spacing="16">
        <ItemsControl ItemsSource="{Binding Notifications}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="8"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>

          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="notification:DynamicNotification">
              <shadui:Toast
                MinWidth="0" Margin="0"
                Padding="12,8" HorizontalAlignment="Stretch"
                ActionButtonContent="{Binding ActionButtonContentKey^, FallbackValue={x:Null}}"
                ActionCommand="{Binding ActionCommand, Mode=OneTime}"
                CanDismiss="{Binding CanDismiss, Mode=OneTime}"
                CanDismissByClicking="False"
                Content="{Binding ContentKey^}"
                DismissCommand="{Binding DismissCommand, Mode=OneTime}"
                DismissCommandParameter="{Binding Mode=OneTime}"
                Notification="{Binding Type, Converter={x:Static shadui:NotificationTypeToNotificationConverter.Shared}}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid
          VerticalAlignment="Top" ColumnDefinitions="*,Auto"
          ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto"
          RowSpacing="12">
          <!--  <Border  -->
          <!--  Grid.Row="0" Grid.Column="0"  -->
          <!--  Width="120" Height="120"  -->
          <!--  Margin="-60" HorizontalAlignment="Left"  -->
          <!--  Background="{DynamicResource PrimaryColor}"  -->
          <!--  CornerRadius="60" Opacity="0.6">  -->
          <!--   <Border.Effect> -->
          <!--     <BlurEffect Radius="100"/> -->
          <!--   </Border.Effect> -->
          <!-- </Border> -->

          <StackPanel
            Grid.Row="0" Grid.Column="0"
            Orientation="Horizontal" Spacing="8">
            <Border
              Padding="8,2"
              Background="{DynamicResource PrimaryColor10}"
              CornerRadius="{DynamicResource FullCornerRadius}">
              <StackPanel
                Orientation="Horizontal" Spacing="4">
                <Ellipse
                  Width="6" Height="6"
                  VerticalAlignment="Center"
                  Fill="{DynamicResource PrimaryColor}"/>
                <TextBlock
                  Classes="Caption"
                  Foreground="{DynamicResource PrimaryColor}"
                  Text="{I18N {x:Static LocaleKey.HomePage_Today}}"/>
              </StackPanel>
            </Border>

            <TextBlock
              Classes="Caption Muted" VerticalAlignment="Center"
              Text="{Binding TodayText}"/>
          </StackPanel>

          <TextBlock
            Classes="h1" Grid.Row="1"
            Grid.Column="0">
            <Run Text="{I18N {x:Static LocaleKey.HomePage_WelcomeBackPrefix}}"/><Run>
              <Run.Text>
                <MultiBinding Converter="{x:Static shadui:BasicConverters.FirstNotNullOrEmpty}">
                  <Binding
                    Path="CloudClient.UserProfile?.Name"
                    TargetNullValue="{x:Null}"/>
                  <Binding
                    Mode="OneTime"
                    Source="{x:Static system:Environment.UserName}"/>
                </MultiBinding>
              </Run.Text>
            </Run>
          </TextBlock>

          <TextBlock
            Classes="Muted" Grid.Row="2"
            Grid.Column="0" HorizontalAlignment="Left"
            Text="{I18N {x:Static LocaleKey.HomePage_Subtitle}}"
            TextWrapping="Wrap"/>

          <Button
            Classes="Primary" Grid.Row="0"
            Grid.RowSpan="3" Grid.Column="1"
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            shadui:ButtonAssist.Icon="{TablerIconContent MessageCircle, IsFilled=True}"
            Command="{Binding StartChatCommand}"
            Content="{I18N {x:Static LocaleKey.HomePage_StartChat}}"
            CornerRadius="{DynamicResource FullCornerRadius}"/>
        </Grid>

        <UniformGrid
          x:Name="TopCardsUniformGrid" HorizontalAlignment="Stretch"
          ColumnSpacing="10" RowSpacing="6">
          <Interaction.Behaviors>
            <AdaptiveBehavior>
              <AdaptiveClassSetter
                MinWidth="0" MaxWidth="700"
                ClassName="narrow" MaxWidthOperator="LessThan"
                MinWidthOperator="GreaterThanOrEqual"/>
              <AdaptiveClassSetter
                MinWidth="700" MaxWidth="Infinity"
                ClassName="wide" MaxWidthOperator="LessThan"
                MinWidthOperator="GreaterThanOrEqual"/>
            </AdaptiveBehavior>
          </Interaction.Behaviors>

          <shadui:SmoothBorder Classes="HomeCard">
            <StackPanel Spacing="8">
              <StackPanel
                Orientation="Horizontal" Spacing="8">
                <TablerIcon
                  Foreground="{DynamicResource MutedColor}"
                  Kind="Messages" Size="16"/>
                <TextBlock
                  Classes="Muted Caption"
                  Text="{I18N {x:Static LocaleKey.HomePage_Topics}}"/>
              </StackPanel>
              <TextBlock
                Classes="h2"
                Text="{Binding Overview?.TopicCount, TargetNullValue=0, Converter={x:Static vc:Int64Converters.HumanizeNumber}}"/>
              <TextBlock
                Classes="Muted Caption" HorizontalAlignment="Left">
                <TextBlock.Text>
                  <I18N Key="{x:Static LocaleKey.HomePage_ThisMonth}">
                    <Binding
                      Path="MonthlyOverview?.TopicCount" StringFormat="{}{0:N0}"
                      TargetNullValue="0"/>
                  </I18N>
                </TextBlock.Text>
              </TextBlock>
            </StackPanel>
          </shadui:SmoothBorder>

          <shadui:SmoothBorder Classes="HomeCard">
            <StackPanel Spacing="8">
              <StackPanel
                Orientation="Horizontal" Spacing="8">
                <TablerIcon
                  Foreground="{DynamicResource MutedColor}"
                  Kind="GitBranch" Size="16"/>
                <TextBlock
                  Classes="Muted Caption"
                  Text="{I18N {x:Static LocaleKey.HomePage_Turns}}"/>
              </StackPanel>
              <TextBlock
                Classes="h2"
                Text="{Binding Overview?.TurnCount, TargetNullValue=0, Converter={x:Static vc:Int64Converters.HumanizeNumber}}"/>
              <TextBlock
                Classes="Muted Caption" HorizontalAlignment="Left"
                Text="{Binding TurnAverageKey^}"/>
            </StackPanel>
          </shadui:SmoothBorder>

          <shadui:SmoothBorder Classes="HomeCard">
            <StackPanel Spacing="8">
              <StackPanel
                Orientation="Horizontal" Spacing="8">
                <TablerIcon
                  Foreground="{DynamicResource MutedColor}"
                  Kind="Coins" Size="16"/>
                <TextBlock
                  Classes="Muted Caption"
                  Text="{I18N {x:Static LocaleKey.HomePage_Tokens}}"/>
              </StackPanel>
              <TextBlock
                Classes="h2"
                Text="{Binding Overview?.TokenSummary?.TotalTokenCount, TargetNullValue=0, Converter={x:Static vc:Int64Converters.HumanizeNumber}}">
                <ToolTip.Tip>
                  <I18N Key="{x:Static LocaleKey.HomePage_TotalTokensToolTip}">
                    <Binding
                      Path="Overview?.TokenSummary?.TotalTokenCount" StringFormat="{}{0:N0}"
                      TargetNullValue="0"/>
                  </I18N>
                </ToolTip.Tip>
              </TextBlock>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition MaxWidth="200"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto">
                  <StackPanel
                    Grid.Column="0" Orientation="Horizontal"
                    Spacing="4">
                    <ToolTip.Tip>
                      <I18N Key="{x:Static LocaleKey.HomePage_InputTokensToolTip}">
                        <Binding
                          Path="Overview?.TokenSummary?.InputTokenCount" StringFormat="{}{0:N0}"
                          TargetNullValue="0"/>
                      </I18N>
                    </ToolTip.Tip>
                    <TablerIcon
                      Foreground="{DynamicResource MutedColor}"
                      Kind="ArrowBarToDown" Size="14"/>
                    <TextBlock
                      FontWeight="SemiBold"
                      Text="{Binding Overview?.TokenSummary?.InputTokenCount, TargetNullValue=0, Converter={x:Static vc:Int64Converters.HumanizeNumber}}"/>
                  </StackPanel>

                  <StackPanel
                    Grid.Column="2" Orientation="Horizontal"
                    Spacing="4">
                    <ToolTip.Tip>
                      <I18N Key="{x:Static LocaleKey.HomePage_OutputTokensToolTip}">
                        <Binding
                          Path="Overview?.TokenSummary?.OutputTokenCount" StringFormat="{}{0:N0}"
                          TargetNullValue="0"/>
                      </I18N>
                    </ToolTip.Tip>
                    <TablerIcon
                      Foreground="{DynamicResource MutedColor}"
                      Kind="ArrowBarUp" Size="14"/>
                    <TextBlock
                      FontWeight="SemiBold"
                      Text="{Binding Overview?.TokenSummary?.OutputTokenCount, TargetNullValue=0, Converter={x:Static vc:Int64Converters.HumanizeNumber}}"/>
                  </StackPanel>

                  <StackPanel
                    Grid.Column="4" Orientation="Horizontal"
                    Spacing="4">
                    <ToolTip.Tip>
                      <I18N Key="{x:Static LocaleKey.HomePage_CachedHitRateToolTip}">
                        <Binding
                          Path="Overview?.TokenSummary?.CachedInputTokenCount" StringFormat="{}{0:N0}"
                          TargetNullValue="0"/>
                        <Binding
                          Path="Overview?.TokenSummary?.InputTokenCount" StringFormat="{}{0:N0}"
                          TargetNullValue="0"/>
                      </I18N>
                    </ToolTip.Tip>
                    <TablerIcon
                      Foreground="{DynamicResource MutedColor}"
                      Kind="DatabaseBolt" Size="14"/>
                    <TextBlock
                      FontWeight="SemiBold"
                      Text="{Binding Overview?.TokenSummary?.CachedInputHitRate, TargetNullValue=0, StringFormat='{}{0:P0}'}"/>
                  </StackPanel>
                </Grid>
              </Grid>
            </StackPanel>
          </shadui:SmoothBorder>

          <shadui:SmoothBorder Classes="HomeCard">
            <StackPanel Spacing="8">
              <StackPanel
                Orientation="Horizontal" Spacing="8">
                <TablerIcon
                  Foreground="{DynamicResource MutedColor}"
                  Kind="ZoomScan" Size="16"/>
                <TextBlock
                  Classes="Muted Caption"
                  Text="{I18N {x:Static LocaleKey.HomePage_VisualContext}}"/>
              </StackPanel>
              <TextBlock
                Classes="h2"
                Text="{Binding Overview?.VisualElementCount, TargetNullValue=0, Converter={x:Static vc:Int64Converters.HumanizeNumber}}"/>
              <TextBlock
                x:Name="VisualContextDetailText" Classes="Muted Caption"
                HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"
                ToolTip.Tip="{Binding #VisualContextDetailText.Text}">
                <TextBlock.Text>
                  <I18N Key="{x:Static LocaleKey.HomePage_VisualContextDetail}">
                    <Binding
                      Path="Overview?.VisualElementCount" StringFormat="{}{0:N0}"
                      TargetNullValue="0"/>
                    <MultiBinding Converter="{x:Static vc:Int64Converters.Sum}">
                      <Binding
                        Path="Overview?.ScreenshotCount" TargetNullValue="0"/>
                      <Binding
                        Path="Overview?.ImageCount" TargetNullValue="0"/>
                    </MultiBinding>
                  </I18N>
                </TextBlock.Text>
              </TextBlock>
            </StackPanel>
          </shadui:SmoothBorder>
        </UniformGrid>

        <shadui:SmoothBorder
          Classes="HomeCard" MinHeight="360">
          <StackPanel Spacing="12">
            <StackPanel>
              <StackPanel
                Orientation="Horizontal" Spacing="8">
                <TextBlock
                  Classes="h2"
                  Text="{I18N {x:Static LocaleKey.HomePage_AssistantActivity}}"/>
                <Border
                  Padding="8,2" VerticalAlignment="Center"
                  Background="{DynamicResource SecondaryCardBackgroundColor}"
                  CornerRadius="{DynamicResource FullCornerRadius}">
                  <TextBlock
                    Classes="Muted Caption"
                    Text="{Binding HeatmapRangeKey^}"/>
                </Border>
              </StackPanel>
              <TextBlock
                Classes="Muted Caption"
                Text="{Binding HeatmapSummaryKey^}"/>
            </StackPanel>

            <ListBox
              MaxWidth="520" HorizontalAlignment="Left"
              Background="{DynamicResource LightCardBackgroundColor}"
              BorderThickness="0"
              ItemsSource="{Binding HeatmapMetrics}"
              SelectedItem="{Binding SelectedHeatmapMetricItem, Mode=TwoWay}">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:HomePageViewModel+HeatmapMetricTabItem">
                  <TextBlock
                    Margin="6,2"
                    Text="{Binding Name^}"/>
                </DataTemplate>
              </ListBox.ItemTemplate>
              <ListBox.ItemContainerTheme>
                <ControlTheme
                  BasedOn="{StaticResource TabListBoxItemTheme}"
                  TargetType="ListBoxItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                  <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                  <Setter Property="CornerRadius" Value="{DynamicResource XlCornerRadius}"/>
                  <Setter Property="Padding" Value="4,2"/>
                </ControlTheme>
              </ListBox.ItemContainerTheme>
            </ListBox>

            <v:StatisticsHeatmap
              Days="{Binding HeatmapDays}"
              FontSize="{DynamicResource FontSizeS}"
              HighBrush="{DynamicResource PrimaryColor}"
              LowBrush="{DynamicResource LightCardBackgroundColor}"
              Months="12"/>

            <StackPanel
              HorizontalAlignment="Right" Orientation="Horizontal"
              Spacing="6">
              <TextBlock
                Classes="Muted Caption"
                Text="{I18N {x:Static LocaleKey.HomePage_Less}}"/>
              <Border
                Width="10" Height="10"
                Background="{DynamicResource PrimaryColor}"
                CornerRadius="2" Opacity="0.2"/>
              <Border
                Width="10" Height="10"
                Background="{DynamicResource PrimaryColor}"
                CornerRadius="2" Opacity="0.4"/>
              <Border
                Width="10" Height="10"
                Background="{DynamicResource PrimaryColor}"
                CornerRadius="2" Opacity="0.6"/>
              <Border
                Width="10" Height="10"
                Background="{DynamicResource PrimaryColor}"
                CornerRadius="2" Opacity="0.8"/>
              <Border
                Width="10" Height="10"
                Background="{DynamicResource PrimaryColor}"
                CornerRadius="2"/>
              <TextBlock
                Classes="Muted Caption"
                Text="{I18N {x:Static LocaleKey.HomePage_More}}"/>
            </StackPanel>
          </StackPanel>
        </shadui:SmoothBorder>

        <shadui:SmoothBorder
          Classes="HomeCard" Padding="16,12"
          IsVisible="{Binding IsSupportCardVisible}">
          <DockPanel HorizontalSpacing="12">
            <StackPanel
              DockPanel.Dock="Right" VerticalAlignment="Center"
              Orientation="Horizontal" Spacing="8">
              <Button
                Classes="Secondary Compact"
                shadui:ButtonAssist.Icon="{TablerIconContent BrandGithub, IsFilled=True}"
                shadui:ButtonAssist.IconSize="15"
                Command="{Binding OpenUriCommand}"
                CommandParameter="{x:Static common:LinkConstants.GitHubRepoUri}"
                Content="{I18N {x:Static LocaleKey.HomePage_Support_StarButton}}"/>

              <Button Classes="Secondary Compact">
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedRight">
                    <MenuItem
                      Command="{Binding OpenUriCommand}"
                      CommandParameter="{x:Static common:LinkConstants.GitHubSponsorsUri}"
                      Header="{I18N {x:Static LocaleKey.HomePage_Support_GitHubSponsors}}">
                      <MenuItem.Icon>
                        <TablerIcon
                          Kind="BrandGithub" Size="15"/>
                      </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                      Command="{Binding OpenUriCommand}"
                      CommandParameter="{x:Static common:LinkConstants.AfdianUri}"
                      Header="{I18N {x:Static LocaleKey.HomePage_Support_Afdian}}">
                      <MenuItem.Icon>
                        <Image
                          Width="15" Height="15"
                          Stretch="Uniform">
                          <Image.Source>
                            <DrawingImage>
                              <DrawingImage.Drawing>
                                <DrawingGroup>
                                  <GeometryDrawing
                                    Brush="{DynamicResource ForegroundColor}"
                                    Geometry="F0 M160,160z M0,0z M64.9999,90.6681C63.4307,90.6681 62.1621,91.9382 62.1621,93.5091 62.1621,95.0836 63.4307,96.3537 64.9999,96.3537 66.5691,96.3537 67.8378,95.0836 67.8378,93.5091 67.8378,91.9382 66.5691,90.6681 64.9999,90.6681z"/>
                                  <GeometryDrawing
                                    Brush="{DynamicResource ForegroundColor}"
                                    Geometry="F0 M160,160z M0,0z M91.7568,99.1965C90.1876,99.1965 88.9189,100.467 88.9189,102.038 88.9189,103.612 90.1876,104.882 91.7568,104.882 93.326,104.882 94.5946,103.612 94.5946,102.038 94.5946,100.467 93.326,99.1965 91.7568,99.1965z"/>
                                  <GeometryDrawing
