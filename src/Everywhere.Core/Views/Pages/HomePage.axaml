                </Button.Flyout>
                <StackPanel
                  Orientation="Horizontal" Spacing="6">
                  <TablerIcon
                    Foreground="#F83860" IsFilled="True"
                    Kind="Heart" Size="15"/>
                  <TextBlock
                    VerticalAlignment="Center"
                    Text="{I18N {x:Static LocaleKey.HomePage_Support_SponsorButton}}"/>
                  <TablerIcon
                    Kind="ChevronDown" Opacity="0.7"
                    Size="14"/>
                </StackPanel>
              </Button>

              <Button
                Classes="Ghost Compact Muted" Padding="4"
                VerticalAlignment="Center"
                Command="{Binding DismissSupportCardCommand}"
                ToolTip.Tip="{I18N {x:Static LocaleKey.HomePage_Support_DismissToolTip}}">
                <TablerIcon
                  Kind="X" Size="14"/>
              </Button>
            </StackPanel>

            <DockPanel HorizontalSpacing="10">
              <TablerIcon
                DockPanel.Dock="Left" VerticalAlignment="Center"
                Foreground="{DynamicResource WarningColor}"
                IsFilled="True" Kind="Star"
                Size="16"/>
              <TextBlock
                Classes="Muted" VerticalAlignment="Center"
                Text="{I18N {x:Static LocaleKey.HomePage_Support_Message}}"
                TextWrapping="Wrap"/>
            </DockPanel>
          </DockPanel>
        </shadui:SmoothBorder>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>