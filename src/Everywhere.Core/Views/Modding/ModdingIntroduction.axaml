<UserControl
  x:Class="Everywhere.Views.Modding.ModdingIntroduction" xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:modding="using:Everywhere.Views.Modding"
  xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI" x:DataType="modding:ModdingIntroduction">
  <ScrollViewer
    MaxHeight="520" HorizontalScrollBarVisibility="Disabled">
    <StackPanel
      MaxWidth="520" Spacing="14">
      <TextBlock
        Text="{I18N {x:Static LocaleKey.ModPage_IntroductionDialog_Introduction}}"
        TextWrapping="Wrap"/>

      <shadui:SmoothBorder
        Padding="12"
        Background="{DynamicResource LightCardBackgroundColor}"
        CornerRadius="{DynamicResource 2XlCornerRadius}">
        <ItemsControl ItemsSource="{Binding Cards}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="12"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>

          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="modding:ModdingIntroductionCard">
              <DockPanel HorizontalSpacing="12">
                <TablerIcon
                  DockPanel.Dock="Left" VerticalAlignment="Center"
                  Kind="{Binding Icon}"
                  Size="{DynamicResource FontSizeXl}"/>
                <StackPanel Spacing="4">
                  <TextBlock
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource ForegroundColor}"
                    Text="{Binding TitleKey^}"/>
                  <TextBlock
                    Classes="Muted Caption"
                    Text="{Binding BodyKey^}"
                    TextWrapping="Wrap"/>
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </shadui:SmoothBorder>

      <TextBlock
        Classes="Caption Muted"
        Text="{I18N {x:Static LocaleKey.ModPage_IntroductionDialog_Note}}"
        TextWrapping="Wrap"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
