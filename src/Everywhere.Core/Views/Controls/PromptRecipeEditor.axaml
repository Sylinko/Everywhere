<UserControl
  x:Class="Everywhere.Views.PromptRecipeEditor" xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
  xmlns:v="clr-namespace:Everywhere.Views" xmlns:vm="clr-namespace:Everywhere.ViewModels"
  x:Name="Self" HorizontalAlignment="Stretch"
  VerticalAlignment="Top" x:DataType="vm:PromptEditorViewModel"
  ClipToBounds="False">
  <UserControl.Styles>
    <Style Selector="shadui|SmoothBorder.PersonaGlassCard">
      <Setter Property="Background" Value="{DynamicResource StudioSurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource StudioHairlineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="20"/>
      <Setter Property="ClipToBounds" Value="True"/>
      <Setter Property="Padding" Value="22,20"/>
    </Style>

    <!--  Tactile Borderless Frosted Chips for Scenarios, Tone, Persona & Organization  -->
    <Style Selector="Button.RecipeChip">
      <Setter Property="Background" Value="{DynamicResource StudioWellBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="11,6.5"/>
      <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="FocusAdorner" Value="{x:Null}"/>
      <Setter Property="RenderTransform" Value="scale(1)"/>
      <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border
            x:Name="ChipBorder"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}">
            <Border.Transitions>
              <Transitions>
                <BrushTransition
                  Easing="CubicEaseOut" Property="Background"
                  Duration="0:0:0.16"/>
                <BrushTransition
                  Easing="CubicEaseOut" Property="BorderBrush"
                  Duration="0:0:0.16"/>
              </Transitions>
            </Border.Transitions>
            <ContentPresenter
              x:Name="PART_ContentPresenter" HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}"
              Opacity="0.82"
              TextBlock.FontSize="{TemplateBinding FontSize}"
              TextBlock.FontWeight="{TemplateBinding FontWeight}"
              TextBlock.Foreground="{TemplateBinding Foreground}"/>
          </Border>
        </ControlTemplate>
      </Setter>
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition
            Easing="CubicEaseOut" Property="RenderTransform"
            Duration="0:0:0.14"/>
        </Transitions>
      </Setter>

      <Style Selector="^:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{DynamicResource StudioElevatedSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource StudioFieldUnderlineBrush}"/>
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Opacity" Value="1"/>
        </Style>
      </Style>

      <Style Selector="^:pressed">
        <Setter Property="RenderTransform" Value="scale(0.96)"/>
      </Style>

      <Style Selector="^.Selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="1"/>
      </Style>
    </Style>

    <!--  Per-Option Multi-Color Accent Palette (Shared Across Chips & Segmented Track)  -->
    <Style Selector="Button.accent-blue">
      <Style Selector="^ TablerIcon#OptionIcon">
        <Setter Property="Foreground" Value="{DynamicResource ChipBlueBrush}"/>
      </Style>
      <Style Selector="^.Selected">
        <Setter Property="Background" Value="{DynamicResource ChipBlueTintBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ChipBlueBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ChipBlueBrush}"/>
      </Style>
    </Style>

    <Style Selector="Button.accent-cyan">
      <Style Selector="^ TablerIcon#OptionIcon">
        <Setter Property="Foreground" Value="{DynamicResource BrandCyanBrush}"/>
      </Style>
      <Style Selector="^.Selected">
        <Setter Property="Background" Value="{DynamicResource BrandCyanTintBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrandCyanBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrandCyanBrush}"/>
      </Style>
    </Style>

    <Style Selector="Button.accent-purple">
      <Style Selector="^ TablerIcon#OptionIcon">
        <Setter Property="Foreground" Value="{DynamicResource ChipPurpleBrush}"/>
      </Style>
      <Style Selector="^.Selected">
        <Setter Property="Background" Value="{DynamicResource ChipPurpleTintBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ChipPurpleBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ChipPurpleBrush}"/>
      </Style>
    </Style>

    <Style Selector="Button.accent-indigo">
      <Style Selector="^ TablerIcon#OptionIcon">
        <Setter Property="Foreground" Value="{DynamicResource ChipIndigoBrush}"/>
      </Style>
      <Style Selector="^.Selected">
        <Setter Property="Background" Value="{DynamicResource ChipIndigoTintBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ChipIndigoBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ChipIndigoBrush}"/>
      </Style>
    </Style>

    <Style Selector="Button.accent-pink">
      <Style Selector="^ TablerIcon#OptionIcon">
        <Setter Property="Foreground" Value="{DynamicResource BrandPinkBrush}"/>
      </Style>
      <Style Selector="^.Selected">
        <Setter Property="Background" Value="{DynamicResource BrandPinkTintBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrandPinkBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrandPinkBrush}"/>
      </Style>
    </Style>

    <Style Selector="Button.accent-orange">
      <Style Selector="^ TablerIcon#OptionIcon">
        <Setter Property="Foreground" Value="{DynamicResource ChipOrangeBrush}"/>
      </Style>
      <Style Selector="^.Selected">
        <Setter Property="Background" Value="{DynamicResource ChipOrangeTintBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ChipOrangeBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ChipOrangeBrush}"/>
      </Style>
    </Style>

    <Style Selector="Button.accent-gold">
      <Style Selector="^ TablerIcon#OptionIcon">
        <Setter Property="Foreground" Value="{DynamicResource BrandGoldBrush}"/>
      </Style>
      <Style Selector="^.Selected">
        <Setter Property="Background" Value="{DynamicResource BrandGoldTintBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrandGoldBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrandGoldBrush}"/>
      </Style>
    </Style>

    <Style Selector="Button.accent-green">
      <Style Selector="^ TablerIcon#OptionIcon">
        <Setter Property="Foreground" Value="{DynamicResource ChipGreenBrush}"/>
      </Style>
      <Style Selector="^.Selected">
        <Setter Property="Background" Value="{DynamicResource ChipGreenTintBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ChipGreenBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ChipGreenBrush}"/>
      </Style>
    </Style>

    <Style Selector="Button.accent-teal">
      <Style Selector="^ TablerIcon#OptionIcon">
        <Setter Property="Foreground" Value="{DynamicResource ChipTealBrush}"/>
      </Style>
      <Style Selector="^.Selected">
        <Setter Property="Background" Value="{DynamicResource ChipTealTintBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ChipTealBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ChipTealBrush}"/>
      </Style>
    </Style>

    <Style Selector="Button.accent-red">
      <Style Selector="^ TablerIcon#OptionIcon">
        <Setter Property="Foreground" Value="{DynamicResource ChipRedBrush}"/>
      </Style>
      <Style Selector="^.Selected">
        <Setter Property="Background" Value="{DynamicResource ChipRedTintBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ChipRedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ChipRedBrush}"/>
      </Style>
    </Style>

    <!--  Seamless Ghost Disclosure Toggle for Optional Preferences  -->
    <Style Selector="ToggleButton.DisclosureToggle">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="6,6"/>
      <Setter Property="Margin" Value="-6,0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
      <Setter Property="FocusAdorner" Value="{x:Null}"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border
            x:Name="DisclosureBorder"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            CornerRadius="{TemplateBinding CornerRadius}">
            <Border.Transitions>
              <Transitions>
                <BrushTransition
                  Easing="CubicEaseOut" Property="Background"
                  Duration="0:0:0.14"/>
              </Transitions>
            </Border.Transitions>
            <ContentPresenter
              x:Name="PART_ContentPresenter"
              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
              VerticalContentAlignment="Center"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}"
              Opacity="0.78"
              TextBlock.Foreground="{TemplateBinding Foreground}"/>
          </Border>
        </ControlTemplate>
      </Setter>

      <Style Selector="^ TablerIcon#DisclosureChevron">
        <Setter Property="RenderTransform" Value="rotate(0deg)"/>
        <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
        <Setter Property="Transitions">
          <Transitions>
            <TransformOperationsTransition
              Easing="CubicEaseOut" Property="RenderTransform"
              Duration="0:0:0.18"/>
          </Transitions>
        </Setter>
      </Style>

      <Style Selector="^:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{DynamicResource StudioWellBrush}"/>
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Opacity" Value="1"/>
        </Style>
      </Style>

      <Style Selector="^:checked TablerIcon#DisclosureChevron">
        <Setter Property="RenderTransform" Value="rotate(180deg)"/>
      </Style>

      <Style Selector="^:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="1"/>
      </Style>
    </Style>
  </UserControl.Styles>

  <shadui:SmoothBorder
    Classes="PersonaGlassCard"
    DataContext="{Binding #Self.Editor}">
    <ScrollViewer
      Margin="-6,0,-18,0" HorizontalScrollBarVisibility="Disabled"
      VerticalScrollBarVisibility="Auto">
      <StackPanel
        Margin="6,0,18,0" Spacing="18">
        <!--  1. Work Scenarios (Multi-Select Multi-Color Chips, up to 3)  -->
        <StackPanel Spacing="10">
          <TextBlock
            VerticalAlignment="Center" FontSize="13"
            FontWeight="SemiBold"
            Text="{I18N {x:Static LocaleKey.PromptCreate_ScenarioLabel}}"/>

          <ItemsControl ItemsSource="{Binding ScenarioOptions}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel
                  ItemSpacing="7" LineSpacing="7"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PromptRecipeOptionItem">
                <Button
                  Classes="RecipeChip"
                  v:PromptRecipeEditor.OptionAccentId="{Binding Id}"
                  Classes.Selected="{Binding IsSelected}"
                  Command="{Binding #Self.Editor?.ToggleScenarioCommand, FallbackValue={x:Null}}"
                  CommandParameter="{Binding}">
                  <StackPanel
                    Orientation="Horizontal" Spacing="6">
                    <TablerIcon
                      x:Name="OptionIcon" VerticalAlignment="Center"
                      Kind="{Binding Icon}"
                      Size="13.5"/>
                    <TextBlock
                      VerticalAlignment="Center"
                      Text="{Binding NameKey^}"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel
            x:Name="ScenarioRequiredHint" Margin="2,-2,0,0"
            IsVisible="{Binding #Self.ShowScenarioRequiredHint}"
            Orientation="Horizontal" Spacing="6">
            <TablerIcon
              VerticalAlignment="Center"
              Foreground="{DynamicResource BrandPinkBrush}"
              Kind="AlertCircle" Size="13"/>
            <TextBlock
              Classes="Caption" VerticalAlignment="Center"
              Foreground="{DynamicResource BrandPinkBrush}"
              Text="{I18N {x:Static LocaleKey.Oobe_Personalize_ScenarioRequired}}"
              TextWrapping="Wrap"/>
          </StackPanel>
        </StackPanel>

        <!--  2. Tone and Style (Single-Select Multi-Color Chips)  -->
        <StackPanel Spacing="10">
          <TextBlock
            VerticalAlignment="Center" FontSize="13"
            FontWeight="SemiBold"
            Text="{I18N {x:Static LocaleKey.PromptCreate_ToneLabel}}"/>

          <ItemsControl ItemsSource="{Binding ToneOptions}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel
                  ItemSpacing="7" LineSpacing="7"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PromptRecipeOptionItem">
                <Button
                  Classes="RecipeChip"
                  v:PromptRecipeEditor.OptionAccentId="{Binding Id}"
                  Classes.Selected="{Binding IsSelected}"
                  Command="{Binding #Self.Editor?.SelectToneCommand, FallbackValue={x:Null}}"
                  CommandParameter="{Binding}">
                  <StackPanel
                    Orientation="Horizontal" Spacing="6">
                    <TablerIcon
                      x:Name="OptionIcon" VerticalAlignment="Center"
                      Kind="{Binding Icon}"
                      Size="13.5"/>
                    <TextBlock
                      VerticalAlignment="Center"
                      Text="{Binding NameKey^}"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!--  3. Answer Detail (3-Column Tactile Segmented Track)  -->
        <StackPanel Spacing="10">
          <TextBlock
            VerticalAlignment="Center" FontSize="13"
            FontWeight="SemiBold"
            Text="{I18N {x:Static LocaleKey.PromptCreate_DetailLabel}}"/>

          <Border
            Padding="4"
            Background="{DynamicResource StudioWellBrush}"
            BorderBrush="{DynamicResource StudioHairlineBrush}"
            BorderThickness="1" CornerRadius="12">
            <ItemsControl ItemsSource="{Binding DetailOptions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid
                    ColumnSpacing="4" Columns="3"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PromptRecipeOptionItem">
                  <Button
                    v:PromptRecipeEditor.OptionAccentId="{Binding Id}"
                    Classes.Selected="{Binding IsSelected}"
                    Command="{Binding #Self.Editor?.SelectDetailCommand, FallbackValue={x:Null}}"
                    CommandParameter="{Binding}"
                    Theme="{StaticResource SegmentChipTheme}">
                    <StackPanel
                      Orientation="Horizontal" Spacing="6">
                      <TablerIcon
                        x:Name="OptionIcon" VerticalAlignment="Center"
                        Kind="{Binding Icon}"
                        Size="13.5"/>
                      <TextBlock
                        VerticalAlignment="Center"
                        Text="{Binding NameKey^}"/>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>

        <!--  4. Seamless Ghost Disclosure for Optional Preferences  -->
        <StackPanel Spacing="0">
          <ToggleButton
            x:Name="MorePreferencesToggle" Classes="DisclosureToggle">
            <Grid
              ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock
                Grid.Column="0" VerticalAlignment="Center"
                FontSize="13" FontWeight="Medium"
                Text="{I18N {x:Static LocaleKey.PromptCreate_MorePreferences}}"/>
              <TablerIcon
                x:Name="DisclosureChevron" Grid.Column="1"
                VerticalAlignment="Center" Kind="ChevronDown"
                Size="15"/>
            </Grid>
          </ToggleButton>

          <v:ContentSizeTransitionPanel
            x:Name="OptionalPreferencesPanel" AnimateContentSize="True"
            ClipToBounds="True" ContentSizeTransitionDuration="0:0:0.22"
            ContentSizeTransitionEasing="CubicEaseOut">
            <ContentPresenter
              x:Name="OptionalPreferencesPresenter" HorizontalContentAlignment="Stretch">
              <StackPanel
                Margin="0,14,0,0"
                IsVisible="{Binding #MorePreferencesToggle.IsChecked}"
                Spacing="16">
                <!--  Prompt Name (Underlined Field, Prompt Management Only)  -->
                <StackPanel
                  IsVisible="{Binding !#Self.IsPersonalization}"
                  Spacing="6">
                  <TextBlock
                    Classes="Caption" VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{I18N {x:Static LocaleKey.PromptEditor_NameLabel}}"/>
                  <TextBox
                    x:Name="PromptNameBox"
                    PlaceholderText="{I18N {x:Static LocaleKey.PromptEditor_NamePlaceholder}}"
                    Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Theme="{StaticResource InlineFieldTextBoxTheme}"/>
                </StackPanel>

                <!--  Persona  -->
                <StackPanel Spacing="8">
                  <TextBlock
                    Classes="Caption" VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{I18N {x:Static LocaleKey.PromptCreate_PersonaLabel}}"/>
                  <ItemsControl ItemsSource="{Binding PersonaOptions}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel
                          ItemSpacing="7" LineSpacing="7"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PromptRecipeOptionItem">
                        <Button
                          Classes="RecipeChip"
                          v:PromptRecipeEditor.OptionAccentId="{Binding Id}"
                          Classes.Selected="{Binding IsSelected}"
                          Command="{Binding #Self.Editor?.SelectPersonaCommand, FallbackValue={x:Null}}"
                          CommandParameter="{Binding}">
                          <TextBlock Text="{Binding NameKey^}"/>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <!--  Preferred User Name (Underlined Field)  -->
                <StackPanel Spacing="6">
                  <TextBlock
                    Classes="Caption" VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{I18N {x:Static LocaleKey.PromptCreate_PreferredUserNameLabel}}"/>
                  <TextBox
                    x:Name="PreferredUserNameBox"
                    PlaceholderText="{I18N {x:Static LocaleKey.PromptCreate_PreferredUserNamePlaceholder}}"
                    Text="{Binding PreferredUserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Theme="{StaticResource InlineFieldTextBoxTheme}"/>
                </StackPanel>

                <!--  Organization  -->
                <StackPanel Spacing="8">
                  <TextBlock
                    Classes="Caption" VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{I18N {x:Static LocaleKey.PromptCreate_OrganizationLabel}}"/>
                  <ItemsControl ItemsSource="{Binding OrganizationOptions}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel
                          ItemSpacing="7" LineSpacing="7"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PromptRecipeOptionItem">
                        <Button
                          Classes="RecipeChip"
                          v:PromptRecipeEditor.OptionAccentId="{Binding Id}"
                          Classes.Selected="{Binding IsSelected}"
                          Command="{Binding #Self.Editor?.SelectOrganizationCommand, FallbackValue={x:Null}}"
                          CommandParameter="{Binding}">
                          <StackPanel
                            Orientation="Horizontal" Spacing="6">
                            <TablerIcon
                              x:Name="OptionIcon" VerticalAlignment="Center"
                              Kind="{Binding Icon}"
                              Size="13"/>
                            <TextBlock
                              VerticalAlignment="Center"
                              Text="{Binding NameKey^}"/>
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <!--  Additional Requirements (Underlined Multiline Field)  -->
                <StackPanel Spacing="6">
                  <TextBlock
                    Classes="Caption" VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{I18N {x:Static LocaleKey.PromptCreate_AdditionalRequirementsLabel}}"/>
                  <TextBox
                    x:Name="AdditionalRequirementsBox" MinHeight="44"
                    MaxHeight="108" AcceptsReturn="True"
                    PlaceholderText="{I18N {x:Static LocaleKey.PromptCreate_AdditionalRequirementsPlaceholder}}"
                    Text="{Binding AdditionalRequirements, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap"
                    Theme="{StaticResource InlineFieldTextBoxTheme}"/>
                </StackPanel>
              </StackPanel>
            </ContentPresenter>
          </v:ContentSizeTransitionPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </shadui:SmoothBorder>
</UserControl>
