<ResourceDictionary
  xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI" xmlns:v="using:Everywhere.Views"
  xmlns:vc="clr-namespace:Everywhere.ValueConverters">
  <Design.PreviewWith>
    <v:TextDifferenceSummaryView/>
  </Design.PreviewWith>

  <ControlTheme
    x:Key="{x:Type v:TextDifferenceSummaryView}"
    TargetType="v:TextDifferenceSummaryView">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Template">
      <ControlTemplate TargetType="v:TextDifferenceSummaryView">
        <StackPanel Orientation="Vertical">
          <StackPanel.Styles>
            <Style Selector="Run.Monospace">
              <Setter Property="FontFamily" Value="{StaticResource MonospaceFontFamily}"/>
            </Style>
          </StackPanel.Styles>

          <v:LazyIndexedContentControl
            ContentDataBinding="{Binding RelativeSource={RelativeSource TemplatedParent}}"
            ItemIndex="{TemplateBinding ReviewKind, Converter={x:Static vc:Int32Converters.FromEnum}}">
            <!--  Update  -->
            <DataTemplate x:DataType="v:TextDifferenceSummaryView">
              <HyperlinkButton
                Padding="0" HorizontalAlignment="Left"
                Command="{Binding OpenFileCommand}"
                FontSize="{DynamicResource FontSizeM}"
                FontWeight="SemiBold"
                ToolTip.Tip="{Binding FilePath}">
                <HyperlinkButton.Content>
                  <I18N Key="{x:Static LocaleKey.TextDifferenceSummaryView_UpdateHeader}">
                    <Binding
                      Converter="{x:Static vc:CommonConverters.FullPathToFileName}"
                      Path="FilePath"/>
                  </I18N>
                </HyperlinkButton.Content>
              </HyperlinkButton>
            </DataTemplate>

            <!--  Create  -->
            <DataTemplate x:DataType="v:TextDifferenceSummaryView">
              <HyperlinkButton
                Padding="0" HorizontalAlignment="Left"
                Command="{Binding OpenFileCommand}"
                FontSize="{DynamicResource FontSizeM}"
                FontWeight="SemiBold"
                ToolTip.Tip="{Binding FilePath}">
                <HyperlinkButton.Content>
                  <I18N Key="{x:Static LocaleKey.TextDifferenceSummaryView_CreateHeader}">
                    <Binding
                      Converter="{x:Static vc:CommonConverters.FullPathToFileName}"
                      Path="FilePath"/>
                  </I18N>
                </HyperlinkButton.Content>
              </HyperlinkButton>
            </DataTemplate>

            <!--  Delete  -->
            <DataTemplate x:DataType="v:TextDifferenceSummaryView">
              <HyperlinkButton
                Padding="0" HorizontalAlignment="Left"
                Command="{Binding OpenFileCommand}"
                FontSize="{DynamicResource FontSizeM}"
                FontWeight="SemiBold"
                ToolTip.Tip="{Binding FilePath}">
                <HyperlinkButton.Content>
                  <I18N Key="{x:Static LocaleKey.TextDifferenceSummaryView_DeleteHeader}">
                    <Binding
                      Converter="{x:Static vc:CommonConverters.FullPathToFileName}"
                      Path="FilePath"/>
                  </I18N>
                </HyperlinkButton.Content>
              </HyperlinkButton>
            </DataTemplate>

            <!--  MoveAndUpdate  -->
            <DataTemplate x:DataType="v:TextDifferenceSummaryView">
              <HyperlinkButton
                Padding="0" HorizontalAlignment="Left"
                Command="{Binding OpenFileCommand}"
                FontSize="{DynamicResource FontSizeM}"
                FontWeight="SemiBold"
                ToolTip.Tip="{Binding FilePath}">
                <HyperlinkButton.Content>
                  <I18N Key="{x:Static LocaleKey.TextDifferenceSummaryView_MoveAndUpdateHeader}">
                    <Binding
                      Converter="{x:Static vc:CommonConverters.FullPathToFileName}"
                      Path="SourcePath"/>
                    <Binding
                      Converter="{x:Static vc:CommonConverters.FullPathToFileName}"
                      Path="FilePath"/>
                  </I18N>
                </HyperlinkButton.Content>
              </HyperlinkButton>
            </DataTemplate>

            <!--  Move  -->
            <DataTemplate x:DataType="v:TextDifferenceSummaryView">
              <HyperlinkButton
                Padding="0" HorizontalAlignment="Left"
                Command="{Binding OpenFileCommand}"
                FontSize="{DynamicResource FontSizeM}"
                FontWeight="SemiBold"
                ToolTip.Tip="{Binding FilePath}">
                <HyperlinkButton.Content>
                  <I18N Key="{x:Static LocaleKey.TextDifferenceSummaryView_MoveHeader}">
                    <Binding
                      Converter="{x:Static vc:CommonConverters.FullPathToFileName}"
                      Path="SourcePath"/>
                    <Binding
                      Converter="{x:Static vc:CommonConverters.FullPathToFileName}"
                      Path="FilePath"/>
                  </I18N>
                </HyperlinkButton.Content>
              </HyperlinkButton>
            </DataTemplate>
          </v:LazyIndexedContentControl>

          <StackPanel
            IsVisible="{TemplateBinding HasLineChanges}"
            Orientation="Horizontal" Spacing="8">
            <TextBlock
              FontSize="{TemplateBinding FontSize}"
              Foreground="{DynamicResource SuccessColor60}"
              IsVisible="{Binding !!AddedLineCount, RelativeSource={RelativeSource TemplatedParent}}">
              <TextBlock.Text>
                <I18N Key="{x:Static LocaleKey.TextDifferenceSummaryView_AddedLineCountTextRun_Text}">
                  <TemplateBinding Property="AddedLineCount"/>
                </I18N>
              </TextBlock.Text>
            </TextBlock>
            <TextBlock
              FontSize="{TemplateBinding FontSize}"
              Foreground="{DynamicResource ErrorColor60}"
              IsVisible="{Binding !!RemovedLineCount, RelativeSource={RelativeSource TemplatedParent}}">
              <TextBlock.Text>
                <I18N Key="{x:Static LocaleKey.TextDifferenceSummaryView_RemovedLineCountTextRun_Text}">
                  <TemplateBinding Property="RemovedLineCount"/>
                </I18N>
              </TextBlock.Text>
            </TextBlock>
          </StackPanel>
          <StackPanel
            Margin="0,4,0,0"
            IsVisible="{TemplateBinding CanReview}"
            Spacing="4">
            <TextBlock Foreground="{DynamicResource MutedColor}">
              <TextBlock.Text>
                <I18N Key="{x:Static LocaleKey.Common_TextDifference_ChangeSelectionSummary}">
                  <Binding
                    Path="TextDifference?.TotalChangesCount"
                    RelativeSource="{RelativeSource TemplatedParent}"/>
                  <Binding
                    Path="TextDifference?.AcceptedChangesCount"
                    RelativeSource="{RelativeSource TemplatedParent}"/>
                </I18N>
              </TextBlock.Text>
            </TextBlock>
            <Button
              Classes="Secondary Compact" HorizontalAlignment="Left"
              shadui:ButtonAssist.Icon="{LucideIconContent SquarePen}"
              shadui:ButtonAssist.IconSize="{DynamicResource FontSizeM}"
              Command="{Binding EditCommand, RelativeSource={RelativeSource TemplatedParent}}"
              Content="{I18N {x:Static LocaleKey.TextDifferenceSummaryView_ReviewChangesButton_Content}}"/>
          </StackPanel>
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>