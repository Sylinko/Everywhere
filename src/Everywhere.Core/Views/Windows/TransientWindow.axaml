<shadui:ShadWindow
  x:Class="Everywhere.Views.TransientWindow" xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ew="clr-namespace:Everywhere"
  xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI" xmlns:v="clr-namespace:Everywhere.Views"
  Title="Everywhere" Width="1280"
  Height="800" MinWidth="400"
  MinHeight="400" Focusable="True"
  Icon="avares://Everywhere.Core/Assets/Everywhere.png" TransparencyLevelHint="Mica,AcrylicBlur,Blur,None">
  <shadui:ShadWindow.TitleBarContent>
    <v:ConditionalContentControl
      Condition="{Binding $parent[v:TransientWindow].TitleBarContentOverride, Converter={x:Static ObjectConverters.IsNull}}"
      IsHitTestVisible="False">
      <v:ConditionalContentControl.Margin>
        <OnPlatform
          x:TypeArguments="Thickness" Linux="16,8,16,6"
          Windows="16,0" macOS="76,0,0,0"/>
      </v:ConditionalContentControl.Margin>

      <v:ConditionalContentControl.TrueContent>
        <DataTemplate>
          <StackPanel
            HorizontalAlignment="Left" VerticalAlignment="Center"
            Orientation="Horizontal" Spacing="4">
            <TextBlock
              VerticalAlignment="Center" FontWeight="SemiBold"
              Text="Everywhere"/>
            <TextBlock
              VerticalAlignment="Center"
              Foreground="{DynamicResource ForegroundLeadColor}"
              Text="{x:Static ew:App.Version}"/>
          </StackPanel>
        </DataTemplate>
      </v:ConditionalContentControl.TrueContent>

      <v:ConditionalContentControl.FalseContent>
        <DataTemplate>
          <ContentPresenter
            VerticalAlignment="Center"
            Content="{Binding $parent[v:TransientWindow].TitleBarContentOverride}"
            FontWeight="SemiBold"/>
        </DataTemplate>
      </v:ConditionalContentControl.FalseContent>
    </v:ConditionalContentControl>
  </shadui:ShadWindow.TitleBarContent>

  <shadui:ShadWindow.Hosts>
    <shadui:DialogHost/>
    <shadui:ToastHost/>
  </shadui:ShadWindow.Hosts>
</shadui:ShadWindow>