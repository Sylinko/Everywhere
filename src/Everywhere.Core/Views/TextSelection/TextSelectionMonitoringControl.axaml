<ResourceDictionary
  xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI" xmlns:v="clr-namespace:Everywhere.Views">
  <ControlTheme
    x:Key="{x:Type v:TextSelectionMonitoringControl}"
    TargetType="v:TextSelectionMonitoringControl">
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <ToggleSwitch
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Command="{Binding ChangeMonitoringCommand, RelativeSource={RelativeSource TemplatedParent}}"
            CommandParameter="{Binding $self}"
            IsChecked="{Binding IsMonitoringEnabled, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
            IsVisible="{Binding !Controller.SetEnabledCommand.IsRunning, RelativeSource={RelativeSource TemplatedParent}}"/>
          <shadui:Loading
            HorizontalAlignment="Center" VerticalAlignment="Center"
            IsVisible="{Binding Controller.SetEnabledCommand.IsRunning, RelativeSource={RelativeSource TemplatedParent}}"
            Size="{DynamicResource FontSizeM}"/>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>