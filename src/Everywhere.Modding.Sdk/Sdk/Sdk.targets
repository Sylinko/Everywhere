<Project>
  <PropertyGroup>
    <_EverywhereIsSourceHost>$([System.String]::Copy('$(EverywhereHost)').EndsWith('.csproj', System.StringComparison.OrdinalIgnoreCase))</_EverywhereIsSourceHost>
    <!-- Configuration and Platform keep normal project-reference semantics. Mod identity,
         output locations and deployment options must not override the host's own properties. -->
    <_EverywhereHostPropertiesToRemove>RuntimeIdentifier;RuntimeIdentifiers;SelfContained;PublishSelfContained;PublishAot;PublishTrimmed;PublishSingleFile</_EverywhereHostPropertiesToRemove>
    <_EverywhereHostPropertiesToRemove>$(_EverywhereHostPropertiesToRemove);OutputPath;OutDir;BaseOutputPath;IntermediateOutputPath;BaseIntermediateOutputPath;MSBuildProjectExtensionsPath;PublishDir</_EverywhereHostPropertiesToRemove>
    <_EverywhereHostPropertiesToRemove>$(_EverywhereHostPropertiesToRemove);Version;PackageVersion;AssemblyVersion;FileVersion;InformationalVersion;AssemblyName;RootNamespace</_EverywhereHostPropertiesToRemove>
    <_EverywhereHostPropertiesToRemove>$(_EverywhereHostPropertiesToRemove);EverywhereHost;EverywhereHostVersion;EverywhereModApiVersion;EverywhereModId;EverywhereModEntryType;EverywhereModPlatform;EverywhereModPackagePath;EverywhereModToolsDirectory;EverywhereLocalConfiguration;EverywhereI18NNamespace</_EverywhereHostPropertiesToRemove>
  </PropertyGroup>

  <!-- Keep compilation in the standard restore/project-reference graph. The host supplies runtime
       dependencies; mod-owned package references still contribute their own runtime assets. -->
  <ItemGroup Condition="'$(_EverywhereIsSourceHost)' == 'true'">
    <ProjectReference Include="$(EverywhereHost)"
                      Private="false"
                      IncludeAssets="compile"
                      IsEverywhereHostReference="true"
                      GlobalPropertiesToRemove="$(_EverywhereHostPropertiesToRemove)" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <Target Name="EverywherePrepareHostProjectReferences" AfterTargets="IncludeTransitiveProjectReferences"
          Condition="'$(_EverywhereIsSourceHost)' == 'true'">
    <MSBuild Projects="$(EverywhereHost)" Targets="EverywhereGetModHostProjectReferences"
             RemoveProperties="TargetFramework;$(_EverywhereHostPropertiesToRemove)">
      <Output TaskParameter="TargetOutputs" ItemName="_EverywhereHostProjectReference" />
    </MSBuild>
    <ItemGroup>
      <ProjectReference Update="@(ProjectReference->WithMetadataValue('FullPath', '%(_EverywhereHostProjectReference.FullPath)'))">
        <Private>false</Private>
        <GlobalPropertiesToRemove>%(ProjectReference.GlobalPropertiesToRemove);$(_EverywhereHostPropertiesToRemove)</GlobalPropertiesToRemove>
      </ProjectReference>
    </ItemGroup>
  </Target>

  <Target Name="EverywhereImportHost" BeforeTargets="ResolveAssemblyReferences" DependsOnTargets="ResolveProjectReferences"
          Condition="'$(DesignTimeBuild)' != 'true' Or '$(_EverywhereIsSourceHost)' != 'true'">
    <Error Condition="'$(EverywhereHost)' == ''" Text="Specify EverywhereHost in Everywhere.local.props or as a build property." />
    <PropertyGroup>
      <_EverywhereHostReferences>$(IntermediateOutputPath)everywhere-host-references.txt</_EverywhereHostReferences>
      <_EverywhereHostDirectory Condition="'$(_EverywhereIsSourceHost)' != 'true'">$(EverywhereHost)</_EverywhereHostDirectory>
    </PropertyGroup>
    <!-- Reuse the resolved reference's framework/configuration and property isolation when reading
         the host descriptor. Do not launch a separate dotnet build with different global properties. -->
    <MSBuild Projects="@(_MSBuildProjectReferenceExistent)"
             Targets="EverywhereExportModHost"
             Properties="%(_MSBuildProjectReferenceExistent.SetConfiguration);%(_MSBuildProjectReferenceExistent.SetPlatform);%(_MSBuildProjectReferenceExistent.SetTargetFramework)"
             RemoveProperties="%(_MSBuildProjectReferenceExistent.GlobalPropertiesToRemove)$(_GlobalPropertiesToRemoveFromProjectReferences)"
             Condition="'%(_MSBuildProjectReferenceExistent.IsEverywhereHostReference)' == 'true'">
      <Output TaskParameter="TargetOutputs" ItemName="_EverywhereHostDescriptor" />
    </MSBuild>
    <PropertyGroup Condition="'$(_EverywhereIsSourceHost)' == 'true'">
      <_EverywhereHostDirectory>@(_EverywhereHostDescriptor->'%(RootDir)%(Directory).')</_EverywhereHostDirectory>
    </PropertyGroup>
    <Exec Command="dotnet &quot;$(EverywhereModToolsDirectory)/Everywhere.Modding.Sdk.dll&quot; import &quot;$(_EverywhereHostDirectory)&quot; &quot;$(_EverywhereHostReferences)&quot;" />
    <ReadLinesFromFile File="$(_EverywhereHostReferences)" Condition="'$(_EverywhereIsSourceHost)' != 'true'">
      <Output TaskParameter="Lines" ItemName="_EverywhereHostReference" />
    </ReadLinesFromFile>
    <ItemGroup Condition="'$(_EverywhereIsSourceHost)' != 'true'">
      <Reference Include="@(_EverywhereHostReference)">
        <HintPath>%(Identity)</HintPath>
        <Private>false</Private>
      </Reference>
    </ItemGroup>
  </Target>

  <Target Name="EverywherePack" DependsOnTargets="Build">
    <Error Condition="'$(EverywhereModId)' == '' OR '$(EverywhereModEntryType)' == ''"
           Text="EverywhereModId and EverywhereModEntryType must be declared in the project." />
    <PropertyGroup>
      <EverywhereModPlatform Condition="'$(EverywhereModPlatform)' == ''">universal</EverywhereModPlatform>
      <EverywhereModPackagePath Condition="'$(EverywhereModPackagePath)' == ''">$([System.IO.Path]::Combine('$(OutputPath)', '$(EverywhereModId)-$(Version).zip'))</EverywhereModPackagePath>
      <_EverywherePayloadList>$(IntermediateOutputPath)everywhere-payload.txt</_EverywherePayloadList>
      <_EverywherePresentationDirectory>$(IntermediateOutputPath)everywhere-presentation</_EverywherePresentationDirectory>
    </PropertyGroup>
    <ItemGroup>
      <!-- Copy-local membership determines which resolved references are shipped. RAR supplies
           typed reference/satellite lists; NuGet supplies AssetType on its runtime assets. -->
      <_EverywhereResolvedAssembly Include="@(ReferencePath);@(ReferenceDependencyPaths);@(ReferenceSatellitePaths)" />
      <_EverywhereOtherReference Include="@(ReferenceCopyLocalPaths)" />
      <_EverywhereOtherReference Remove="@(_EverywhereResolvedAssembly)" MatchOnMetadata="FullPath" MatchOnMetadataOptions="PathLike" />
      <_EverywhereManagedReference Include="@(ReferenceCopyLocalPaths)" />
      <_EverywhereManagedReference Remove="@(_EverywhereOtherReference)" MatchOnMetadata="FullPath" MatchOnMetadataOptions="PathLike" />
      <_EverywherePayload Include="@(_EverywhereManagedReference)">
        <TargetPath>%(_EverywhereManagedReference.DestinationSubDirectory)%(_EverywhereManagedReference.Filename)%(_EverywhereManagedReference.Extension)</TargetPath>
        <AssetType>runtime</AssetType>
      </_EverywherePayload>
      <_EverywherePayload Include="@(_EverywhereOtherReference)">
        <TargetPath>%(_EverywhereOtherReference.DestinationSubDirectory)%(_EverywhereOtherReference.Filename)%(_EverywhereOtherReference.Extension)</TargetPath>
        <AssetType Condition="'%(_EverywhereOtherReference.AssetType)' == ''">content</AssetType>
      </_EverywherePayload>
      <_EverywherePayload Include="@(AllItemsFullPathWithTargetPath)">
        <AssetType>content</AssetType>
      </_EverywherePayload>
      <!-- GetCopyToOutputDirectoryItems intentionally strips non-copy metadata. Read explicit
           asset roles from this project's original, target-path-assigned Content/None items. -->
      <_EverywhereExplicitAsset Include="@(ContentWithTargetPath)"
                                Condition="'%(ContentWithTargetPath.AssetType)' != '' And '%(ContentWithTargetPath.CopyToOutputDirectory)' != '' And '%(ContentWithTargetPath.CopyToOutputDirectory)' != 'Never'" />
      <_EverywhereExplicitAsset Include="@(_NoneWithTargetPath)"
                                Condition="'%(_NoneWithTargetPath.AssetType)' != '' And '%(_NoneWithTargetPath.CopyToOutputDirectory)' != '' And '%(_NoneWithTargetPath.CopyToOutputDirectory)' != 'Never'" />
      <_EverywherePayload Remove="@(_EverywhereExplicitAsset)" MatchOnMetadata="FullPath;TargetPath" MatchOnMetadataOptions="PathLike" />
      <_EverywherePayload Include="@(_EverywhereExplicitAsset)" />
      <_EverywherePayload Include="$(ProjectDepsFilePath)" Condition="Exists('$(ProjectDepsFilePath)')">
        <TargetPath>$(TargetName).deps.json</TargetPath>
        <AssetType>content</AssetType>
      </_EverywherePayload>
      <_EverywherePayload Include="@(IntermediateSatelliteAssembliesWithTargetPath)">
        <AssetType>resources</AssetType>
      </_EverywherePayload>
    </ItemGroup>
    <ItemGroup>
      <_EverywhereConventionalReadme Include="$(MSBuildProjectDirectory)/README.md" Condition="Exists('$(MSBuildProjectDirectory)/README.md')" />
      <_EverywhereConventionalReadme Include="$(MSBuildProjectDirectory)/README.*.md" />
    </ItemGroup>
    <!-- Write author text as data through standard task item transforms. Property-function string
         expressions cannot safely embed arbitrary translated text, including unmatched quotes. -->
    <MakeDir Directories="$(_EverywherePresentationDirectory)" />
    <WriteLinesToFile File="$(_EverywherePresentationDirectory)/localizations.txt" Lines="@(EverywhereModLocalization)" Overwrite="true" Encoding="UTF-8" />
    <WriteLinesToFile File="$(_EverywherePresentationDirectory)/%(EverywhereModLocalization.Identity).name.txt" Lines="@(EverywhereModLocalization->'%(Name)')" Overwrite="true" Encoding="UTF-8" />
    <WriteLinesToFile File="$(_EverywherePresentationDirectory)/%(EverywhereModLocalization.Identity).description.txt" Lines="@(EverywhereModLocalization->'%(Description)')" Overwrite="true" Encoding="UTF-8" />
    <WriteLinesToFile File="$(_EverywherePresentationDirectory)/%(EverywhereModLocalization.Identity).readme.txt" Lines="@(EverywhereModLocalization->'%(Readme)')" Overwrite="true" Encoding="UTF-8" />
    <WriteLinesToFile File="$(_EverywherePresentationDirectory)/readmes.txt" Lines="@(_EverywhereConventionalReadme->'%(Filename)%(Extension)')" Overwrite="true" Encoding="UTF-8" />
    <WriteLinesToFile File="$(_EverywherePayloadList)" Lines="@(_EverywherePayload->'%(FullPath)|%(TargetPath)|%(AssetType)')" Overwrite="true" />
    <Exec Command="dotnet &quot;$(EverywhereModToolsDirectory)/Everywhere.Modding.Sdk.dll&quot; pack &quot;$(TargetPath)&quot; &quot;$(_EverywhereHostReferences)&quot; &quot;$(_EverywherePayloadList)&quot; &quot;$(EverywhereModId)&quot; &quot;$(Version)&quot; &quot;$(EverywhereModEntryType)&quot; &quot;$(TargetFramework)&quot; &quot;$(EverywhereHostVersion)&quot; &quot;$(EverywhereModApiVersion)&quot; &quot;$(EverywhereModPlatform)&quot; &quot;$(EverywhereModPackagePath)&quot; &quot;$(_EverywherePresentationDirectory)&quot; &quot;$(MSBuildProjectDirectory)&quot;" />
  </Target>
</Project>
