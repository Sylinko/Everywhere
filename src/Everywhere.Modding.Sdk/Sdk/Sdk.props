<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk"/>

  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net11.0</TargetFramework>
    <SelfContained>false</SelfContained>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EverywhereLocalConfiguration Condition="'$(EverywhereLocalConfiguration)' == ''">$(MSBuildProjectDirectory)/Everywhere.local.props</EverywhereLocalConfiguration>
    <EverywhereModToolsDirectory Condition="'$(EverywhereModToolsDirectory)' == ''">$(MSBuildThisFileDirectory)../tools/net11.0</EverywhereModToolsDirectory>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <!-- Localization identities are language tags, not files in the project tree. -->
    <EverywhereModLocalization>
      <Visible>false</Visible>
    </EverywhereModLocalization>
    <!-- Logical mod dependencies are mod IDs, not files in the project tree. -->
    <EverywhereModDependency>
      <Visible>false</Visible>
      <Optional>false</Optional>
      <Assemblies></Assemblies>
    </EverywhereModDependency>
    <!-- Reuse NuGet Pack/PackagePath conventions instead of custom CopyToOutputDirectory rules. -->
    <Content>
      <PackagePath></PackagePath>
    </Content>
    <None>
      <PackagePath></PackagePath>
    </None>
  </ItemDefinitionGroup>

  <Import Project="$(EverywhereLocalConfiguration)" Condition="Exists('$(EverywhereLocalConfiguration)')"/>
</Project>
