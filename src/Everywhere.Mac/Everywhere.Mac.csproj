<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Everywhere</AssemblyName>
    <EverywhereI18NNamespace>Everywhere.Mac.I18N</EverywhereI18NNamespace>
    <ApplicationTitle>Everywhere</ApplicationTitle>
    <SelfContained>true</SelfContained>
    <TargetFramework>$(TargetFrameworkPrefix)-macos</TargetFramework>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <SupportedOSPlatformVersion>12.0</SupportedOSPlatformVersion>
    <IsDeploymentTarget>true</IsDeploymentTarget>
    <UseAppHost>true</UseAppHost>
    <CreateAppBundle>true</CreateAppBundle>
    <BundleCreateDump>true</BundleCreateDump>

    <!-- The signing and packaging by SDK is broken for macOS, so we disable it and do it ourselves -->
    <CreatePackage>false</CreatePackage>
    <EnablePackageSigning>false</EnablePackageSigning>
    <EnableCodeSigning>false</EnableCodeSigning>
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
  </PropertyGroup>

  <Import Project="..\Build.Patches.targets"/>

  <!-- Workaround for TextMateSharp.Grammars libonigwrap.dylib failing in install_name_tool due to lack of header padding -->
  <Target Name="_SkipInstallNameToolForLibOnigWrap" BeforeTargets="_InstallNameTool">
    <Message Text="Skipping install_name_tool for libonigwrap.dylib to avoid 'larger updated load commands do not fit' error..." Importance="high"/>
    <ItemGroup>
      <_DynamicLibraryToReidentify Remove="@(_DynamicLibraryToReidentify)" Condition="'%(Filename)' == 'libonigwrap'"/>
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <ApplicationManifest>Info.plist</ApplicationManifest>
  </PropertyGroup>

  <!-- $(IsPublish) is set to 'true' when running 'dotnet publish /p:IsPublish=true' -->
  <PropertyGroup Condition="'$(IsPublish)' != 'true'">
    <UseHardenedRuntime>false</UseHardenedRuntime>
    <EverywhereRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../..'))</EverywhereRepositoryRoot>
    <DevSigningScript>$(EverywhereRepositoryRoot)/tools/macos_dev_signing.sh</DevSigningScript>
    <DevSigningIdentityFile>$(EverywhereRepositoryRoot)/.macos-signing/identity.sha1</DevSigningIdentityFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsPublish)' == 'true'">
    <UseHardenedRuntime>true</UseHardenedRuntime>
  </PropertyGroup>

  <!-- Workaround for TextMateSharp libonigwrap.dylib failing in install_name_tool and causing dyld crash on launch -->
  <Target Name="_HideLibOnigWrapFromMacSdk" BeforeTargets="_ComputeDynamicLibrariesToReidentify;_LinkNativeExecutable;_InstallNameTool">
    <Message Text="Intercepting libonigwrap.dylib to prevent dyld static linking crashes..." Importance="high"/>
    <ItemGroup>
      <_ExtractedLibOnigWrap Include="@(_FileNativeReference)" Condition="'%(Filename)' == 'libonigwrap'"/>
      <_FileNativeReference Remove="@(_ExtractedLibOnigWrap)"/>
      <_DynamicLibraryToReidentify Remove="@(_DynamicLibraryToReidentify)" Condition="'%(Filename)' == 'libonigwrap'"/>
    </ItemGroup>
  </Target>

  <Target Name="_CopyLibOnigWrapToBundle"
          AfterTargets="_CreateAppBundle"
          Inputs="@(_ExtractedLibOnigWrap)"
          Outputs="$(IntermediateOutputPath)libonigwrap-bundle-copy.stamp;$(AppBundleDir)/Contents/MonoBundle/libonigwrap.dylib"
          Condition="'@(_ExtractedLibOnigWrap)' != ''">
    <MakeDir Directories="$(AppBundleDir)/Contents/MonoBundle" Condition="!Exists('$(AppBundleDir)/Contents/MonoBundle')"/>
    <Copy SourceFiles="@(_ExtractedLibOnigWrap)" DestinationFolder="$(AppBundleDir)/Contents/MonoBundle"/>
    <Touch Files="$(IntermediateOutputPath)libonigwrap-bundle-copy.stamp" AlwaysCreate="true"/>
  </Target>

  <Target Name="_EnsureDevSigningIdentity" Condition="'$(IsPublish)' != 'true'">
    <Error Text="macOS development signing script not found: $(DevSigningScript)" Condition="!Exists('$(DevSigningScript)')"/>
    <Exec Command="&quot;$(DevSigningScript)&quot; ensure" StandardOutputImportance="Low"/>
    <Error Text="macOS development signing identity was not created: $(DevSigningIdentityFile)" Condition="!Exists('$(DevSigningIdentityFile)')"/>
  </Target>

  <Target Name="_CollectDevSigningInputs"
          DependsOnTargets="_EnsureDevSigningIdentity"
          Condition="'$(IsPublish)' != 'true'">
    <ItemGroup>
      <_DevSigningInput Remove="@(_DevSigningInput)"/>
      <_DevSigningInput Include="$(MSBuildProjectFullPath);$(ProjectAssetsFile);$(DevSigningScript);$(DevSigningIdentityFile)"/>
      <_DevSigningInput Include="$(IntermediateOutputPath)libonigwrap-bundle-copy.stamp;$(IntermediateOutputPath)officecli-bundle-copy.stamp"/>
      <_DevSigningInput Include="$(AppBundleDir)/Contents/**/*"/>
    </ItemGroup>
  </Target>

  <!-- Sign only when an input in the assembled app bundle has changed. -->
  <Target Name="SignOnBuild"
          AfterTargets="Build"
          DependsOnTargets="_CollectDevSigningInputs"
          Inputs="@(_DevSigningInput)"
          Outputs="$(IntermediateOutputPath)dev-signing.stamp"
          Condition="'$(IsPublish)' != 'true'">
    <Message Text="[Dev Workflow] Processing build output for local debugging..." Importance="high"/>
    <Exec Command="&quot;$(DevSigningScript)&quot; sign-app &quot;$(AppBundleDir)&quot;"/>
    <Touch Files="$(IntermediateOutputPath)dev-signing.stamp" AlwaysCreate="true"/>
  </Target>

  <Target Name="SignAndPackageOnPublish" AfterTargets="Publish" Condition="'$(IsPublish)' == 'true'">
    <Message Text="[Publish Workflow] Processing publish output for distribution..." Importance="high"/>

    <PropertyGroup>
      <!-- AppBundleDir is set by the SDK when CreateAppBundle is true -->
      <InfoPlistPath>$(AppBundleDir)/Contents/Info.plist</InfoPlistPath>
    </PropertyGroup>

    <Message Text="Updating Info.plist version to $(Version)..." Importance="high"/>
    <Error Text="Info.plist not found at $(InfoPlistPath)" Condition="!Exists('$(InfoPlistPath)')"/>

    <Exec Command="/usr/libexec/PlistBuddy -c &quot;Set :CFBundleShortVersionString $(Version)&quot; &quot;$(InfoPlistPath)&quot;" ContinueOnError="true"/>
    <Exec Command="/usr/libexec/PlistBuddy -c &quot;Set :CFBundleVersion $(Version)&quot; &quot;$(InfoPlistPath)&quot;" ContinueOnError="true"/>

    <CallTarget Targets="_CoreSignAppBundle"/>

    <Exec Command="codesign --verify --deep --strict --verbose=2 &quot;$(AppBundleDir)&quot;"/>

    <CallTarget Targets="CreateInstallerPackage" Condition="'$(PackageSigningKey)' != ''"/>
  </Target>


  <Target Name="_CoreSignAppBundle">
    <PropertyGroup>
      <WatchdogPath>$(AppBundleDir)/Contents/Helpers/Everywhere.Watchdog</WatchdogPath>
      <OfficeCliPath>$(AppBundleDir)/Contents/MonoBundle/officecli</OfficeCliPath>
    </PropertyGroup>

    <Message Text=">>> Signing App Bundle at: $(AppBundleDir)" Importance="high"/>

    <Exec Command="xattr -cr &quot;$(AppBundleDir)&quot;"/>

    <Message Text="Signing native libraries (MonoBundle)..." Importance="high"/>
    <Exec Command="find &quot;$(AppBundleDir)/Contents/MonoBundle&quot; \( -name &quot;*.dylib&quot; -o -name &quot;*.so&quot; -o -name &quot;createdump&quot; \) -exec codesign --force --sign &quot;$(CodesignKey)&quot; --timestamp --options runtime &quot;{}&quot; \;"/>

    <Message Text="Signing Watchdog..." Condition="Exists('$(WatchdogPath)')" Importance="high"/>
    <Exec Command="codesign --force --sign &quot;$(CodesignKey)&quot; --entitlements &quot;$(CodesignEntitlements)&quot; --timestamp --options runtime &quot;$(WatchdogPath)&quot;" Condition="Exists('$(WatchdogPath)')"/>

    <Message Text="Signing OfficeCLI apphost..." Condition="Exists('$(OfficeCliPath)')" Importance="high"/>
    <Exec Command="codesign --force --sign &quot;$(CodesignKey)&quot; --entitlements &quot;$(CodesignEntitlements)&quot; --timestamp --options runtime &quot;$(OfficeCliPath)&quot;" Condition="Exists('$(OfficeCliPath)')"/>

    <Message Text="Signing Main Application executable..." Importance="high"/>
    <Exec Command="codesign --force --sign &quot;$(CodesignKey)&quot; --entitlements &quot;$(CodesignEntitlements)&quot; --timestamp --options runtime &quot;$(AppBundleDir)&quot;"/>

    <Message Text=">>> Signing Complete." Importance="high"/>
  </Target>


  <Target Name="CreateInstallerPackage">
    <PropertyGroup>
      <PkgName>$(AssemblyName)-$(Version).pkg</PkgName>
      <PkgOutputPath>$(PublishDir)$(PkgName)</PkgOutputPath>
      <IntermediatePkgPath>$(PublishDir)intermediate.pkg</IntermediatePkgPath>
      <ComponentPlistPath>$(PublishDir)component.plist</ComponentPlistPath>
      <PkgRoot>$(PublishDir)pkg-root</PkgRoot>
    </PropertyGroup>

    <Message Text="Creating Installer Package..." Importance="high"/>

    <RemoveDir Directories="$(PkgRoot)"/>
    <MakeDir Directories="$(PkgRoot)"/>
    <Exec Command="ditto &quot;$(AppBundleDir)&quot; &quot;$(PkgRoot)/$(AssemblyName).app&quot;"/>
    <Exec Command="pkgbuild --analyze --root &quot;$(PkgRoot)&quot; &quot;$(ComponentPlistPath)&quot;"/>
    <Exec Command="sed -i '' '/&lt;key&gt;BundleIsRelocatable&lt;\/key&gt;/{n;s/&lt;true\/&gt;/&lt;false\/&gt;/;}' &quot;$(ComponentPlistPath)&quot;"/>
    <Exec Command="pkgbuild --root &quot;$(PkgRoot)&quot; --component-plist &quot;$(ComponentPlistPath)&quot; --install-location /Applications &quot;$(IntermediatePkgPath)&quot;"/>

    <PropertyGroup>
      <DistributionXmlPath>$(PublishDir)distribution.xml</DistributionXmlPath>
    </PropertyGroup>

    <Exec Command="productbuild --synthesize --package &quot;$(IntermediatePkgPath)&quot; &quot;$(DistributionXmlPath)&quot;"/>
    <Exec Command="grep -q &quot;&lt;title&gt;&quot; &quot;$(DistributionXmlPath)&quot; &amp;&amp; sed -i '' 's/&lt;title&gt;.*&lt;\/title&gt;/&lt;title&gt;$(ApplicationTitle)&lt;\/title&gt;/' &quot;$(DistributionXmlPath)&quot; || sed -i '' 's/&lt;installer-gui-script[^&gt;]*&gt;/&amp;&lt;title&gt;$(ApplicationTitle)&lt;\/title&gt;/' &quot;$(DistributionXmlPath)&quot;"/>
    <Exec Command="productbuild --distribution &quot;$(DistributionXmlPath)&quot; --package-path &quot;$(PublishDir)&quot; --sign &quot;$(PackageSigningKey)&quot; &quot;$(PkgOutputPath)&quot;"/>
    <Exec Command="rm &quot;$(IntermediatePkgPath)&quot; &quot;$(ComponentPlistPath)&quot; &quot;$(DistributionXmlPath)&quot;"/>
    <RemoveDir Directories="$(PkgRoot)"/>

    <Message Text="Installer created successfully at: $(PkgOutputPath)" Importance="high"/>
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\3rd\OfficeCLI\src\officecli\officecli.csproj"/>
    <ProjectReference Include="..\Everywhere.Cloud\Everywhere.Cloud.csproj"/>
    <ProjectReference Include="..\Everywhere.Core\Everywhere.Core.csproj"/>
    <ProjectReference Include="..\Everywhere.I18N.Abstractions\Everywhere.I18N.Abstractions.csproj"/>
    <ProjectReference Include="..\Everywhere.I18N.SourceGenerator\Everywhere.I18N.SourceGenerator.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer"/>
    <ProjectReference Include="..\Everywhere.ProcessIsolation\Everywhere.ProcessIsolation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Remove="I18N\Strings*.resx"/>
    <AdditionalFiles Include="I18N\Strings*.resx"/>
  </ItemGroup>

  <Import Project="..\Build.Watchdog.targets"/>

  <!--
    The Unix OfficeCLI apphost has no extension. The macOS SDK only places
    .dll/.exe files in MonoBundle, so copy the tiny native launcher after the
    app bundle has been assembled. The two small runtime sidecars are copied
    with it; the managed payload remains shared with Everywhere in MonoBundle.
  -->
  <Target Name="CopyOfficeCliAppHostToBundle"
          AfterTargets="_CreateAppBundle"
          Inputs="$(TargetDir)officecli;$(TargetDir)officecli.deps.json;$(TargetDir)officecli.runtimeconfig.json"
          Outputs="$(IntermediateOutputPath)officecli-bundle-copy.stamp;$(AppBundleDir)/Contents/MonoBundle/officecli;$(AppBundleDir)/Contents/MonoBundle/officecli.deps.json;$(AppBundleDir)/Contents/MonoBundle/officecli.runtimeconfig.json"
          Condition="'$(IsMacEnabled)' == 'true'">
    <PropertyGroup>
      <OfficeCliAppHost>$(TargetDir)officecli</OfficeCliAppHost>
      <OfficeCliDepsFile>$(TargetDir)officecli.deps.json</OfficeCliDepsFile>
      <OfficeCliRuntimeConfig>$(TargetDir)officecli.runtimeconfig.json</OfficeCliRuntimeConfig>
      <OfficeCliBundleDir>$(AppBundleDir)/Contents/MonoBundle</OfficeCliBundleDir>
      <OfficeCliBundledAppHost>$(AppBundleDir)/Contents/MonoBundle/officecli</OfficeCliBundledAppHost>
    </PropertyGroup>

    <Error Text="OfficeCLI apphost was not generated: $(OfficeCliAppHost)" Condition="!Exists('$(OfficeCliAppHost)')"/>
    <Error Text="OfficeCLI deps file was not generated: $(OfficeCliDepsFile)" Condition="!Exists('$(OfficeCliDepsFile)')"/>
    <Error Text="OfficeCLI runtimeconfig was not generated: $(OfficeCliRuntimeConfig)" Condition="!Exists('$(OfficeCliRuntimeConfig)')"/>
    <Copy SourceFiles="$(OfficeCliAppHost)" DestinationFiles="$(OfficeCliBundledAppHost)"/>
    <Copy SourceFiles="$(OfficeCliDepsFile)" DestinationFolder="$(OfficeCliBundleDir)"/>
    <Copy SourceFiles="$(OfficeCliRuntimeConfig)" DestinationFolder="$(OfficeCliBundleDir)"/>
    <Exec Command="chmod +x &quot;$(OfficeCliBundledAppHost)&quot;"/>
    <Touch Files="$(OfficeCliBundledAppHost);$(OfficeCliBundleDir)/officecli.deps.json;$(OfficeCliBundleDir)/officecli.runtimeconfig.json"/>
    <Touch Files="$(IntermediateOutputPath)officecli-bundle-copy.stamp" AlwaysCreate="true"/>
  </Target>

  <ItemGroup>
    <TrimmerRootAssembly Include="officecli"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\img\Everywhere.ico">
      <Link>Everywhere.ico</Link>
    </None>
    <None Include="Everywhere.icns" PublishFolderType="Resource">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="$(WatchdogExecutable)" PublishFolderType="RootDirectory">
      <Link>Contents\Helpers\Everywhere.Watchdog</Link>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <Target Name="_SetShellScriptsPublishFolderType" BeforeTargets="_ComputePublishLocation" Condition="'$(IsMacEnabled)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish
        Condition="'%(Extension)' == '.zsh' Or '%(Extension)' == '.bash' Or '%(Extension)' == '.ps1'">
        <PublishFolderType>Assembly</PublishFolderType>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
