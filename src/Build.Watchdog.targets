<!-- src/Build.Watchdog.targets -->
<Project>
  <!--
    Defines common properties and targets for building the Watchdog project.
    The consuming project is expected to define:
    - $(RuntimeIdentifier)
    - $(WatchdogExecutable)
  -->
  <PropertyGroup>
    <!-- Define the path to the Watchdog project. -->
    <WatchdogDir>$(MSBuildThisFileDirectory)Everywhere.Watchdog\</WatchdogDir>
    <WatchdogProject>$(WatchdogDir)Everywhere.Watchdog.csproj</WatchdogProject>

    <!-- Define the output directory for the Watchdog publish artifacts. -->
    <WatchdogOutDir>$(WatchdogDir)bin\$(Configuration)\$(TargetFrameworkPrefix)\$(RuntimeIdentifier)\publish\</WatchdogOutDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- The published executable contains both projects, so source changes in
         either project must invalidate the copied NativeAOT artifact. -->
    <WatchdogBuildInput Include="$(WatchdogDir)**\*.cs;$(WatchdogDir)Everywhere.Watchdog.csproj;$(WatchdogDir)NativeMethods.txt"
                        Exclude="$(WatchdogDir)bin\**;$(WatchdogDir)obj\**" />
    <WatchdogBuildInput Include="$(MSBuildThisFileDirectory)Everywhere.ProcessIsolation\**\*.cs;$(MSBuildThisFileDirectory)Everywhere.ProcessIsolation\Everywhere.ProcessIsolation.csproj"
                        Exclude="$(MSBuildThisFileDirectory)Everywhere.ProcessIsolation\bin\**;$(MSBuildThisFileDirectory)Everywhere.ProcessIsolation\obj\**" />
    <WatchdogBuildInput Include="$(MSBuildThisFileDirectory)Everywhere.Abstractions\**\*.cs;$(MSBuildThisFileDirectory)Everywhere.Abstractions\Everywhere.Abstractions.csproj"
                        Exclude="$(MSBuildThisFileDirectory)Everywhere.Abstractions\bin\**;$(MSBuildThisFileDirectory)Everywhere.Abstractions\obj\**" />
    <WatchdogBuildInput Include="$(MSBuildThisFileDirectory)..\Directory.Build.props;$(MSBuildThisFileDirectory)..\Directory.Packages.props" />
  </ItemGroup>

  <PropertyGroup Condition="$([System.String]::Copy($(RuntimeIdentifier)).StartsWith('win')) OR $([MSBuild]::IsOSPlatform('Windows'))">
    <!-- Define the Watchdog executable path for Windows. -->
    <WatchdogExecutable>$(WatchdogOutDir)Everywhere.Watchdog.exe</WatchdogExecutable>
  </PropertyGroup>

  <PropertyGroup Condition="!($([System.String]::Copy($(RuntimeIdentifier)).StartsWith('win')) OR $([MSBuild]::IsOSPlatform('Windows')))">
    <!-- Define the Watchdog executable path for non-Windows platforms. -->
    <WatchdogExecutable>$(WatchdogOutDir)Everywhere.Watchdog</WatchdogExecutable>
  </PropertyGroup>

  <!--
    A target to build and publish the Watchdog project.
    This target runs before the main build process. It checks if the Watchdog executable
    is missing or out-of-date and rebuilds it if necessary.
  -->
  <Target Name="BuildWatchdog"
          BeforeTargets="BeforeResolveReferences"
          Inputs="@(WatchdogBuildInput)"
          Outputs="$(WatchdogExecutable)">
    <Message Text="Watchdog executable is out-of-date. Building..." Importance="high"/>

    <MSBuild Projects="$(WatchdogProject)"
             Targets="Publish"
             Properties="PublishDir=$(WatchdogOutDir);TargetFramework=$(TargetFrameworkPrefix);RuntimeIdentifier=$(RuntimeIdentifier);Configuration=$(Configuration)" />
  </Target>
</Project>
