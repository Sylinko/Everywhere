<!-- src/Build.Watchdog.targets -->
<Project>
  <!--
    Defines common properties and targets for building the Watchdog project.
    The consuming project is expected to define:
    - $(RuntimeIdentifier)
  -->
  <PropertyGroup>
    <!-- Define the path to the Watchdog project. -->
    <WatchdogDir>$(MSBuildThisFileDirectory)Everywhere.Watchdog\</WatchdogDir>
    <WatchdogProject>$(WatchdogDir)Everywhere.Watchdog.csproj</WatchdogProject>

    <!-- Prefer the target RID when set so cross-architecture/OS paths match the target rather than the build machine. -->
    <_WatchdogRuntimeIdentifier Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_WatchdogRuntimeIdentifier>
    <_WatchdogRuntimeIdentifier Condition="'$(_WatchdogRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</_WatchdogRuntimeIdentifier>

    <!-- Define the output directory for the Watchdog publish artifacts. -->
    <WatchdogOutDir>$(WatchdogDir)bin\$(Configuration)\$(TargetFrameworkPrefix)\$(_WatchdogRuntimeIdentifier)\publish\</WatchdogOutDir>

    <_IsWatchdogWindows Condition="'$(_WatchdogRuntimeIdentifier)' != ''">$([System.String]::Copy('$(_WatchdogRuntimeIdentifier)').StartsWith('win', System.StringComparison.OrdinalIgnoreCase))</_IsWatchdogWindows>
    <_IsWatchdogWindows Condition="'$(_IsWatchdogWindows)' == ''">$([MSBuild]::IsOSPlatform('Windows'))</_IsWatchdogWindows>
  </PropertyGroup>

  <ItemGroup>
    <!-- Restore and build Watchdog through the normal dependency graph without referencing its assembly. -->
    <ProjectReference Include="$(WatchdogProject)" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <PropertyGroup Condition="'$(_IsWatchdogWindows)' == 'true'">
    <!-- Define the Watchdog executable path for Windows targets. -->
    <WatchdogExecutable>$(WatchdogOutDir)Everywhere.Watchdog.exe</WatchdogExecutable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_IsWatchdogWindows)' != 'true'">
    <!-- Define the Watchdog executable path for non-Windows targets. -->
    <WatchdogExecutable>$(WatchdogOutDir)Everywhere.Watchdog</WatchdogExecutable>
  </PropertyGroup>

  <!--
    Publish the already-built tool. The SDK tracks NativeAOT inputs and incremental outputs;
    no separate list of transitive source files or nested restore is required.
  -->
  <Target Name="BuildWatchdog"
          Condition="'$(DesignTimeBuild)' != 'true'"
          AfterTargets="ResolveProjectReferences">
    <MSBuild Projects="$(WatchdogProject)"
             Targets="Publish"
             RemoveProperties="TargetFramework"
             Properties="NoBuild=true;PublishDir=$(WatchdogOutDir);RuntimeIdentifier=$(_WatchdogRuntimeIdentifier);Configuration=$(Configuration)" />
  </Target>
</Project>
