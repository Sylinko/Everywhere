<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Everywhere</AssemblyName>
    <EverywhereI18NNamespace>Everywhere.Windows.I18N</EverywhereI18NNamespace>
    <SelfContained>true</SelfContained>
    <TargetFramework>$(TargetFrameworkPrefix)-windows10.0.19041.0</TargetFramework>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaAccessUnstablePrivateApis>true</AvaloniaAccessUnstablePrivateApis>
    <ApplicationIcon>..\..\img\Everywhere.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IsDeploymentTarget>true</IsDeploymentTarget>
    <PublishTrimmed>false</PublishTrimmed>
    <RespectAlreadyAssignedItemCulture>true</RespectAlreadyAssignedItemCulture>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Everywhere.Windows.Tests"/>
  </ItemGroup>

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop"/>
    <PackageReference Include="Microsoft.Windows.CsWin32">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="OfficeCLI"/>
    <PackageReference Include="SkiaSharp.NativeAssets.Win32"/>
    <PackageReference Include="Vortice.Direct3D11"/>
    <PackageReference Include="Vortice.DirectComposition"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Everywhere.Cloud\Everywhere.Cloud.csproj"/>
    <ProjectReference Include="..\Everywhere.Core\Everywhere.Core.csproj"/>
    <ProjectReference Include="..\Everywhere.Windows.Interop\Everywhere.Windows.Interop.csproj"/>
    <ProjectReference Include="..\..\patches\Everywhere.Patches.Contracts\Everywhere.Patches.Contracts.csproj"/>
    <ProjectReference Include="..\Everywhere.I18N.Abstractions\Everywhere.I18N.Abstractions.csproj"/>
    <ProjectReference Include="..\Everywhere.I18N.SourceGenerator\Everywhere.I18N.SourceGenerator.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer"/>
    <ProjectReference Include="..\..\mods\Everywhere.Mods.Everything\Everywhere.Mods.Everything.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      ExcludeAssets="all"
                      GlobalPropertiesToRemove="TargetFramework;RuntimeIdentifier;SelfContained;PublishTrimmed;PublishSingleFile;Version;SemanticVersion;AssemblyName;RootNamespace;PublishDir;OutputPath;OutDir"/>
    <ProjectReference Include="..\Everywhere.ProcessIsolation\Everywhere.ProcessIsolation.csproj"/>
  </ItemGroup>

  <Import Project="..\Build.I18N.targets"/>
  <Import Project="..\Build.Patches.targets"/>
  <Import Project="..\Build.Watchdog.targets"/>

  <ItemGroup>
    <None Include="..\..\img\Everywhere.ico">
      <Link>Everywhere.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Include="$(WatchdogExecutable)">
      <Link>Everywhere.Watchdog.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\Icons\PowerShell.svg"/>
    <None Remove="Assets\Icons\Windows11.svg"/>
  </ItemGroup>

  <Import Project="..\Build.Modding.Hosting.targets"/>

  <!-- Package first-party built-in Windows mods as embedded static repository resources
       so no loose mod binaries ship alongside the desktop executable. -->
  <Target Name="PackBuiltInMods"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="ResolveProjectReferences"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_BuiltInModsWorkDir>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)builtin-mods'))\</_BuiltInModsWorkDir>
      <_BuiltInModPackagePath>$(_BuiltInModsWorkDir)staged\everywhere.everything.zip</_BuiltInModPackagePath>
      <_BuiltInModRepoDir>$(_BuiltInModsWorkDir)repo\</_BuiltInModRepoDir>
      <_BuiltInModSpecPath>$(_BuiltInModsWorkDir)spec.json</_BuiltInModSpecPath>
      <_ModdingSdkDll>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Everywhere.Modding.Sdk\bin\$(Configuration)\net11.0\Everywhere.Modding.Sdk.dll'))</_ModdingSdkDll>
      <_BuiltInModSpecJson>{&quot;format&quot;:1,&quot;id&quot;:&quot;builtin&quot;,&quot;title&quot;:{&quot;en&quot;:&quot;Built-in Mods&quot;,&quot;zh-hans&quot;:&quot;内置模组&quot;},&quot;metadata&quot;:{&quot;categories&quot;:{&quot;search&quot;:{&quot;title&quot;:{&quot;en&quot;:&quot;Search&quot;,&quot;zh-hans&quot;:&quot;搜索&quot;}}}},&quot;layout&quot;:&quot;directory&quot;,&quot;packages&quot;:[{&quot;path&quot;:&quot;staged/everywhere.everything.zip&quot;,&quot;isDefaultEnabled&quot;:true,&quot;category&quot;:&quot;search&quot;,&quot;channels&quot;:[&quot;stable&quot;]}]}</_BuiltInModSpecJson>
    </PropertyGroup>

    <MSBuild Projects="..\..\mods\Everywhere.Mods.Everything\Everywhere.Mods.Everything.csproj"
             Targets="EverywherePack"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained;PublishTrimmed;PublishSingleFile;Version;SemanticVersion;AssemblyName;RootNamespace;PublishDir;OutputPath;OutDir"
             Properties="Configuration=$(Configuration);EverywhereModPackagePath=$(_BuiltInModPackagePath)"/>

    <RemoveDir Directories="$(_BuiltInModRepoDir)"/>
    <MakeDir Directories="$(_BuiltInModsWorkDir)"/>
    <WriteLinesToFile File="$(_BuiltInModSpecPath)" Lines="$(_BuiltInModSpecJson)" Overwrite="true"/>
    <Exec Command="dotnet &quot;$(_ModdingSdkDll)&quot; build-index &quot;$(_BuiltInModSpecPath)&quot; &quot;$(_BuiltInModRepoDir)index.json&quot;"/>

    <ItemGroup>
      <_BuiltInModRepoFile Include="$(_BuiltInModRepoDir)**\*"/>
      <EmbeddedResource Include="@(_BuiltInModRepoFile)">
        <Type>Non-Resx</Type>
        <WithCulture>false</WithCulture>
        <LogicalName>Everywhere.BuiltInMods/$([System.String]::Copy('%(RecursiveDir)').Replace('\','/'))%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Scripts\PortableUpdate.ps1">
      <LogicalName>Everywhere.Windows.Scripts.PortableUpdate.ps1</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Exclude debug symbols and XML documentation from the published application. -->
  <Target Name="FilterPublishOutput" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'"/>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.xml'"/>
    </ItemGroup>
  </Target>

</Project>
