<Project>
  <!-- Package first-party built-in mods as embedded static repository resources
       so no loose mod binaries ship alongside the desktop executable. -->
  <Target Name="_PrepareBuiltInModsInputs"
          DependsOnTargets="ResolveProjectReferences"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_BuiltInModsWorkDir>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)builtin-mods'))/</_BuiltInModsWorkDir>
      <_BuiltInModRepoDir>$(_BuiltInModsWorkDir)repo/</_BuiltInModRepoDir>
      <_BuiltInModSpecPath>$(_BuiltInModsWorkDir)spec.json</_BuiltInModSpecPath>
      <_ModdingSdkDll>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)Everywhere.Modding.Sdk/bin/$(Configuration)/net11.0/Everywhere.Modding.Sdk.dll'))</_ModdingSdkDll>
    </PropertyGroup>

    <!-- Reuse the resolved project reference configuration so MSBuild hits the cached build graph instead of rebuilding upstream projects. -->
    <MSBuild Projects="@(_MSBuildProjectReferenceExistent)"
             Targets="EverywherePack"
             Properties="%(_MSBuildProjectReferenceExistent.SetConfiguration);%(_MSBuildProjectReferenceExistent.SetPlatform);%(_MSBuildProjectReferenceExistent.SetTargetFramework)"
             RemoveProperties="%(_MSBuildProjectReferenceExistent.GlobalPropertiesToRemove);$(_GlobalPropertiesToRemoveFromProjectReferences)"
             Condition="'%(_MSBuildProjectReferenceExistent.IsEverywhereBuiltInMod)' == 'true'">
      <Output TaskParameter="TargetOutputs" ItemName="_BuiltInModPackage"/>
    </MSBuild>

    <Copy SourceFiles="@(_BuiltInModPackage)" DestinationFolder="$(_BuiltInModsWorkDir)staged" SkipUnchangedFiles="true"/>
    <MakeDir Directories="$(_BuiltInModsWorkDir)"/>

    <ItemGroup>
      <_BuiltInModStagedPackage Include="@(_BuiltInModPackage->'$(_BuiltInModsWorkDir)staged/%(Filename)%(Extension)')"/>
    </ItemGroup>

    <PropertyGroup>
      <_BuiltInModSpecPackages>@(_BuiltInModPackage->'{&quot;path&quot;:&quot;staged/%(Filename)%(Extension)&quot;,&quot;isDefaultEnabled&quot;:true,&quot;category&quot;:&quot;%(ModCategory)&quot;,&quot;channels&quot;:[&quot;stable&quot;]}', ',')</_BuiltInModSpecPackages>
      <_BuiltInModSpecJson>{&quot;format&quot;:1,&quot;id&quot;:&quot;builtin&quot;,&quot;title&quot;:{&quot;en&quot;:&quot;Built-in Mods&quot;,&quot;zh-hans&quot;:&quot;内置模组&quot;},&quot;metadata&quot;:{&quot;categories&quot;:{&quot;appearance&quot;:{&quot;title&quot;:{&quot;en&quot;:&quot;Appearance&quot;,&quot;zh-hans&quot;:&quot;外观&quot;}},&quot;general&quot;:{&quot;title&quot;:{&quot;en&quot;:&quot;General&quot;,&quot;zh-hans&quot;:&quot;通用&quot;}},&quot;search&quot;:{&quot;title&quot;:{&quot;en&quot;:&quot;Search&quot;,&quot;zh-hans&quot;:&quot;搜索&quot;}}}},&quot;layout&quot;:&quot;directory&quot;,&quot;packages&quot;:[$(_BuiltInModSpecPackages)]}</_BuiltInModSpecJson>
    </PropertyGroup>

    <WriteLinesToFile File="$(_BuiltInModSpecPath)" Lines="$(_BuiltInModSpecJson)" Overwrite="true" WriteOnlyWhenDifferent="true"/>
  </Target>

  <Target Name="_BuildBuiltInModsIndex"
          DependsOnTargets="_PrepareBuiltInModsInputs"
          Inputs="@(_BuiltInModStagedPackage);$(_BuiltInModSpecPath);$(_ModdingSdkDll)"
          Outputs="$(_BuiltInModRepoDir)index.json"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <RemoveDir Directories="$(_BuiltInModRepoDir)"/>
    <Exec Command="dotnet &quot;$(_ModdingSdkDll)&quot; build-index &quot;$(_BuiltInModSpecPath)&quot; &quot;$(_BuiltInModRepoDir)index.json&quot;"/>
  </Target>

  <Target Name="PackBuiltInMods"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="_BuildBuiltInModsIndex"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_BuiltInModRepoFile Include="$(_BuiltInModRepoDir)**/*"/>
      <EmbeddedResource Include="@(_BuiltInModRepoFile)">
        <Type>Non-Resx</Type>
        <WithCulture>false</WithCulture>
        <LogicalName>Everywhere.BuiltInMods/$([System.String]::Copy('%(RecursiveDir)').Replace('\','/'))%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
      <FileWrites Include="@(_BuiltInModStagedPackage);$(_BuiltInModSpecPath);@(_BuiltInModRepoFile)"/>
    </ItemGroup>
  </Target>
</Project>
