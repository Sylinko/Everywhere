<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <SelfContained>false</SelfContained>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EverywhereLocalConfiguration Condition="'$(EverywhereLocalConfiguration)' == ''">$(MSBuildProjectDirectory)/Everywhere.local.props</EverywhereLocalConfiguration>
    <EverywherePluginToolsDirectory Condition="'$(EverywherePluginToolsDirectory)' == ''">$(MSBuildThisFileDirectory)../tools/net10.0</EverywherePluginToolsDirectory>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <!-- Localization identities are language tags, not files in the project tree. -->
    <EverywherePluginLocalization>
      <Visible>false</Visible>
    </EverywherePluginLocalization>
  </ItemDefinitionGroup>

  <Import Project="$(EverywhereLocalConfiguration)" Condition="Exists('$(EverywhereLocalConfiguration)')" />
</Project>
