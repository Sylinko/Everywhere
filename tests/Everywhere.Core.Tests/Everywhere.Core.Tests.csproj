<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <EverywhereI18NNamespace>Everywhere.Core.Tests.Generated.I18N</EverywhereI18NNamespace>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="I18N/Strings.resx" />
    <ProjectReference Include="../../src/Everywhere.I18N.SourceGenerator/Everywhere.I18N.SourceGenerator.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Avalonia.Headless"/>
    <PackageReference Include="Avalonia.Headless.NUnit"/>
    <PackageReference Include="Avalonia.Themes.Simple"/>
    <PackageReference Include="Microsoft.NET.Test.Sdk"/>
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="NUnit"/>
    <PackageReference Include="NUnit.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter"/>
    <PackageReference Include="Serilog"/>
    <PackageReference Include="Serilog.Sinks.Console"/>
    <PackageReference Include="Serilog.Extensions.Logging"/>
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework"/>
    <None Update="Fixtures/Harness/*.msgpack" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Everywhere.Core\Everywhere.Core.csproj"/>
    <ProjectReference Include="..\..\src\Everywhere.Cloud\Everywhere.Cloud.csproj"/>
    <ProjectReference Include="..\..\src\Everywhere.Modding.Hosting\Everywhere.Modding.Hosting.csproj"/>
    <ProjectReference Include="..\..\src\Everywhere.Configuration.SourceGenerator\Everywhere.Configuration.SourceGenerator.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer"/>
    <ProjectReference Include="..\..\mods\Everywhere.Mods.Themes\Everywhere.Mods.Themes.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      ExcludeAssets="all"
                      IsEverywhereThemeModFixture="true"
                      GlobalPropertiesToRemove="$(_BuiltInModPropertiesToRemove)"/>
  </ItemGroup>

  <Target Name="PackThemesModForTests"
          AfterTargets="Build"
          DependsOnTargets="ResolveProjectReferences"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="@(_MSBuildProjectReferenceExistent)"
             Targets="EverywherePack"
             Properties="%(_MSBuildProjectReferenceExistent.SetConfiguration);%(_MSBuildProjectReferenceExistent.SetPlatform);%(_MSBuildProjectReferenceExistent.SetTargetFramework)"
             RemoveProperties="%(_MSBuildProjectReferenceExistent.GlobalPropertiesToRemove);$(_GlobalPropertiesToRemoveFromProjectReferences)"
             Condition="'%(_MSBuildProjectReferenceExistent.IsEverywhereThemeModFixture)' == 'true'">
      <Output TaskParameter="TargetOutputs" ItemName="_ThemesModTestPackage"/>
    </MSBuild>
    <Copy SourceFiles="@(_ThemesModTestPackage)"
          DestinationFiles="$(OutDir)themes-mod/everywhere.themes.zip"
          SkipUnchangedFiles="true"/>
  </Target>

  <Import Project="..\..\src\Build.Patches.targets"/>

</Project>
